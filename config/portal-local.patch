+(defun portal-input--split (side)
+  "Split a Portal pane toward SIDE and choose a buffer in Ibuffer."
+  (let ((configuration (current-window-configuration)))
+    (condition-case err
+        (let ((window (split-window nil nil side)))
+          (select-window window)
+          (ibuffer)
+          window)
+      (error
+       (set-window-configuration configuration)
+       (signal (car err) (cdr err))))))
+
+(defun portal-input-split-below ()
+  "Split below a Portal view and choose a buffer in Ibuffer."
+  (interactive)
+  (portal-input--split 'below))
+
+(defun portal-input-split-right ()
+  "Split right of a Portal view and choose a buffer in Ibuffer."
+  (interactive)
+  (portal-input--split 'right))
+
+(define-key portal-input-mode-map [remap split-window-below]
+            #'portal-input-split-below)
+(define-key portal-input-mode-map [remap split-window-right]
+            #'portal-input-split-right)
 ;; Keep the wrapper controls available in Evil states as well.
 (with-eval-after-load 'evil
   (evil-make-overriding-map portal-input-mode-map))
