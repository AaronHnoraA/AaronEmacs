;;; Commentary:
;; Run after loading the full configuration:
;;   emacs --batch --init-directory=. -q -l early-init.el -l init.el \
;;     -l test/init-bazel-entry-tests.el -f ert-run-tests-batch-and-exit

;;; Code:

(require 'cl-lib)
(require 'ert)
(require 'init-bazel)

(ert-deftest bazel-target-menu-is-searchable-with-native-commands-intact ()
  (dolist (command '(bazel-target-menu bazel-target-build bazel-target-test
                     bazel-target-run bazel-target-insert bazel-target-jump
                     bazel-target-refresh bazel-output-bin bazel-output-base
                     bazel-build bazel-test bazel-run))
    (should (commandp command))
    (should (member (symbol-name command)
                    (all-completions (symbol-name command) obarray #'commandp))))
  (should (eq (plist-get (cdr (transient-get-suffix 'task-menu "z")) :command)
              'bazel-target-menu))
  (should (eq (plist-get (cdr (transient-get-suffix 'bazel-target-menu "b"))
                         :command)
              'bazel-target-build))
  (with-temp-buffer
    (evil-normal-state)
    (should (eq (key-binding (kbd "SPC r z")) 'bazel-target-menu))))

(ert-deftest bazel-target-insert-uses-its-origin-frame-and-cleans-marker ()
  (let ((origin (generate-new-buffer " *bazel-insert-origin*"))
        (active-frame 'frame-a)
        (original-copy-marker (symbol-function 'copy-marker))
        marker callback chooser-frame)
    (unwind-protect
        (with-current-buffer origin
          (insert "start end")
          (goto-char 7)
          (cl-letf (((symbol-function 'selected-frame)
                     (lambda () active-frame))
                    ((symbol-function 'select-frame)
                     (lambda (frame &optional _norecord)
                       (setq active-frame frame)))
                    ((symbol-function 'frame-live-p)
                     (lambda (_frame) t))
                    ((symbol-function 'copy-marker)
                     (lambda (&rest args)
                       (setq marker (apply original-copy-marker args))))
                    ((symbol-function 'my/bazel-with-targets)
                     (lambda (fn &optional _refresh _on-error)
                       (setq callback fn)))
                    ((symbol-function 'my/bazel--read-target)
                     (lambda (&rest _)
                       (setq chooser-frame active-frame)
                       "//pkg:item")))
            (bazel-target-insert)
            (setq active-frame 'frame-b)
            (funcall callback "/workspace/" nil "bazel" '("//pkg:item"))
            (should (eq chooser-frame 'frame-a))
            (should (eq active-frame 'frame-b))
            (should (equal (buffer-string) "start //pkg:itemend"))
            (should-not (marker-buffer marker))))
      (kill-buffer origin))))

(ert-deftest bazel-target-insert-cleans-marker-after-query-failure ()
  (let ((original-copy-marker (symbol-function 'copy-marker))
        marker on-error)
    (with-temp-buffer
      (insert "start")
      (cl-letf (((symbol-function 'copy-marker)
                 (lambda (&rest args)
                   (setq marker (apply original-copy-marker args))))
                ((symbol-function 'my/bazel-with-targets)
                 (lambda (_callback &optional _refresh error-callback)
                   (setq on-error error-callback))))
        (bazel-target-insert)
        (should (marker-buffer marker))
        (funcall on-error (remote-exec-result-create :status 1 :stderr "failed"))
        (should-not (marker-buffer marker))))
    (with-temp-buffer
      (cl-letf (((symbol-function 'copy-marker)
                 (lambda (&rest args)
                   (setq marker (apply original-copy-marker args))))
                ((symbol-function 'my/bazel-with-targets)
                 (lambda (&rest _) (error "query could not start"))))
        (should-error (bazel-target-insert) :type 'error)
        (should-not (marker-buffer marker))))))

(ert-deftest bazel-target-jump-returns-to-origin-frame ()
  (let ((origin (generate-new-buffer " *bazel-jump-origin*"))
        (destination (generate-new-buffer " *bazel-jump-result*"))
        (active-frame 'frame-a)
        discovery location chooser-frame visited)
    (unwind-protect
        (progn
          (with-current-buffer destination
            (insert "one\ntwo\nthree\n"))
          (with-current-buffer origin
            (cl-letf (((symbol-function 'selected-frame)
                       (lambda () active-frame))
                      ((symbol-function 'select-frame)
                       (lambda (frame &optional _norecord)
                         (setq active-frame frame)))
                      ((symbol-function 'frame-live-p)
                       (lambda (_frame) t))
                      ((symbol-function 'my/bazel-with-targets)
                       (lambda (fn &rest _) (setq discovery fn)))
                      ((symbol-function 'my/bazel--read-target)
                       (lambda (&rest _)
                         (setq chooser-frame active-frame)
                         "//pkg:item"))
                      ((symbol-function 'remote-exec-async)
                       (lambda (_program &rest args)
                         (setq location (plist-get args :callback))))
                      ((symbol-function 'remote-expand-file-name)
                       (lambda (&rest _) "/tmp/BUILD"))
                      ((symbol-function 'find-file)
                       (lambda (file)
                         (setq visited (list active-frame file))
                         (set-buffer destination))))
              (bazel-target-jump)
              (setq active-frame 'frame-b)
              (funcall discovery "/workspace/" nil "bazel" '("//pkg:item"))
              (should (eq chooser-frame 'frame-a))
              (should (eq active-frame 'frame-b))
              (funcall location
                       (remote-exec-result-create
                        :status 0 :stdout "/workspace/BUILD:3:2: rule"))
              (should (equal visited '(frame-a "/tmp/BUILD")))
              (should (eq active-frame 'frame-b)))))
      (kill-buffer origin)
      (kill-buffer destination))))

(ert-deftest bazel-target-query-does-not-drop-action-on-cache-failure ()
  (let (selected)
    (cl-letf (((symbol-function 'my/bazel-workspace-root)
               (lambda (&rest _) "/workspace/"))
              ((symbol-function 'my/bazel--context)
               (lambda (&rest _) 'target-context))
              ((symbol-function 'my/bazel-executable)
               (lambda (&rest _) "bazel"))
              ((symbol-function 'my/bazel--cache-file)
               (lambda (&rest _) "/tmp/bazel-entry-cache.eld"))
              ((symbol-function 'my/bazel--cache-read)
               (lambda (&rest _) nil))
              ((symbol-function 'my/bazel--cache-write)
               (lambda (&rest _) (error "cache unavailable")))
              ((symbol-function 'remote-exec-async)
               (lambda (_program &rest args)
                 (funcall (plist-get args :callback)
                          (remote-exec-result-create
                           :status 0 :stdout "//pkg:item\n")))))
      (my/bazel-with-targets
       (lambda (_root _context _executable targets)
         (setq selected targets))
       t)
      (should (equal selected '("//pkg:item"))))))

(ert-deftest bazel-target-query-reports-empty-and-failed-results ()
  (let ((result (remote-exec-result-create :status 0 :stdout ""))
        (successes 0)
        (failures 0))
    (cl-letf (((symbol-function 'my/bazel-workspace-root)
               (lambda (&rest _) "/workspace/"))
              ((symbol-function 'my/bazel--context)
               (lambda (&rest _) 'target-context))
              ((symbol-function 'my/bazel-executable)
               (lambda (&rest _) "bazel"))
              ((symbol-function 'my/bazel--cache-file)
               (lambda (&rest _) "/tmp/bazel-entry-cache.eld"))
              ((symbol-function 'my/bazel--cache-read)
               (lambda (&rest _) nil))
              ((symbol-function 'remote-exec-async)
               (lambda (_program &rest args)
                 (funcall (plist-get args :callback) result))))
      (dotimes (_ 2)
        (my/bazel-with-targets
         (lambda (&rest _) (cl-incf successes)) t
         (lambda (_result) (cl-incf failures)))
        (setq result (remote-exec-result-create
                      :status 2 :stderr "connection failed")))
      (should (= successes 0))
      (should (= failures 2)))))

(ert-deftest bazel-output-directory-opens-in-origin-frame ()
  (let ((origin (generate-new-buffer " *bazel-output-origin*"))
        (active-frame 'frame-a)
        callback opened)
    (unwind-protect
        (with-current-buffer origin
          (cl-letf (((symbol-function 'selected-frame)
                     (lambda () active-frame))
                    ((symbol-function 'select-frame)
                     (lambda (frame &optional _norecord)
                       (setq active-frame frame)))
                    ((symbol-function 'frame-live-p)
                     (lambda (_frame) t))
                    ((symbol-function 'my/bazel-workspace-root)
                     (lambda (&rest _) "/workspace/"))
                    ((symbol-function 'my/bazel--context)
                     (lambda (&rest _) 'target-context))
                    ((symbol-function 'my/bazel-executable)
                     (lambda (&rest _) "bazel"))
                    ((symbol-function 'remote-exec-async)
                     (lambda (_program &rest args)
                       (setq callback (plist-get args :callback))))
                    ((symbol-function 'remote-expand-file-name)
                     (lambda (&rest _) "/workspace/bazel-bin"))
                    ((symbol-function 'dired)
                     (lambda (directory)
                       (setq opened (list active-frame directory)))))
            (bazel-output-bin)
            (setq active-frame 'frame-b)
            (funcall callback
                     (remote-exec-result-create
                      :status 0 :stdout "/workspace/bazel-bin"))
            (should (equal opened '(frame-a "/workspace/bazel-bin")))
            (should (eq active-frame 'frame-b))))
      (kill-buffer origin))))

