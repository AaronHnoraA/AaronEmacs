(require 'dirvish-yank)
(require 'remote-files)

(ert-deftest dirvish-create-uses-directory-at-point ()
  (let* ((root (file-truename (make-temp-file "dirvish-create-test-" t)))
         (nested (expand-file-name "nested" root))
         (existing (expand-file-name "existing.md" nested))
         (buffer nil)
         prompted-directory)
    (unwind-protect
        (progn
          (make-directory nested)
          (with-temp-file existing (insert "Existing\n"))
          (setq buffer (dired-noselect root))
          (with-current-buffer buffer
            (should (dired-goto-file nested))
            (dired-insert-subdir nested)
            (should (dired-goto-file existing))
            (cl-letf (((symbol-function 'read-file-name)
                       (lambda (_prompt directory &rest _)
                         (setq prompted-directory directory)
                         "new.md")))
              (call-interactively #'+dirvish/create))
            (should (equal prompted-directory
                           (file-name-as-directory nested)))
            (should (file-exists-p (expand-file-name "new.md" nested)))
            (should-not (file-exists-p (expand-file-name "new.md" root)))
            (should (dired-goto-file nested))
            (cl-letf (((symbol-function 'read-file-name)
                       (lambda (_prompt directory &rest _)
                         (setq prompted-directory directory)
                         "child/")))
              (call-interactively #'+dirvish/create))
            (should (equal prompted-directory
                           (file-name-as-directory nested)))
            (should (file-directory-p (expand-file-name "child" nested)))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory root t))))

(ert-deftest dirvish-create-keeps-logical-local-path-in-nested-directory ()
  (let* ((root (file-truename (make-temp-file "dirvish-fs-test-" t)))
         (nested (expand-file-name "nested" root))
         (existing (expand-file-name "existing.md" nested))
         (logical-nested (remote-canonicalize-file-name nested))
         (buffer nil)
         prompted-directory)
    (unwind-protect
        (progn
          (make-directory nested)
          (with-temp-file existing (insert "Existing\n"))
          (setq buffer (dired-noselect (remote-canonicalize-file-name root)))
          (with-current-buffer buffer
            (should (dired-goto-file logical-nested))
            (dired-insert-subdir logical-nested)
            (should (dired-goto-file
                     (remote-canonicalize-file-name existing)))
            (cl-letf (((symbol-function 'read-file-name)
                       (lambda (_prompt directory &rest _)
                         (setq prompted-directory directory)
                         "new.md")))
              (call-interactively #'+dirvish/create))
            (should (equal prompted-directory
                           (file-name-as-directory logical-nested)))
            (should (file-exists-p (expand-file-name "new.md" nested)))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory root t))))

(ert-deftest dirvish-actions-use-directory-at-point-in-expanded-subtree ()
  (let* ((root (file-truename (make-temp-file "dirvish-actions-test-" t)))
         (nested (expand-file-name "nested" root))
         (source (expand-file-name "source.md" root))
         (child (expand-file-name "child.md" nested))
         (logical-nested (remote-canonicalize-file-name nested))
         (buffer nil)
         copied-destination moved-destination linked-destination
         relative-destination hardlink-destination terminal-directory
         copied-directory search-directory go-directory queued-directory
         opened-file frame-created)
    (unwind-protect
        (progn
          (make-directory nested)
          (with-temp-file source (insert "Source\n"))
          (with-temp-file child (insert "Child\n"))
          (setq buffer (dired-noselect (remote-canonicalize-file-name root)))
          (with-current-buffer buffer
            (should (dired-goto-file logical-nested))
            (dired-insert-subdir logical-nested)
            (should (dired-goto-file logical-nested))
            (should (equal (remote-files--here)
                           (file-name-as-directory logical-nested)))
            (cl-letf (((symbol-function '+dirvish--marked-everywhere)
                       (lambda () (list (remote-canonicalize-file-name source))))
                      ((symbol-function 'dirvish-yank)
                       (lambda (&optional dest) (setq copied-destination dest)))
                      ((symbol-function 'dirvish-move)
                       (lambda (&optional dest) (setq moved-destination dest)))
                      ((symbol-function 'dirvish-symlink)
                       (lambda (&optional dest) (setq linked-destination dest)))
                      ((symbol-function 'dirvish-relative-symlink)
                       (lambda (&optional dest) (setq relative-destination dest)))
                      ((symbol-function 'dirvish-hardlink)
                       (lambda (&optional dest) (setq hardlink-destination dest)))
                      ((symbol-function 'remote-files--queue)
                       (lambda (_sources destination)
                         (setq queued-directory destination)))
                      ((symbol-function 'remote-transfer-command)
                       (lambda (&rest _) nil))
                      ((symbol-function 'remote-files-terminal)
                       (lambda () (setq terminal-directory default-directory)))
                      ((symbol-function '+dirvish--copy)
                       (lambda (value) (setq copied-directory value)))
                      ((symbol-function 'dirvish-fd)
                       (lambda (&rest _) (interactive)
                         (setq search-directory default-directory)))
                      ((symbol-function 'read-directory-name)
                       (lambda (_prompt directory &rest _)
                         (setq go-directory directory)
                         directory))
                      ((symbol-function 'dired)
                       (lambda (&rest _) nil)))
              (+dirvish/paste)
              (+dirvish/copy-here)
              (+dirvish/move-here)
              (should-not +dirvish--paste-method)
              (let ((+dirvish--paste-method 'cut))
                (+dirvish/paste))
              (cl-letf (((symbol-function '+dirvish--marked-everywhere)
                         (lambda () (list "/fs:test-machine:/tmp/source.md"))))
                (+dirvish/paste))
              (+dirvish/symlink)
              (+dirvish/relative-symlink)
              (+dirvish/hardlink)
              (+dirvish/shell-here)
              (+dirvish/copy-dirname)
              (+dirvish/fd-here)
              (call-interactively #'+dirvish/go-interactive))
            (should (equal copied-destination
                           (file-name-as-directory nested)))
            (should (equal moved-destination
                           (file-name-as-directory nested)))
            (should (equal queued-directory
                           (file-name-as-directory logical-nested)))
            (should (equal linked-destination
                           (file-name-as-directory nested)))
            (should (equal relative-destination
                           (file-name-as-directory nested)))
            (should (equal hardlink-destination
                           (file-name-as-directory nested)))
            (should (equal terminal-directory
                           (file-name-as-directory logical-nested)))
            (should (equal copied-directory logical-nested))
            (should (equal search-directory
                           (file-name-as-directory logical-nested)))
            (should (equal go-directory
                           (file-name-as-directory logical-nested)))
            (should (dired-goto-file (remote-canonicalize-file-name child)))
            (should (equal (+dirvish--directory-at-point)
                           (file-name-as-directory logical-nested)))
            (should (equal (remote-files--here)
                           (file-name-as-directory logical-nested)))
            (cl-letf (((symbol-function '+windows/frame-new)
                       (lambda () (setq frame-created t) (selected-frame)))
                      ((symbol-function 'find-file)
                       (lambda (file &rest _) (setq opened-file file)))
                      ((symbol-function 'select-frame-set-input-focus)
                       (lambda (&rest _) nil)))
              (call-interactively #'dirvish-open-new-frame))
            (should frame-created)
            (should (equal opened-file
                           (remote-canonicalize-file-name child)))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory root t))))

(ert-deftest dirvish-paste-copies-from-logical-local-dired-in-real-worker ()
  "The stock Dirvish subprocess receives native paths for `/fs:local:'."
  (let* ((root (file-truename (make-temp-file "dirvish-worker-test-" t)))
         (source (expand-file-name "source.txt" root))
         (destination (expand-file-name "out" root))
         (copy (expand-file-name "source.txt" destination))
         (buffer nil)
         process)
    (unwind-protect
        (progn
          (make-directory destination)
          (with-temp-file source (insert "copied through Dirvish\n"))
          (setq buffer (dired-noselect (remote-canonicalize-file-name root)))
          (with-current-buffer buffer
            (should (dired-goto-file (remote-canonicalize-file-name source)))
            (dired-mark 1)
            (should (dired-goto-file
                     (remote-canonicalize-file-name destination)))
            (+dirvish/paste))
          (setq process
                (seq-find (lambda (item)
                            (string-prefix-p "*dirvish-yank*"
                                             (process-name item)))
                          (process-list)))
          (let ((deadline (+ (float-time) 12)))
            (while (and (or (not (file-exists-p copy))
                            (and process (process-live-p process)))
                        (< (float-time) deadline))
              (accept-process-output nil 0.1)))
          (when process (should-not (process-live-p process)))
          (should (file-exists-p copy))
          (with-temp-buffer
            (insert-file-contents copy)
            (should (equal (buffer-string) "copied through Dirvish\n"))))
      (when (and process (process-live-p process))
        (delete-process process))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory root t))))

(ert-deftest dirvish-relative-link-from-logical-local-dired-uses-real-worker ()
  "The link worker also receives paths that its stock Emacs understands."
  (let* ((root (file-truename (make-temp-file "dirvish-link-worker-" t)))
         (source (expand-file-name "source.txt" root))
         (destination (expand-file-name "out" root))
         (link (expand-file-name "source.txt" destination))
         (buffer nil))
    (unwind-protect
        (progn
          (make-directory destination)
          (with-temp-file source (insert "linked\n"))
          (setq buffer (dired-noselect (remote-canonicalize-file-name root)))
          (with-current-buffer buffer
            (should (dired-goto-file (remote-canonicalize-file-name source)))
            (dired-mark 1)
            (should (dired-goto-file
                     (remote-canonicalize-file-name destination)))
            (+dirvish/relative-symlink))
          (let ((deadline (+ (float-time) 12)))
            (while (and (not (file-symlink-p link))
                        (< (float-time) deadline))
              (accept-process-output nil 0.1)))
          (should (file-symlink-p link))
          (should (equal (file-truename link) source)))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (delete-directory root t))))

(ert-deftest dirvish-paste-groups-cross-target-sources-before-launch ()
  "Each foreign source target gets one transfer; local files stay native."
  (let* ((+dirvish--paste-method 'copy)
         (destination "/fs:local:/tmp/dirvish-group-test/")
         (local "/fs:local:/tmp/dirvish-local-source")
         (first "/fs:first:/tmp/one")
         (second "/fs:second:/tmp/two")
         (third "/fs:first:/tmp/three")
         (sources (list local first second third))
         preflight queued copied)
    (cl-letf (((symbol-function '+dirvish--directory-at-point)
               (lambda () destination))
              ((symbol-function '+dirvish--marked-everywhere)
               (lambda () sources))
              ((symbol-function '+dirvish--dired-buffers)
               (lambda () nil))
              ((symbol-function 'remote-transfer-command)
               (lambda (files dest &rest _)
                 (push (cons files dest) preflight)))
              ((symbol-function 'remote-files--queue)
               (lambda (files dest)
                 (push (cons files dest) queued)))
              ((symbol-function 'dirvish-yank)
               (lambda (dest)
                 (setq copied (cons (funcall dirvish-yank-sources) dest)))))
      (+dirvish/paste)
      (should (equal (mapcar #'car (nreverse preflight))
                     (list (list first third) (list second))))
      (should (equal (mapcar #'car (nreverse queued))
                     (list (list first third) (list second))))
      (should (equal copied (cons (list "/tmp/dirvish-local-source")
                                  "/tmp/dirvish-group-test/"))))))

(ert-deftest dirvish-paste-preflight-failure-starts-no-partial-transfer ()
  "A failed route leaves marks and starts neither transfer nor native copy."
  (let ((+dirvish--paste-method 'copy)
        queued copied unmarked)
    (cl-letf (((symbol-function '+dirvish--directory-at-point)
               (lambda () "/fs:local:/tmp/"))
              ((symbol-function '+dirvish--marked-everywhere)
               (lambda () '("/fs:first:/tmp/one" "/fs:second:/tmp/two")))
              ((symbol-function 'remote-transfer-command)
               (lambda (&rest _) (error "route unavailable")))
              ((symbol-function 'remote-files--queue)
               (lambda (&rest _) (setq queued t)))
              ((symbol-function 'dirvish-yank)
               (lambda (&rest _) (setq copied t)))
              ((symbol-function '+dirvish--dired-buffers)
               (lambda () (setq unmarked t) nil)))
      (should-error (+dirvish/paste))
      (should-not queued)
      (should-not copied)
      (should-not unmarked)
      (should (eq +dirvish--paste-method 'copy)))))

(ert-deftest dirvish-cross-target-paste-rejects-colliding-names ()
  "Independent jobs must not race to overwrite the same destination name."
  (let ((+dirvish--paste-method 'copy)
        queued)
    (cl-letf (((symbol-function '+dirvish--directory-at-point)
               (lambda () "/fs:local:/tmp/out/"))
              ((symbol-function '+dirvish--marked-everywhere)
               (lambda () '("/fs:first:/tmp/one/report.md"
                            "/fs:second:/tmp/two/report.md")))
              ((symbol-function 'remote-files--queue)
               (lambda (&rest _) (setq queued t))))
      (should-error (+dirvish/paste) :type 'user-error)
      (should-not queued)
      (should (eq +dirvish--paste-method 'copy)))))

(ert-deftest dirvish-yank-menu-keeps-pending-method-when-preflight-fails ()
  "The menu's copy and move actions leave intent available for a retry."
  (dolist (case '((+dirvish/copy-here . copy)
                  (+dirvish/move-here . cut)))
    (let (+dirvish--paste-method)
      (cl-letf (((symbol-function '+dirvish--directory-at-point)
                 (lambda () "/fs:local:/tmp/"))
                ((symbol-function '+dirvish--marked-everywhere)
                 (lambda () '("/fs:remote-test:/tmp/source")))
                ((symbol-function 'remote-transfer-command)
                 (lambda (&rest _) (user-error "route unavailable"))))
        (should-error (funcall (car case)) :type 'user-error)
        (should (eq +dirvish--paste-method (cdr case)))))))

(ert-deftest dirvish-same-target-without-client-path-uses-routed-process ()
  "Keep logical paths out of Dirvish's worker and use the target queue."
  (let* ((root (make-temp-file "dirvish-routed-copy-" t))
         (source (expand-file-name "source.txt" root))
         (destination (expand-file-name "out" root))
         (logical-source (remote-canonicalize-file-name source))
         (logical-destination (remote-canonicalize-file-name destination))
         (worker-started nil)
         (marks-cleared nil)
         job)
    (unwind-protect
        (progn
          (make-directory destination)
          (with-temp-file source (insert "routed copy\n"))
          (cl-letf (((symbol-function 'remote-client-file-name)
                     (lambda (&rest _) nil))
                    ((symbol-function 'dirvish-yank)
                     (lambda (&rest _) (setq worker-started t)))
                    ((symbol-function '+dirvish--clear-marks)
                     (lambda () (setq marks-cleared t))))
            (setq job (+dirvish--client-yank
                       #'dirvish-yank logical-destination
                       (list logical-source))))
          (with-timeout (10 (error "Routed copy did not finish"))
            (while (eq (remote-transfer-job-state job) 'running)
              (accept-process-output nil 0.05)))
          (should-not worker-started)
          (should marks-cleared)
          (should (eq (remote-transfer-job-state job) 'done))
          (with-temp-buffer
            (insert-file-contents (expand-file-name "source.txt" destination))
            (should (equal (buffer-string) "routed copy\n"))))
      (when (and job (process-live-p (remote-transfer-job-process job)))
        (delete-process (remote-transfer-job-process job)))
      (when (and job (buffer-live-p (remote-transfer-job-log-buffer job)))
        (kill-buffer (remote-transfer-job-log-buffer job)))
      (delete-directory root t))))

(ert-deftest dirvish-mixed-target-paste-preflights-routed-side-before-queue ()
  "A known same-target failure must not start a foreign transfer."
  (let ((+dirvish--paste-method 'copy)
        queued)
    (cl-letf (((symbol-function '+dirvish--directory-at-point)
               (lambda () "/fs:local:/tmp/out/"))
              ((symbol-function '+dirvish--marked-everywhere)
               (lambda () '("/fs:local:/tmp/local.txt"
                            "/fs:remote-test:/tmp/foreign.txt")))
              ((symbol-function 'remote-client-file-name)
               (lambda (&rest _) nil))
              ((symbol-function 'remote-transfer-command)
               (lambda (&rest _) '(nil nil nil nil)))
              ((symbol-function 'remote-transfer-plan-file-operation)
               (lambda (&rest _) (user-error "source disappeared")))
              ((symbol-function 'remote-files--queue)
               (lambda (&rest _) (setq queued t))))
      (should-error (+dirvish/paste) :type 'user-error)
      (should-not queued)
      (should (eq +dirvish--paste-method 'copy)))))

(ert-deftest dirvish-layout-toggle-is-discoverable-in-keymap ()
  (require 'dirvish)
  (should (eq (lookup-key dirvish-mode-map (kbd "m l"))
              #'dirvish-layout-toggle))
  (should (eq (lookup-key dirvish-mode-map (kbd "M-t"))
              #'+portal/terminal-selector))
  (let ((root (make-temp-file "dirvish-layout-test-" t)))
    (unwind-protect
        (save-window-excursion
          (dirvish root)
          (should (eq (key-binding (kbd "M-t"))
                      #'+portal/terminal-selector))
          (should (> (car (dv-curr-layout (dirvish-curr))) 0))
          (dirvish-layout-toggle)
          (should-not (dv-curr-layout (dirvish-curr)))
          (dirvish-layout-toggle)
          (should (> (car (dv-curr-layout (dirvish-curr))) 0))
          (dirvish-quit))
      (delete-directory root t))))

(ert-deftest dirvish-yank-menu-uses-the-same-directory-actions ()
  (require 'dirvish-yank)
  (should (eq (plist-get (cdr (transient-get-suffix 'dirvish-yank-menu "y"))
                         :command)
              #'dirvish-copy-here))
  (should (eq (plist-get (cdr (transient-get-suffix 'dirvish-yank-menu "m"))
                         :command)
              #'dirvish-move-here))
  (should (eq (plist-get (cdr (transient-get-suffix 'dirvish-yank-menu "s"))
                         :command)
              #'dirvish-symlink-here)))

(ert-deftest dirvish-top-level-actions-are-searchable-and-match-their-keys ()
  "The row-aware commands appear in M-x and are the actual key targets."
  (require 'dirvish)
  (dolist (entry '(("y" . dirvish-select-for-copy)
                   ("x" . dirvish-select-for-move)
                   ("p p" . dirvish-paste-here)
                   ("p f" . dirvish-paste-force)
                   ("p l" . dirvish-symlink-here)
                   ("p L" . dirvish-relative-symlink-here)
                   ("p h" . dirvish-hardlink-here)
                   ("a" . dirvish-create-here)
                   ("d" . dirvish-trash)
                   ("D" . dirvish-delete-permanently)
                   ("g SPC" . dirvish-go-directory)
                   ("?" . dirvish-key-help)))
    (let ((command (cdr entry)))
      (should (commandp command))
      (should (member (symbol-name command)
                      (all-completions (symbol-name command)
                                       obarray #'commandp)))
      (should (eq (lookup-key dirvish-mode-map (kbd (car entry)))
                  command))))
  (should (eq (lookup-key dirvish-mode-map (kbd "h"))
              #'dired-up-directory))
  (should (eq (lookup-key dirvish-mode-map (kbd "l"))
              #'dired-find-file)))

(ert-deftest dirvish-key-only-commands-do-not-clutter-m-x ()
  "Generated navigation and sorting commands remain usable from their keys."
  (require 'dirvish)
  (dolist (key '("g h" ", m" "m s" "1"))
    (let ((command (lookup-key dirvish-mode-map (kbd key))))
      (should (symbolp command))
      (should (commandp command))
      (should-not (intern-soft (symbol-name command)))
      (should-not (member (symbol-name command)
                          (all-completions (symbol-name command)
                                           obarray #'commandp))))))

(ert-deftest dirvish-new-frame-keys-are-searchable-and-do-not-change-return ()
  (require 'dirvish)
  (should (commandp 'dirvish-open-new-frame))
  (should (eq (lookup-key dirvish-mode-map (kbd "RET")) #'dired-find-file))
  (let ((normal-map (evil-get-auxiliary-keymap dirvish-mode-map 'normal)))
    (dolist (key '("M-S-RET" "M-S-<return>"))
      (should (eq (lookup-key dirvish-mode-map (kbd key))
                  #'dirvish-open-new-frame))
      (should (eq (lookup-key normal-map (kbd key))
                  #'dirvish-open-new-frame)))
    (dolist (key '("M-RET" "M-<return>"))
      (should-not (eq (lookup-key dirvish-mode-map (kbd key))
                      #'dirvish-open-new-frame))
      (should-not (eq (lookup-key normal-map (kbd key))
                      #'dirvish-open-new-frame)))))

(ert-deftest dired-command-shift-return-opens-point-in-new-frame ()
  (let* ((root (make-temp-file "dired-frame-key-" t))
         (file (expand-file-name "entry.txt" root))
         (listing nil)
         opened)
    (unwind-protect
        (progn
          (with-temp-file file (insert "entry\n"))
          (setq listing (dired-noselect root))
          (with-current-buffer listing
            (goto-char (point-min))
            (should (search-forward "entry.txt" nil t))
            (beginning-of-line)
            (dolist (key '("M-S-RET" "M-S-<return>"))
              (should (eq (lookup-key dired-mode-map (kbd key))
                          #'+windows/dired-open-new-frame)))
            (cl-letf (((symbol-function 'file-open-new-frame)
                       (lambda (target &optional _wildcards)
                         (setq opened target))))
              (call-interactively #'+windows/dired-open-new-frame))
            (should (file-equal-p opened file))))
      (when (buffer-live-p listing) (kill-buffer listing))
      (delete-directory root t))))

(ert-deftest dirvish-return-split-keymaps ()
  "Dirvish and ordinary Dired share right and below opening gestures."
  (require 'dirvish)
  (let ((normal-map (evil-get-auxiliary-keymap dirvish-mode-map 'normal)))
    (dolist (map (list dired-mode-map dirvish-mode-map normal-map))
      (dolist (key '("S-RET" "S-<return>"))
        (should (eq (lookup-key map (kbd key)) #'+windows/dired-open-right)))
      (dolist (key '("M-RET" "M-<return>"))
        (should (eq (lookup-key map (kbd key)) #'+windows/dired-open-below))))))

(ert-deftest dirvish-return-splits-open-files-and-directories ()
  "Open a file right and a directory below while the list stays in place."
  (let* ((root (file-truename (make-temp-file "dirvish-return-split-" t)))
         (file (expand-file-name "entry.txt" root))
         (folder (expand-file-name "folder" root)))
    (unwind-protect
        (progn
          (with-temp-file file (insert "entry\n"))
          (make-directory folder)
          (save-window-excursion
            (delete-other-windows)
            (dired root)
            (let ((source (selected-window))
                  (listing (current-buffer)))
              (should (dired-goto-file file))
              (+windows/dired-open-right)
              (let ((right (selected-window)))
                (should (eq (window-buffer source) listing))
                (should (file-equal-p
                         (buffer-file-name (window-buffer right)) file))
                (should (> (car (window-edges right))
                           (car (window-edges source)))))
              (select-window source)
              (should (dired-goto-file folder))
              (+windows/dired-open-below)
              (let ((below (selected-window)))
                (should (eq (window-buffer source) listing))
                (should (with-current-buffer (window-buffer below)
                          (derived-mode-p 'dired-mode)))
                (should (> (cadr (window-edges below))
                           (cadr (window-edges source))))))))
      (delete-directory root t))))

