;;; init-output-frame-tests.el --- Frame-owned compilation output -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'tools/output/config)
(require 'tools/task/config)
(require 'tools/run/config)
(require 'remote-framework)

(ert-deftest output-workflow-logical-project-opens-a-task-workspace ()
  "A logical project without an open workspace still gets task ownership."
  (remote-config-load)
  (remote-fs-install)
  (let* ((native (make-temp-file "output-auto-workspace-" t))
         (logical (file-name-as-directory (remote-make-file-name "local" native)))
         (default-directory logical)
         (frame (selected-frame))
         (previous (frame-parameter frame '+output-last-buffer))
         buffer task workspace)
    (unwind-protect
        (progn
          (should-not (remote-workspace-for-path logical))
          (setq buffer (+output-compile "printf owned" "test")
                task (buffer-local-value 'remote-task-instance buffer)
                workspace (remote-get-workspace (remote-task-workspace-id task)))
          (should (remote-task-p task))
          (should (remote-workspace-live-p workspace))
          (let ((deadline (+ (float-time) 6)))
            (while (and (eq (remote-task-state task) 'running)
                        (< (float-time) deadline))
              (accept-process-output nil 0.05)))
          (should (eq (remote-task-state task) 'succeeded))
          (with-current-buffer buffer
            (goto-char (point-min))
            (should (search-forward "owned" nil t))))
      (when (and task (process-live-p (remote-task-process task)))
        (delete-process (remote-task-process task)))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (when (remote-workspace-live-p workspace)
        (remote-workspace-close workspace 'cleanup))
      (set-frame-parameter frame '+output-last-buffer previous)
      (delete-directory native t))))

(ert-deftest output-workflow-failed-launch-closes-only-a-new-workspace ()
  "A failed launch must not leave its newly created workspace behind."
  (remote-config-load)
  (remote-fs-install)
  (let* ((native (make-temp-file "output-failed-workspace-" t))
         (logical (file-name-as-directory (remote-make-file-name "local" native)))
         (default-directory logical)
         (frame (selected-frame))
         (previous (frame-parameter frame '+output-last-buffer))
         workspace)
    (unwind-protect
        (cl-letf (((symbol-function 'remote-task-run)
                   (lambda (&rest _) (error "Task launch failed"))))
          (should-error (+output-compile "exit 1" "test")
                        :type 'error)
          (should-not (remote-workspace-for-path logical))
          (should (eq (frame-parameter frame '+output-last-buffer) previous))
          (setq workspace
                (remote-workspace-open
                 logical :adapter "process" :capability 'process-async))
          (should-error (+output-compile "exit 1" "test")
                        :type 'error)
          (should (remote-workspace-live-p workspace))
          (should (eq (remote-workspace-for-path logical) workspace)))
      (when (remote-workspace-live-p workspace)
        (remote-workspace-close workspace 'cleanup))
      (set-frame-parameter frame '+output-last-buffer previous)
      (delete-directory native t))))

(ert-deftest output-workflow-native-path-reuses-its-open-local-workspace ()
  "The same task lifecycle applies inside a local project's workspace."
  (remote-config-load)
  (remote-fs-install)
  (let* ((native (make-temp-file "output-native-workspace-" t))
         (logical (file-name-as-directory (remote-make-file-name "local" native)))
         (default-directory native)
         (frame (selected-frame))
         (previous (frame-parameter frame '+output-last-buffer))
         (workspace (remote-workspace-open
                     logical :adapter "process" :capability 'process-async))
         buffer task)
    (unwind-protect
        (progn
          (setq buffer (+output-compile "printf local" "test")
                task (buffer-local-value 'remote-task-instance buffer))
          (should (remote-task-p task))
          (should (equal (remote-task-workspace-id task)
                         (remote-workspace-id workspace))))
      (when (and task (process-live-p (remote-task-process task)))
        (delete-process (remote-task-process task)))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (when (remote-workspace-live-p workspace)
        (remote-workspace-close workspace 'cleanup))
      (set-frame-parameter frame '+output-last-buffer previous)
      (delete-directory native t))))

(ert-deftest output-workflow-task-belongs-to-its-logical-workspace ()
  "A project output task is cancelled when its owning workspace closes."
  (remote-config-load)
  (remote-fs-install)
  (let* ((native (make-temp-file "output-workspace-test-" t))
         (logical (file-name-as-directory (remote-make-file-name "local" native)))
         (default-directory logical)
         (frame (selected-frame))
         (previous (frame-parameter frame '+output-last-buffer))
         (workspace (remote-workspace-open
                     logical :adapter "process" :capability 'process-async))
         buffer task process)
    (unwind-protect
        (progn
          (setq buffer (+output-compile
                        "sleep 30" "build" '(("BUILD_TOKEN" . "routed")))
                task (buffer-local-value 'remote-task-instance buffer)
                process (remote-task-process task))
          (should (remote-task-p task))
          (should (remote-task-resource task))
          (should (eq (buffer-local-value '+output-owner-frame buffer)
                      frame))
          (should (eq (frame-parameter frame '+output-last-buffer) buffer))
          (should (equal (remote-task-environment task)
                         '(("BUILD_TOKEN" . "routed"))))
          (with-current-buffer buffer
            (should (eq (local-key-binding (kbd "R")) #'+output/rerun))
            (should (eq (local-key-binding (kbd "K")) #'+output/stop))
            (should (eq (local-key-binding (kbd "g")) #'remote-task-rerun))
            (should-error (+output/rerun) :type 'user-error))
          (remote-workspace-close workspace 'test)
          (let ((deadline (+ (float-time) 6)))
            (while (and (process-live-p process) (< (float-time) deadline))
              (accept-process-output nil 0.05)))
          (should (eq (remote-task-state task) 'cancelled))
          (should-not (process-live-p process)))
      (when (and process (process-live-p process)) (delete-process process))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (when (remote-workspace-live-p workspace)
        (remote-workspace-close workspace 'cleanup))
      (set-frame-parameter frame '+output-last-buffer previous)
      (delete-directory native t))))

(ert-deftest output-workflow-controls-use-remote-task-lifecycle ()
  "Stop, rerun and buffer close operate on the target task and current frame."
  (remote-config-load)
  (remote-fs-install)
  (let* ((native (make-temp-file "output-controls-test-" t))
         (logical (file-name-as-directory (remote-make-file-name "local" native)))
         (default-directory logical)
         (frame (selected-frame))
         (previous (frame-parameter frame '+output-last-buffer))
         (workspace (remote-workspace-open
                     logical :adapter "process" :capability 'process-async))
         first second first-task second-task)
    (unwind-protect
        (progn
          (setq first (+output-compile
                       "sleep 30" "task" '(("TASK_TOKEN" . "same")))
                first-task (buffer-local-value 'remote-task-instance first))
          (with-current-buffer first (+output/stop))
          (let ((deadline (+ (float-time) 6)))
            (while (and (process-live-p (remote-task-process first-task))
                        (< (float-time) deadline))
              (accept-process-output nil 0.05)))
          (should (eq (remote-task-state first-task) 'cancelled))
          (should-not (process-live-p (remote-task-process first-task)))
          (setq second (with-current-buffer first (+output/rerun))
                second-task (buffer-local-value 'remote-task-instance second))
          (should (remote-task-p second-task))
          (should-not (equal (remote-task-id first-task)
                             (remote-task-id second-task)))
          (should (eq (buffer-local-value '+output-owner-frame second) frame))
          (should (eq (frame-parameter frame '+output-last-buffer) second))
          (should (equal (remote-task-command second-task)
                         (remote-task-command first-task)))
          (should (equal (remote-task-environment second-task)
                         (remote-task-environment first-task)))
          (kill-buffer second)
          (let ((deadline (+ (float-time) 6)))
            (while (and (process-live-p (remote-task-process second-task))
                        (< (float-time) deadline))
              (accept-process-output nil 0.05)))
          (should-not (process-live-p (remote-task-process second-task))))
      (dolist (task (list first-task second-task))
        (when (and task (process-live-p (remote-task-process task)))
          (delete-process (remote-task-process task))))
      (dolist (buffer (list first second))
        (when (buffer-live-p buffer) (kill-buffer buffer)))
      (when (remote-workspace-live-p workspace)
        (remote-workspace-close workspace 'cleanup))
      (set-frame-parameter frame '+output-last-buffer previous)
      (delete-directory native t))))

(ert-deftest output-workflow-compilation-is-owned-by-current-frame ()
  "Workflow output gets a stable frame name and remains the local latest."
  (let ((frame (selected-frame))
        (previous (frame-parameter nil '+output-last-buffer))
        buffer)
    (unwind-protect
        (progn
          (setq buffer (+output-compile "printf frame-output" "test"))
          (should (equal (buffer-name buffer)
                         (format "*test F%d*" (+frame-short-id frame))))
          (should (eq (buffer-local-value '+output-owner-frame buffer)
                      frame))
          (should (equal (buffer-local-value '+output-workflow-kind buffer)
                         "test"))
          (should (eq (+output--buffer) buffer))
          (should (equal (with-current-buffer buffer (+output--kind))
                         "test")))
      (when (buffer-live-p buffer)
        (when-let* ((process (get-buffer-process buffer)))
          (delete-process process))
        (kill-buffer buffer))
      (set-frame-parameter frame '+output-last-buffer previous))))

(ert-deftest output-workflow-falls-back-after-latest-buffer-is-closed ()
  "The frame can reopen its previous output after closing the latest one."
  (let* ((native (make-temp-file "output-history-test-" t))
         (default-directory native)
         (frame (selected-frame))
         (previous (frame-parameter frame '+output-last-buffer))
         first second)
    (unwind-protect
        (save-window-excursion
          (setq first (+output-compile "printf first" "task")
                second (+output-compile "printf second" "build"))
          (should (eq (frame-parameter frame '+output-last-buffer) second))
          (kill-buffer second)
          (should (buffer-live-p first))
          (should (eq (+output--buffer) first))
          (should (eq (frame-parameter frame '+output-last-buffer) first)))
      (dolist (buffer (list first second))
        (when (buffer-live-p buffer)
          (when-let* ((process (get-buffer-process buffer)))
            (delete-process process))
          (kill-buffer buffer)))
      (set-frame-parameter frame '+output-last-buffer previous)
      (delete-directory native t))))

(ert-deftest output-rerun-records-are-per-kind-and-launch-success-only ()
  "Task, build, run and test records do not overwrite one another."
  (let ((previous (frame-parameter nil '+output-last-runs)))
    (unwind-protect
        (progn
          (+output-record-run 'task "make lint" "/tmp/a/" nil)
          (+output-record-run 'build "make" "/tmp/b/" nil)
          (+output-record-run 'run "./app" "/tmp/c/" nil)
          (+output-record-run 'test "pytest" "/tmp/d/" nil)
          (should (equal (+output-last-run 'task)
                         '("make lint" "/tmp/a/" nil)))
          (should (equal (+output-last-run 'build)
                         '("make" "/tmp/b/" nil)))
          (should (equal (+output-last-run 'run)
                         '("./app" "/tmp/c/" nil)))
          (should (equal (+output-last-run 'test)
                         '("pytest" "/tmp/d/" nil)))
          (cl-letf (((symbol-function '+output-compile)
                     (lambda (&rest _) (error "Cannot start process")))
                    ((symbol-function '+task-candidates)
                     (lambda () '(("lint" . "make lint"))))
                    ((symbol-function '+task-project-root)
                     (lambda () "/tmp/"))
                    ((symbol-function '+project-local-env)
                     (lambda (&rest _) nil))
                    ((symbol-function '+task--resolve-command-executable)
                     #'identity))
            (should-error (+task--run "lint"))
            (should (equal (+output-last-run 'task)
                           '("make lint" "/tmp/a/" nil)))))
      (set-frame-parameter nil '+output-last-runs previous))))

(provide 'init-output-frame-tests)
;;; init-output-frame-tests.el ends here
