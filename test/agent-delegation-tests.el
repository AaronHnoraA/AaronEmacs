;;; agent-delegation-tests.el --- Emacs-owned background delegation -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'tools/agent/api)
(require 'tools/agent/sessions)
(require 'tools/agent/queue)
(require 'tools/agent/delegate)
(load (expand-file-name "test/agent-flow-e2e.el" user-emacs-directory) nil t)

(defmacro agent-delegation-tests--fixture (&rest body)
  (declare (indent 0))
  `(save-window-excursion
     (let* ((directory (file-name-as-directory (make-temp-file "agent-delegate-" t)))
            (store (expand-file-name "sessions.json" directory))
            (config (agent-flow-e2e--config store))
            (agent-shell-confirm-interrupt nil)
            (+agent-acp-notify-function nil)
            (+agent-requests--records nil)
            (before (buffer-list))
            (+agent-session-private-buffer-functions nil)
            (+agent-session-private-functions nil))
       (unwind-protect
           (cl-letf (((symbol-function '+agent-acp-config-for) (lambda (_) config))
                     ((symbol-function '+agent-workspace) (lambda (_) directory)))
             ,@body)
         (dolist (b (seq-difference (buffer-list) before))
           (when (+agent-acp-agent-buffer-p b)
             (ignore-errors (+agent-acp-shutdown b))
             (with-current-buffer b (let ((kill-buffer-query-functions nil)) (kill-buffer b)))))
         (delete-directory directory t)))))

(defun agent-delegation-tests--result (id)
  (+agent/api `((action . "result") (requestId . ,id))))

(defun agent-delegation-tests--done (id)
  (agent-flow-e2e--wait
   (lambda () (eq t (alist-get 'terminal (agent-delegation-tests--result id)))))
  (agent-delegation-tests--result id))

(ert-deftest agent-delegation-c60-spawn-background-and-read-exact-result ()
  (agent-delegation-tests--fixture
    (let* ((window (selected-window)) (shown (window-buffer window))
           (reply (+agent/api `((action . "spawn") (root . ,directory)
                                (agent . "flow-fixture") (name . "OCR") (prompt . "read note"))))
           (id (alist-get 'requestId reply))
           (buffer (get-buffer (alist-get 'buffer (alist-get 'session reply)))))
      (should (stringp id))
      (should (buffer-live-p buffer))
      (should (eq window (selected-window)))
      (should (eq shown (window-buffer window)))
      (should-not (get-buffer-window buffer t))
      (let ((result (agent-delegation-tests--done id)))
        (should (equal (alist-get 'state result) "completed"))
        (should (equal (alist-get 'text result) "Reply: read note\n"))
        (should (equal (alist-get 'stopReason result) "end_turn")))
      (should (plist-get (+agent-session-snapshot buffer) :background))
      (with-current-buffer buffer
        (should-not (memq buffer (+agent-acp--tab-buffers directory))))
      (should (memq buffer (+agent-pool-buffers directory)))
      (+agent-acp-show-buffer buffer)
      (should (get-buffer-window buffer t)))))

(ert-deftest agent-delegation-c60-queued-identical-prompts-have-separate-results ()
  (agent-delegation-tests--fixture
    (let* ((start (+agent/api `((action . "spawn") (root . ,directory)
                                (agent . "flow-fixture") (prompt . "hold"))))
           (first (alist-get 'requestId start))
           (buffer (get-buffer (alist-get 'buffer (alist-get 'session start)))))
      (agent-flow-e2e--wait (lambda () (equal (alist-get 'state (agent-delegation-tests--result first)) "running")))
      (let* ((identity `((buffer . ,(buffer-name buffer))
                         (nativeSessionId . ,(+agent-acp-state-value buffer '(:session :id)))))
             (one (alist-get 'requestId (+agent/api `((action . "send") (prompt . "same long task") ,@identity))))
             (two (alist-get 'requestId (+agent/api `((action . "send") (prompt . "same long task") ,@identity)))))
        (should-not (equal one two))
        (+agent-acp-stop buffer)
        (should (equal (alist-get 'state (agent-delegation-tests--done first)) "cancelled"))
        (should (equal (alist-get 'state (agent-delegation-tests--result one)) "held"))
        (with-current-buffer buffer (setq-local agent-shell-prompt-queue-merge t))
        (+agent-queue-resume buffer)
        (should (equal (alist-get 'text (agent-delegation-tests--done one)) "Reply: same long task\n"))
        (should (equal (alist-get 'text (agent-delegation-tests--done two)) "Reply: same long task\n"))))))

(ert-deftest agent-delegation-c60-queued-rpc-failure-does-not-absorb-next-task ()
  (agent-delegation-tests--fixture
    (let* ((first (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture") (prompt . "hold"))))
           (buffer (get-buffer (alist-get 'buffer (alist-get 'session first)))))
      (agent-flow-e2e--wait (lambda () (equal (alist-get 'state (agent-delegation-tests--result (alist-get 'requestId first))) "running")))
      (let* ((identity `((buffer . ,(buffer-name buffer)) (nativeSessionId . ,(+agent-acp-state-value buffer '(:session :id)))))
             (failed (alist-get 'requestId (+agent/api `((action . "send") (prompt . "rpc-fail") ,@identity)))))
        (+agent-acp-stop buffer)
        (agent-delegation-tests--done (alist-get 'requestId first))
        (+agent-queue-resume buffer)
        (should (equal (alist-get 'state (agent-delegation-tests--done failed)) "failed"))
        (let ((next (alist-get 'requestId (+agent/api `((action . "send") (prompt . "next") ,@identity)))))
          (should (equal (alist-get 'text (agent-delegation-tests--done next)) "Reply: next\n")))
        (should (equal (alist-get 'state (agent-delegation-tests--result failed)) "failed"))
        (should (equal (alist-get 'text (agent-delegation-tests--result failed)) ""))))))

(ert-deftest agent-delegation-c60-refusal-and-client-exit-are-not-success ()
  (agent-delegation-tests--fixture
    (dolist (case '(("refuse" . "failed") ("crash-later" . "interrupted")))
      (let* ((reply (+agent/api `((action . "spawn") (root . ,directory)
                                 (agent . "flow-fixture") (prompt . ,(car case)))))
             (result (agent-delegation-tests--done (alist-get 'requestId reply))))
        (should (equal (alist-get 'state result) (cdr case)))))))

(ert-deftest agent-delegation-c60-independent-workers-and-request-pages ()
  (agent-delegation-tests--fixture
    (let* ((a (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture") (prompt . "alpha"))))
           (b (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture") (prompt . "beta"))))
           (a-id (alist-get 'requestId a)) (b-id (alist-get 'requestId b)))
      (should (equal (alist-get 'text (agent-delegation-tests--done a-id)) "Reply: alpha\n"))
      (should (equal (alist-get 'text (agent-delegation-tests--done b-id)) "Reply: beta\n"))
      (let ((page (+agent/api `((action . "tasks") (root . ,directory) (limit . 1)))))
        (should (= (alist-get 'total page) 2))
        (should (= (alist-get 'nextOffset page) 1))
        (should (equal (alist-get 'requestId (aref (alist-get 'tasks page) 0)) b-id))
        (should (equal (alist-get 'requestId
                                 (aref (alist-get 'tasks (+agent/api `((action . "tasks") (offset . 1)))) 0)) a-id)))
      (let ((page (+agent/api `((action . "result") (requestId . ,a-id) (offset . 7) (limit . 3)))))
        (should (equal (alist-get 'text page) "alp"))
        (should (= (alist-get 'nextOffset page) 10)))
      (should-error (+agent/api `((action . "result") (requestId . ,a-id) (limit . 32001))) :type 'user-error))))

(ert-deftest agent-delegation-c60-notify-parent-once-and-ignore-stale-parent ()
  (agent-delegation-tests--fixture
    (let* ((parent-reply (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture") (prompt . "parent"))))
           (parent (get-buffer (alist-get 'buffer (alist-get 'session parent-reply)))))
      (agent-delegation-tests--done (alist-get 'requestId parent-reply))
      (let* ((identity `((buffer . ,(buffer-name parent)) (nativeSessionId . ,(+agent-acp-state-value parent '(:session :id)))))
             (reply (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture")
                                  (prompt . "child") (notify . ,identity))))
             (id (alist-get 'requestId reply)))
        (agent-delegation-tests--done id)
        (agent-flow-e2e--wait (lambda () (equal (alist-get 'notification (agent-delegation-tests--result id)) "submitted")))
        (should-not (plist-get (+agent-requests-get id) :notify))
        (agent-flow-e2e--idle parent)
        (should (string-match-p (regexp-quote id) (agent-flow-e2e--text parent)))
        (should-not (get-buffer-window parent t))
        ;; A dead parent cannot be silently replaced or restarted for a reply.
        (let* ((late (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture")
                                   (prompt . "hold") (notify . ,identity))))
               (late-id (alist-get 'requestId late))
               (child (get-buffer (alist-get 'buffer (alist-get 'session late)))))
          (agent-flow-e2e--wait (lambda () (equal (alist-get 'state (agent-delegation-tests--result late-id)) "running")))
          (+agent-acp-shutdown parent)
          (+agent-acp-stop child)
          (agent-delegation-tests--done late-id)
          (agent-flow-e2e--wait (lambda () (equal (alist-get 'notification (agent-delegation-tests--result late-id)) "failed")))
          (should (stringp (alist-get 'notificationError (agent-delegation-tests--result late-id)))))))))

(ert-deftest agent-delegation-c60-queue-removal-notifies-without-polling ()
  (agent-delegation-tests--fixture
    (let* ((reply (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture") (prompt . "hold"))))
           (buffer (get-buffer (alist-get 'buffer (alist-get 'session reply)))))
      (agent-flow-e2e--wait (lambda () (equal (alist-get 'state (agent-delegation-tests--result (alist-get 'requestId reply))) "running")))
      (let* ((identity `((buffer . ,(buffer-name buffer)) (nativeSessionId . ,(+agent-acp-state-value buffer '(:session :id)))))
             (queued (+agent/api `((action . "send") (prompt . "remove me") (notify . ,identity) ,@identity)))
             (record (+agent-requests-get (alist-get 'requestId queued)))
             notices)
        (cl-letf (((symbol-function '+agent-requests--notify) (lambda (r) (push r notices))))
          (+agent-queue-remove buffer 0)
          (agent-flow-e2e--wait (lambda () notices))
          (should (eq (car notices) record))
          (should (eq (plist-get record :status) 'untracked)))
        (+agent-acp-stop buffer)
        (agent-delegation-tests--done (alist-get 'requestId reply))))))

(ert-deftest agent-delegation-c60-capacity-refusal-does-not-start-another-client ()
  (agent-delegation-tests--fixture
    (let* ((+agent-requests--capacity 1)
           (reply (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture") (prompt . "hold"))))
           (before (+agent-pool-buffers directory)))
      (should-error (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture") (prompt . "extra"))) :type 'user-error)
      (should (equal before (+agent-pool-buffers directory)))
      (agent-flow-e2e--wait (lambda () (equal (alist-get 'state (agent-delegation-tests--result (alist-get 'requestId reply))) "running")))
      (+agent-acp-stop (car before))
      (agent-delegation-tests--done (alist-get 'requestId reply)))))

(ert-deftest agent-delegation-c60-initialization-rpc-error-is-terminal ()
  (agent-delegation-tests--fixture
    (let ((original (symbol-function 'acp-send-request)))
      (cl-letf (((symbol-function 'acp-send-request)
                 (lambda (&rest args)
                   (if (equal (map-elt (plist-get args :request) :method) "session/new")
                       (funcall (plist-get args :on-failure)
                                '((code . -32000) (message . "Cannot initialize session")) nil)
                     (apply original args)))))
        (let* ((reply (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture") (prompt . "task"))))
               (result (agent-delegation-tests--done (alist-get 'requestId reply))))
          (should (equal (alist-get 'state result) "failed"))
          (should (equal (alist-get 'stopReason result) "Cannot initialize session")))))))

(ert-deftest agent-delegation-c61-commands-spawn-and-manually-open-worker ()
  (agent-delegation-tests--fixture
    (let* ((reply (agent-spawn "flow-fixture" "OCR" "read note" directory))
           (worker (get-buffer (alist-get 'buffer (alist-get 'session reply)))))
      (agent-delegation-tests--done (alist-get 'requestId reply))
      (should-not (get-buffer-window worker t))
      (cl-letf (((symbol-function 'completing-read) (lambda (_ choices &rest _) (caar choices))))
        (agent-open-worker))
      (should (get-buffer-window worker t)))))

(ert-deftest agent-delegation-c61-manager-command-keeps-selected-parent-and-workspace ()
  (agent-delegation-tests--fixture
    (let* ((parent-reply (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture") (prompt . "parent"))))
           (parent (get-buffer (alist-get 'buffer (alist-get 'session parent-reply))))
           (answers '("OCR" "read note")) default-root reply hidden)
      (agent-delegation-tests--done (alist-get 'requestId parent-reply))
      (with-temp-buffer
        (let ((+agent-manager--model t) (+agent-manager--selected parent))
          (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) "flow-fixture"))
                    ((symbol-function 'read-string) (lambda (&rest _) (pop answers)))
                    ((symbol-function 'read-directory-name)
                     (lambda (_ root &rest _) (setq default-root root) directory)))
            (setq reply (call-interactively #'agent-spawn)))
          (should (equal (directory-file-name default-root) (directory-file-name directory)))
          (should (equal (alist-get 'buffer (alist-get 'parent (alist-get 'session reply))) (buffer-name parent)))
          (cl-letf (((symbol-function 'completing-read) (lambda (_ choices &rest _) (caar choices)))
                    ((symbol-function '+agent-manager-hide) (lambda () (setq hidden t))))
            (agent-open-worker))
          (should hidden)))
      (agent-delegation-tests--done (alist-get 'requestId reply)))))

(ert-deftest agent-delegation-c60-recover-task-ids-without-prompts-or-replies ()
  (agent-delegation-tests--fixture
    (let* ((first (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture")
                                (name . "OCR") (prompt . "private source material"))))
           (id (alist-get 'requestId first))
           (worker (get-buffer (alist-get 'buffer (alist-get 'session first)))))
      (agent-delegation-tests--done id)
      (let* ((page (+agent/api `((action . "tasks") (root . ,directory) (limit . 1))))
             (row (aref (alist-get 'tasks page) 0)))
        (should (equal (alist-get 'requestId row) id))
        (should (equal (alist-get 'name (alist-get 'session row)) "OCR"))
        (should (numberp (alist-get 'createdAt row)))
        (should (>= (alist-get 'finishedAt row) (alist-get 'createdAt row)))
        (should-not (string-match-p "private source material" (prin1-to-string page)))
        (should-not (assq 'text row))
        (should (zerop (alist-get 'total (+agent/api `((action . "tasks") (root . "/unlikely-other-project/")))))))
      (let ((+agent-session-private-buffer-functions (list (lambda (b) (eq b worker)))))
        (should (zerop (alist-get 'total (+agent/api '((action . "tasks")))))))
      (let ((native (+agent-acp-state-value worker '(:session :id))))
        (+agent-acp-kill worker)
        (let ((result (agent-delegation-tests--result id)))
          (should (equal (alist-get 'nativeSessionId (alist-get 'session result)) native))
          (should (equal (alist-get 'name (alist-get 'session result)) "OCR")))))))

(ert-deftest agent-delegation-c60-finished-receipt-releases-execution-context ()
  (agent-delegation-tests--fixture
    (let* ((reply (+agent/api `((action . "spawn") (root . ,directory) (agent . "flow-fixture") (prompt . "alpha"))))
           (id (alist-get 'requestId reply)))
      (agent-delegation-tests--done id)
      (let ((record (+agent-requests-get id)))
        (should-not (plist-get record :content))
        (should-not (plist-get record :prompt))
        (should-not (plist-get record :state))
        (should (equal (alist-get 'text (agent-delegation-tests--result id)) "Reply: alpha\n"))))))

(provide 'agent-delegation-tests)
