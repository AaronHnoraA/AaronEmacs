;;; remote-url-tests.el --- Source URL placement and channel ownership -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(unless (featurep 'remote-framework-tests)
  (load (expand-file-name "remote-framework-tests.el" (file-name-directory (or load-file-name buffer-file-name))) nil t))

(defmacro remote-url-test-with-target (&rest body)
  "Run BODY with real client TCP forwards for a distinct target namespace."
  (declare (indent 0))
  `(remote-framework-test-with-registry
     (let ((remote-workspace-open-hook nil) (remote-workspace-close-hook nil))
       (remote-register-target "url-test" :trusted t)
       (remote-register-backend "url-test"
                                :capabilities '(port-forward)
                                :connect (lambda (&rest _) t)
                                :live (lambda (&rest _) t)
                                :port-forward #'remote-backend-native-forward
                                :describe (lambda () '(:network-location target)))
       (remote-register-pipeline "url-test" "test" '("url-test"))
       (unwind-protect (progn ,@body)
         (remote-workspace-clear 'url-test)
         (remote-channel-clear)
         (remote-connection-pool-clear t)
         (remote-pipeline-runtime-clear 'url-test)))))

(ert-deftest remote-url-client-network-is-a-noop-without-a-session-or-workspace ()
  (remote-framework-test-with-registry
    (cl-letf (((symbol-function 'remote-session-acquire)
               (lambda (&rest _) (ert-fail "Client URL acquired a network session")))
              ((symbol-function 'remote-port-forward)
               (lambda (&rest _) (ert-fail "Client URL opened a proxy"))))
      (let ((url "http://localhost:3100/a%2Fb?q=%23#fragment"))
        (should (equal (remote-url-for-client url :context "/fs:local:/tmp/") url))
        (should (zerop (hash-table-count remote-workspaces)))
        (should-not (remote-channel-list))))))

(ert-deftest remote-url-client-network-placement-is-independent-of-target-id ()
  (remote-url-test-with-target
    (setf (remote-backend-describe-function (remote-get-backend "url-test"))
          (lambda () '(:network-location client)))
    (cl-letf (((symbol-function 'remote-session-acquire)
               (lambda (&rest _) (ert-fail "Client placement acquired a session"))))
      (let ((url "http://localhost:3100/"))
        (should (equal (remote-url-for-client url :context "/fs:url-test:/tmp/client-network/") url))
        (should (zerop (hash-table-count remote-workspaces)))
        (should-not (remote-channel-list))))))

(ert-deftest remote-url-non-loopback-and-non-http-do-not-probe-a-target ()
  (cl-letf (((symbol-function 'remote-channel--route)
             (lambda (&rest _) (ert-fail "An ordinary URL probed target routes"))))
    (dolist (url '("https://example.test:443/path?q=x#part" "mailto:test@example.test"
                   "file:///tmp/document" "data:text/html,hello" "http://localhost.example.test:3000/"))
      (should (equal (remote-url-for-client url :context "/fs:unconfigured:/tmp/") url)))))

(ert-deftest remote-url-invalid-or-ambiguous-loopback-never-opens-a-channel ()
  (cl-letf (((symbol-function 'remote-port-forward)
             (lambda (&rest _) (ert-fail "Invalid URL opened a forward"))))
    (dolist (url '("http://localhost:0/" "http://localhost:65536/" "http://localhost:bad/" "http://localhost:3000/a\nnext"))
      (should-error (remote-url-for-client url :context "/fs:local:/tmp/") :type 'user-error))
    (should-error (remote-url-for-client "http://localhost:3000/") :type 'user-error)))

(ert-deftest remote-url-parsing-preserves-userinfo-path-query-fragment-and-ip-family ()
  (let ((parts (remote-channel--url-endpoint "HTTPS://user:p%40ss@[::1]:8443/a%2Fb?q=a+b&next=%2F#frag")))
    (should (equal (seq-take parts 3) '("HTTPS://" "user:p%40ss@" "/a%2Fb?q=a+b&next=%2F#frag")))
    (should (equal (nth 3 parts) '(:host "::1" :port 8443))))
  (should (equal (nth 3 (remote-channel--url-endpoint "https://localhost/")) '(:host "localhost" :port 443)))
  (dolist (host '("::1" "::0001" "0:0:0:0:0:0:0:1" "0000:0::0:0001"))
    (should (equal (nth 3 (remote-channel--url-endpoint (format "http://[%s]:3000/" host)))
                   (list :host host :port 3000))))
  (dolist (host '("1::" "0::0::1" ":::1" "00000::1" "0:1" "::2" "::0:0:0:0:0:0:0:1"))
    (should-not (remote-channel--ipv6-loopback-p host)))
  (should (equal (nth 3 (remote-channel--url-endpoint "http://0.0.0.0:3000/")) '(:host "127.0.0.1" :port 3000)))
  (should (equal (nth 3 (remote-channel--url-endpoint "http://[::]:3000/")) '(:host "::1" :port 3000))))

(ert-deftest remote-url-workspace-reuses-one-forward-and-reads-recovered-handle ()
  (remote-url-test-with-target
    (let* ((workspace (remote-workspace-open "/fs:url-test:/tmp/one/" :connect nil))
           (url "http://user:p%40ss@localhost:3100/a%2Fb?q=%23#part")
           (first (remote-url-for-client url :workspace workspace))
           (resource (car (remote-workspace-resources workspace)))
           (group (remote-workspace-resource-value resource))
           recovered)
      (should (string-match-p (concat "\\`http://user:p%40ss@127\\.0\\.0\\.1:[0-9]+"
                                     (regexp-quote "/a%2Fb?q=%23#part") "\\'") first))
      (cl-letf (((symbol-function 'remote-channel--route)
                 (lambda (&rest _) (ert-fail "A live URL forward resolved another route"))))
        (should (equal (remote-url-for-client url :workspace workspace) first)))
      (should (= (length (remote-workspace-resources workspace)) 1))
      (should (= (length (remote-channel-list "url-test")) 1))
      (setq recovered (remote-workspace-recover-resource workspace resource))
      (should-not (eq recovered group))
      (should (eq recovered (remote-workspace-resource-value resource)))
      (should-not (remote-channel-group-live-p group))
      (should (equal (remote-url-for-client url :workspace workspace) first))
      (remote-channel-group-close recovered)
      (should (stringp (remote-url-for-client url :workspace workspace)))
      (should (= (length (remote-workspace-resources workspace)) 1))
      (should (= (length (remote-channel-list "url-test")) 1))
      (remote-workspace-close workspace)
      (should-not (remote-channel-list "url-test"))
      (should-error (remote-url-for-client url :workspace workspace) :type 'user-error))))

(ert-deftest remote-url-projects-have-independent-forward-lifetimes ()
  (remote-url-test-with-target
    (let* ((one (remote-workspace-open "/fs:url-test:/tmp/project-one/" :connect nil))
           (two (remote-workspace-open "/fs:url-test:/tmp/project-two/" :connect nil))
           (url "http://127.0.0.1:3100/"))
      (should-not (equal (remote-url-for-client url :workspace one) (remote-url-for-client url :workspace two)))
      (should (= (length (remote-channel-list "url-test")) 2))
      (remote-workspace-close one)
      (should (= (length (remote-channel-list "url-test")) 1))
      (should (stringp (remote-url-for-client url :workspace two)))
      (should-error (remote-url-for-client url :workspace two :context "/fs:local:/tmp/") :type 'user-error)
      (setf (remote-workspace-state two) 'disconnected)
      (should-error (remote-url-for-client url :workspace two) :type 'user-error))))

(ert-deftest remote-url-invalid-client-endpoint-rolls-back-the-owned-channel ()
  (remote-url-test-with-target
    (let ((workspace (remote-workspace-open "/fs:url-test:/tmp/bad/" :connect nil))
          (original (symbol-function 'remote-channel-group-endpoints)))
      (cl-letf (((symbol-function 'remote-channel-group-endpoints)
                 (lambda (group &optional side)
                   (if (eq side 'local) '((http . (:host "127.0.0.1" :port 0)))
                     (funcall original group side)))))
        (should-error (remote-url-for-client "http://localhost:3100/" :workspace workspace)))
      (should-not (remote-workspace-resources workspace))
      (should-not (remote-channel-list))
      (should (zerop (hash-table-count remote-channel-groups))))))

(ert-deftest remote-url-owner-closing-during-open-rolls-back-the-new-forward ()
  (remote-url-test-with-target
    (let ((workspace (remote-workspace-open "/fs:url-test:/tmp/closing/" :connect nil))
          (original (symbol-function 'remote-backend-native-forward)))
      (cl-letf (((symbol-function 'remote-backend-native-forward)
                 (lambda (&rest args)
                   (prog1 (apply original args)
                     (remote-workspace-close workspace)))))
        (should-error (remote-url-for-client "http://localhost:3100/" :workspace workspace) :type 'user-error))
      (should-not (remote-workspace-resources workspace))
      (should-not (remote-channel-list))
      (should (zerop (hash-table-count remote-channel-groups))))))

(ert-deftest remote-url-child-context-uses-the-existing-project-owner ()
  (remote-url-test-with-target
    (let* ((workspace (remote-workspace-open "/fs:url-test:/tmp/owner/" :connect nil))
           (url "http://localhost:3100/")
           (from-context
            (with-temp-buffer
              (setq default-directory "/fs:unrelated-callback:/elsewhere/")
              (remote-url-for-client url :context "/fs:url-test:/tmp/owner/child/"))))
      (should (equal from-context (remote-url-for-client url :workspace workspace)))
      (should (= (length (remote-workspace-resources workspace)) 1))
      (should (= (hash-table-count remote-workspaces) 1)))))

(ert-deftest remote-url-local-handle-loss-does-not-disconnect-the-workspace ()
  (remote-url-test-with-target
    (let* ((remote-workspace-auto-reconnect nil)
           (workspace (remote-workspace-open "/fs:url-test:/tmp/forward-only/" :connect nil))
           (url "http://127.0.0.1:3100/")
           first resource group forward replacement)
      (should-not (remote-workspace-routes workspace))
      (setq first (remote-url-for-client url :workspace workspace)
            resource (car (remote-workspace-resources workspace))
            group (remote-workspace-resource-value resource)
            forward (cdar (remote-channel-group-channels group)))
      (should (equal (remote-workspace-routes workspace) (list (remote-forward-route forward))))
      (delete-process (remote-forward-handle forward))
      (accept-process-output nil 0.01)
      (should (eq (remote-workspace-resource-state resource) 'failed))
      (should (remote-workspace-live-p workspace))
      (setq replacement (remote-workspace-recover-resource workspace resource))
      (should-not (eq replacement group))
      (should (remote-channel-group-live-p replacement))
      (should (equal (remote-url-for-client url :workspace workspace) first))
      (remote-workspace-close workspace)
      (should-not (remote-channel-list)))))

(ert-deftest remote-url-direct-forward-and-adopted-channel-record-their-owner-route ()
  (remote-framework-test-with-registry
    (let* ((remote-workspace-open-hook nil) (remote-workspace-close-hook nil)
           (workspace (remote-workspace-open "/fs:local:/tmp/owned-channel/" :connect nil))
           (context (remote-workspace-context workspace))
           (forward (remote-port-forward '(:host "127.0.0.1" :port 3100)
                                         :context context :workspace workspace))
           (listener (make-network-process :name "remote-url-adopted-listener"
                                           :server t :host "127.0.0.1" :service t :noquery t))
           channel)
      (unwind-protect
          (progn
            (should (member (remote-forward-route forward) (remote-workspace-routes workspace)))
            (setq channel (remote-channel-adopt listener :kind 'listener :context context :workspace workspace))
            (should (member (remote-channel-route channel) (remote-workspace-routes workspace)))
            (remote-workspace-close workspace)
            (should-not (process-live-p listener))
            (should-not (remote-channel-live-p forward)))
        (when (process-live-p listener) (delete-process listener))
        (remote-workspace-close workspace)))))

(ert-deftest remote-url-file-operations-register-only-an-existing-owning-workspace ()
  (remote-framework-test-with-registry
    (remote-fs-install)
    (let* ((remote-workspace-open-hook nil) (remote-workspace-close-hook nil)
           (root (file-name-as-directory (make-temp-file "remote-url-file-owner-" t)))
           (logical (remote-make-file-name "local" root))
           (workspace (remote-workspace-open logical :connect nil)))
      (unwind-protect
          (progn
            (write-region "owner" nil (concat logical "owned.txt") nil 'silent)
            (should (seq-some (lambda (route) (equal (remote-route-backend-id route) "native"))
                              (remote-workspace-routes workspace)))
            (should (= (hash-table-count remote-workspaces) 1))
            (remote-workspace-close workspace)
            (write-region "owner ended" nil (concat logical "owned.txt") nil 'silent)
            (should (zerop (hash-table-count remote-workspaces))))
        (remote-workspace-close workspace)
        (delete-directory root t)))))

(ert-deftest remote-url-mixed-backends-finish-old-invalidation-before-new-acquisition ()
  (remote-url-test-with-target
    (remote-register-backend "url-other" :capabilities '(port-forward)
                             :connect (lambda (&rest _) t) :live (lambda (&rest _) t)
                             :port-forward #'remote-backend-native-forward)
    (remote-register-pipeline "url-test" "test" '("url-test" "url-other"))
    (let* ((workspace (remote-workspace-open "/fs:url-test:/tmp/mixed/" :connect nil))
           (routes (remote-routes "network" 'port-forward (remote-workspace-context workspace)))
           events)
      (should (= (length routes) 2))
      (setf (remote-workspace-routes workspace) routes
            (remote-workspace-state workspace) 'disconnected)
      (cl-letf (((symbol-function 'remote-session-invalidate)
                 (lambda (route &rest _)
                   (push (list 'invalidate (remote-route-backend-id route)) events)))
                ((symbol-function 'remote-session-acquire)
                 (lambda (route &rest _)
                   (push (list 'acquire (remote-route-backend-id route)) events))))
        (remote-workspace-reconnect workspace))
      (should (equal (mapcar #'car (nreverse events)) '(invalidate invalidate acquire acquire)))
      (should (remote-workspace-live-p workspace)))))

(defun remote-url-test--await (predicate)
  "Service only the test's bounded asynchronous recovery."
  (let ((deadline (+ (float-time) 3)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.01))
    (should (funcall predicate))))

(ert-deftest remote-url-local-recovery-preserves-peer-project-and-its-handle ()
  (remote-url-test-with-target
    (let* ((remote-workspace-auto-reconnect t)
           (one (remote-workspace-open "/fs:url-test:/tmp/isolated-one/" :connect nil))
           (two (remote-workspace-open "/fs:url-test:/tmp/isolated-two/" :connect nil))
           (url "http://127.0.0.1:3100/")
           (first (remote-url-for-client url :workspace one))
           (_peer-url (remote-url-for-client url :workspace two))
           (resource (car (remote-workspace-resources one)))
           (old (remote-workspace-resource-value resource))
           (peer-resource (car (remote-workspace-resources two)))
           (peer (remote-workspace-resource-value peer-resource)))
      (cl-letf (((symbol-function 'remote-report-route-failure)
                 (lambda (&rest _) (ert-fail "Local handle loss invalidated the pipeline")))
                ((symbol-function 'remote-session-invalidate)
                 (lambda (&rest _) (ert-fail "Local recovery invalidated a pooled attachment"))))
        (delete-process (remote-forward-handle (cdar (remote-channel-group-channels old))))
        (remote-url-test--await
         (lambda () (and (not (eq old (remote-workspace-resource-value resource)))
                          (not (remote-workspace-resource-recovering-p one resource)))))
        (should (equal (remote-url-for-client url :workspace one) first))
        (should (remote-workspace-live-p one))
        (should (remote-workspace-live-p two))
        (should (eq peer (remote-workspace-resource-value peer-resource)))
        (should (remote-channel-group-live-p peer))))))

(ert-deftest remote-url-local-recovery-coalesces-and-blocks-duplicate-open ()
  (remote-url-test-with-target
    (let* ((remote-workspace-auto-reconnect t)
           (workspace (remote-workspace-open "/fs:url-test:/tmp/coalesced/" :connect nil))
           (url "http://localhost:3100/")
           (_mapped (remote-url-for-client url :workspace workspace))
           (resource (car (remote-workspace-resources workspace)))
           (old (remote-workspace-resource-value resource))
           (channel (remote-channel-of (cdar (remote-channel-group-channels old))))
           (original (symbol-function 'remote-workspace-recover-resource)) (recoveries 0))
      (delete-process (remote-forward-handle (remote-channel-handle channel)))
      ;; Dispatch the same observation twice before the queued job can run.
      (remote-channel--report-transport-failure channel)
      (should (remote-workspace-resource-recovering-p workspace resource))
      (should-error (remote-url-for-client url :workspace workspace) :type 'remote-connection-busy)
      (cl-letf (((symbol-function 'remote-workspace-recover-resource)
                 (lambda (&rest args) (cl-incf recoveries) (apply original args))))
        (remote-url-test--await
         (lambda () (not (remote-workspace-resource-recovering-p workspace resource)))))
      (should (= recoveries 1))
      (should (remote-channel-group-live-p (remote-workspace-resource-value resource))))))

(ert-deftest remote-url-closing-owner-cancels-queued-local-recovery ()
  (remote-url-test-with-target
    (let* ((remote-workspace-auto-reconnect t)
           (workspace (remote-workspace-open "/fs:url-test:/tmp/closing-recovery/" :connect nil))
           (_mapped (remote-url-for-client "http://localhost:3100/" :workspace workspace))
           (resource (car (remote-workspace-resources workspace)))
           (old (remote-workspace-resource-value resource)))
      (delete-process (remote-forward-handle (cdar (remote-channel-group-channels old))))
      (should (remote-workspace-resource-recovering-p workspace resource))
      (remote-workspace-close workspace)
      (should-not (remote-workspace-resource-recovering-p workspace resource))
      (accept-process-output nil 0.01)
      (should-not (remote-channel-list))
      (should (zerop (hash-table-count remote-channel-groups))))))

(ert-deftest remote-url-late-recovery-cannot-resurrect-closed-owner ()
  (remote-url-test-with-target
    (let* ((workspace (remote-workspace-open "/fs:url-test:/tmp/late/" :connect nil))
           (_mapped (remote-url-for-client "http://localhost:3100/" :workspace workspace))
           (resource (car (remote-workspace-resources workspace)))
           (recover (remote-workspace-resource-recovery-function resource))
           replacement)
      (setf (remote-workspace-resource-recovery-function resource)
            (lambda (entry owner)
              (setq replacement (funcall recover entry owner))
              (remote-workspace-close owner)
              replacement))
      (should-not (remote-workspace-recover-resource workspace resource))
      (should-not (remote-channel-group-live-p replacement))
      (should-not (remote-channel-list))
      (should (zerop (hash-table-count remote-channel-groups))))))

(ert-deftest remote-url-recovery-observer-error-releases-new-group ()
  (remote-url-test-with-target
    (let* ((workspace (remote-workspace-open "/fs:url-test:/tmp/observer/" :connect nil))
           (group (remote-channel-group-open '((http . (:host "127.0.0.1" :port 3100)))
                                              :context (remote-workspace-context workspace) :workspace workspace
                                              :metadata (list :on-recovered (lambda (&rest _) (error "Observer failed")))))
           (resource (car (remote-workspace-resources workspace))))
      (should (remote-channel-group-live-p group))
      (should-not (remote-workspace-recover-resource workspace resource))
      (should (eq (remote-workspace-resource-state resource) 'failed))
      (should-not (remote-channel-list))
      (should (zerop (hash-table-count remote-channel-groups))))))

(ert-deftest remote-url-real-transport-error-during-local-rebuild-escalates ()
  (remote-url-test-with-target
    (let* ((remote-workspace-auto-reconnect t)
           (workspace (remote-workspace-open "/fs:url-test:/tmp/escalate/" :connect nil))
           (_mapped (remote-url-for-client "http://localhost:3100/" :workspace workspace))
           (resource (car (remote-workspace-resources workspace)))
           (group (remote-workspace-resource-value resource))
           (channel (remote-channel-of (cdar (remote-channel-group-channels group))))
           reported)
      (setf (remote-workspace-resource-recovery-function resource)
            (lambda (&rest _) (signal 'remote-transport-error '("Fixture transport unavailable"))))
      (cl-letf (((symbol-function 'remote-report-route-failure)
                 (lambda (route error) (setq reported (list route error)) 'transport)))
        (delete-process (remote-forward-handle (remote-channel-handle channel)))
        (remote-url-test--await (lambda () reported))
        (should (eq (car reported) (remote-channel-route channel)))
        (should (eq (car (cadr reported)) 'remote-transport-error))
        (should (eq (remote-workspace-resource-state resource) 'failed))
        (remote-workspace-close workspace)
        (should-not (remote-workspace-resource-recovering-p workspace resource))))))

(ert-deftest remote-url-late-recovery-preserves-an-already-adopted-replacement ()
  (remote-url-test-with-target
    (let* ((workspace (remote-workspace-open "/fs:url-test:/tmp/replaced/" :connect nil))
           (_mapped (remote-url-for-client "http://localhost:3100/" :workspace workspace))
           (resource (car (remote-workspace-resources workspace)))
           (recover (remote-workspace-resource-recovery-function resource))
           late winner)
      (setf (remote-workspace-resource-recovery-function resource)
            (lambda (entry owner)
              (setq late (funcall recover entry owner)
                    winner (remote-channel-group-open '((http . (:host "127.0.0.1" :port 3101)))
                                                       :context (remote-workspace-context owner)
                                                       :workspace owner :register nil))
              (setf (remote-workspace-resource-value entry) winner
                    (remote-workspace-resource-state entry) 'open)
              late))
      (should-not (remote-workspace-recover-resource workspace resource))
      (should (eq (remote-workspace-resource-value resource) winner))
      (should (eq (remote-workspace-resource-state resource) 'open))
      (should (remote-channel-group-live-p winner))
      (should-not (remote-channel-group-live-p late))
      (should (= 1 (hash-table-count remote-channel-groups)))
      (should (= 1 (length (remote-channel-list)))))))

(ert-deftest remote-url-recovery-observer-quit-releases-new-group-and-propagates ()
  (remote-url-test-with-target
    (let* ((workspace (remote-workspace-open "/fs:url-test:/tmp/quit/" :connect nil))
           (_group (remote-channel-group-open '((http . (:host "127.0.0.1" :port 3100)))
                                               :context (remote-workspace-context workspace) :workspace workspace
                                               :metadata (list :on-recovered (lambda (&rest _) (signal 'quit nil)))))
           (resource (car (remote-workspace-resources workspace)))
           quit)
      (condition-case nil
          (remote-workspace-recover-resource workspace resource)
        (quit (setq quit t)))
      (should quit)
      (should (eq (remote-workspace-resource-state resource) 'failed))
      (should-not (remote-channel-list))
      (should (zerop (hash-table-count remote-channel-groups))))))

(provide 'remote-url-tests)
