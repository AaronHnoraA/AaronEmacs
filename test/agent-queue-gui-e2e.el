;;; agent-queue-gui-e2e.el --- Queue panel and attention in a real GUI -*- lexical-binding: t; -*-
(require 'agent-flow-e2e)
(require 'aaron-ui-float)
(require 'tools/agent/queue)

(defun agent-queue-gui-e2e--key (key)
  "Run KEY through the effective keymaps of the selected window."
  (unless (commandp (key-binding (kbd key))) (error "Unbound GUI key: %s" key))
  (execute-kbd-macro (kbd key)))

(defun agent-queue-gui-e2e--panel ()
  (aaron-ui-float-panel-for-buffer (get-buffer +agent-queue-buffer-name)))

(defun agent-queue-gui-e2e--enter-panel ()
  (select-window (aaron-ui-float-content-window (agent-queue-gui-e2e--panel)))
  (etaf-runtime-flush (etaf-runtime-for-buffer (current-buffer)))
  (buffer-substring-no-properties (point-min) (point-max)))

(defun agent-queue-gui-e2e-run ()
  "Return a bounded report from a GUI frame and a real ACP client."
  (unless (display-graphic-p) (error "This probe requires a GUI frame"))
  (let* ((directory (file-name-as-directory (make-temp-file "agent-queue-gui-" t)))
         (store (expand-file-name "sessions.json" directory))
         (agent-shell-busy-submit-default-function #'agent-shell-busy-submit-queue)
         (agent-shell-confirm-interrupt nil)
         (+agent-acp-notify-function nil)
         (source (get-buffer-create "Queue GUI source"))
         agent waiting result)
    (unwind-protect
        (progn
          (set-frame-size nil 150 48)
          (delete-other-windows)
          (switch-to-buffer source)
          (setq default-directory directory)
          (setq agent (+agent-acp-start :config (agent-flow-e2e--config store)
                                        :directory directory :origin 'manual))
          (agent-flow-e2e--wait (lambda () (+agent-acp-state-value agent '(:init-finished))))
          (+agent-acp-mark-session-buffer agent "Queue task" "fixture" directory)
          (agent-flow-e2e--send agent "hold")
          (agent-flow-e2e--wait (lambda () (+agent-acp-busy-p agent)))
          (dolist (text '("alpha prompt" "beta prompt" "gamma prompt"))
            (agent-flow-e2e--send agent text))
          (+agent-acp-stop agent)
          (agent-flow-e2e--idle agent)
          (should (= 3 (+agent-acp-held-prompt-count agent)))
          (let ((origin (selected-window)))
            ;; Open it from the editor through the real prefix.
            (agent-queue-gui-e2e--key "C-c A q")
            (should (aaron-ui-float-visible-p (agent-queue-gui-e2e--panel)))
            (let ((text (agent-queue-gui-e2e--enter-panel)))
              (should (frame-parent (selected-frame)))
              (should (string-match-p "alpha prompt" text))
              (should (string-match-p "gamma prompt" text))
              (should (string-match-p "held" text)))
            (agent-queue-gui-e2e--key "j")
            (should (= +agent-queue--selected 1))
            (agent-queue-gui-e2e--key "K")
            (should (equal (+agent-queue-items agent) '("beta prompt" "alpha prompt" "gamma prompt")))
            (should (= +agent-queue--selected 0))
            (agent-queue-gui-e2e--key "d")
            (should (equal (+agent-queue-items agent) '("alpha prompt" "gamma prompt")))
            (agent-queue-gui-e2e--key "q")
            (should-not (aaron-ui-float-visible-p (agent-queue-gui-e2e--panel)))
            (should (eq (selected-window) origin))
            (should (= 2 (+agent-acp-pending-prompt-count agent)))
            ;; From the manager, whose status line reports the same queue.
            (agent-queue-gui-e2e--key "C-c A S")
            (let ((panel (aaron-ui-float-panel-for-buffer (get-buffer +agent-manager-buffer-name))))
              (select-window (aaron-ui-float-content-window panel))
              (etaf-runtime-flush (etaf-runtime-for-buffer (current-buffer)))
              (let ((text (buffer-substring-no-properties (point-min) (point-max))))
                (should (string-match-p "2 queued (2 held)" text))
                ;; The provider's title says what the session is about.
                (should (string-match-p "fixture-1" text)))
              (agent-queue-gui-e2e--key "Q")
              (should-not (aaron-ui-float-visible-p panel)))
            (agent-queue-gui-e2e--enter-panel)
            ;; Resume sends the queue once, through the native submission.
            (agent-queue-gui-e2e--key "r")
            (agent-flow-e2e--idle agent)
            (should (zerop (+agent-acp-pending-prompt-count agent)))
            (when (aaron-ui-float-visible-p (agent-queue-gui-e2e--panel))
              (agent-queue-gui-e2e--enter-panel)
              (agent-queue-gui-e2e--key "q"))
            (select-window origin)
            (should (string-match-p "alpha prompt" (agent-flow-e2e--text agent)))
            ;; A waiting session is one key away and lands on its control.
            (setq waiting (+agent-acp-start :config (agent-flow-e2e--config store)
                                            :directory directory :origin 'manual))
            (agent-flow-e2e--wait (lambda () (+agent-acp-state-value waiting '(:init-finished))))
            (+agent-acp-mark-session-buffer waiting "Needs approval" "fixture" directory)
            (agent-flow-e2e--send waiting "permission")
            (agent-flow-e2e--wait
             (lambda () (eq (plist-get (+agent-session-snapshot waiting) :attention-kind) 'permission)))
            (select-window origin)
            (switch-to-buffer source)
            (should (eq (plist-get (car (+agent-session-attention-queue (+agent-pool-sessions)))
                                   :buffer)
                        waiting))
            (agent-queue-gui-e2e--key "C-c A j")
            (should (eq (current-buffer) waiting))
            (should (get-text-property (point) 'agent-shell-permission-button))
            (setq result (list :passed t :native-child-frame t :open-from-prefix t
                               :edit-keys t :return-origin t :manager-reports-queue t
                               :manager-entry t :resume-sends-once t :attention-lands-on-control t))))
      (when-let* ((buffer (get-buffer +agent-manager-buffer-name))) (kill-buffer buffer))
      (when-let* ((buffer (get-buffer +agent-queue-buffer-name))) (kill-buffer buffer))
      (dolist (buffer (list agent waiting))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            (let ((kill-buffer-query-functions nil)) (kill-buffer buffer)))))
      (kill-buffer source)
      (delete-directory directory t))
    result))

(provide 'agent-queue-gui-e2e)
;;; agent-queue-gui-e2e.el ends here
