;;; pi-owned-tests.el --- Emacs-owned Pi profile and private files -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'noema-pi-router)

(ert-deftest pi-owned-c18-deploy-migrates-private-files-and-keeps-one-history ()
  (let* ((temporary (make-temp-file "pi-owned-test-" t))
         (noema-pi-agent-directory (expand-file-name "var/" temporary))
         (noema-pi-config-directory (expand-file-name "etc/" temporary))
         (noema-pi-companion-directory (expand-file-name "companion/" temporary))
         (noema-pi-credentials-file nil) (noema-pi-codex-auth-file (expand-file-name "missing" temporary))
         (noema-pi-model "openai-codex/gpt-5.6-luna"))
    (unwind-protect
        (progn
          (make-directory noema-pi-agent-directory t)
          (dolist (entry '(("settings.json" . "{\"theme\":\"dark\"}\n")
                           ("auth.json" . "{\"fixture\":{\"type\":\"api_key\",\"key\":\"fixture-only\"}}\n")
                           ("sessions.json" . "retained owned identity\n")))
            (write-region (cdr entry) nil (expand-file-name (car entry) noema-pi-agent-directory) nil 'silent))
          (noema-pi-deploy)
          (dolist (name '("auth.json" "models.json" "settings.json"))
            (let ((file (expand-file-name name noema-pi-config-directory))
                  (entry (expand-file-name name noema-pi-agent-directory)))
              (should (file-symlink-p entry))
              (should (equal (file-truename entry) (file-truename file)))
              (should (= (file-modes file) #o600))))
          (should (equal (noema-pi-router--read-file (expand-file-name "sessions.json" noema-pi-agent-directory))
                         "retained owned identity\n"))
          (let* ((file (expand-file-name "settings.json" noema-pi-config-directory))
                 (before (file-attributes file))
                 (settings (noema-pi-router--parse-json (noema-pi-router--read-file file))))
            (should (equal (gethash "theme" settings) "dark"))
            (should (equal (gethash "defaultProvider" settings) "openai-codex"))
            (should (equal (gethash "defaultModel" settings) "gpt-5.6-luna"))
            (noema-pi-deploy)
            (should (equal (file-attribute-modification-time before)
                           (file-attribute-modification-time (file-attributes file)))))
          (should (file-symlink-p (expand-file-name "SYSTEM.md" noema-pi-agent-directory)))
          (should (file-symlink-p (expand-file-name "extensions/noema-manager/index.ts" noema-pi-agent-directory)))
          (should-not (file-exists-p (expand-file-name "skills" noema-pi-agent-directory))))
      (delete-directory temporary t))))

(ert-deftest pi-owned-c18-private-command-survives-upstream-setting-changes ()
  (require 'agent-shell-pi)
  (let* ((command '("/fixture/node" "/emacs/var/agent/pi/runtime/pi-acp.js"))
         (config (+agent-acp-pi-config '("PI_CODING_AGENT_DIR=/emacs/var/pi") command))
         (agent-shell-pi-acp-command '("system-pi")) captured environment)
    (cl-letf (((symbol-function 'agent-shell-pi-make-client)
               (lambda (&rest _) (setq captured agent-shell-pi-acp-command
                                      environment agent-shell-pi-environment))))
      (funcall (alist-get :client-maker config) (current-buffer)))
    (should (equal captured command))
    (should (member "PI_CODING_AGENT_DIR=/emacs/var/pi" environment))))

(ert-deftest pi-owned-c18-config-board-writes-pi-options-to-private-store ()
  (dolist (name '(noema-pi-model noema-pi-model-pool noema-pi-auto-start))
    (should (equal (expand-file-name (plist-get (gethash name config--registry) :store-file) user-emacs-directory)
                   (expand-file-name "etc/noema/pi/config.el" user-emacs-directory))))
  (let ((noema-pi-auto-start nil) (noema-pi-assistant-mode t)
        (noema-pi-router--startup-timer nil)
        (emacs-startup-hook emacs-startup-hook) (+project-activated-hook +project-activated-hook))
    (noema-pi-router--schedule-startup)
    (let ((timer noema-pi-router--startup-timer))
      (config--run-on-change (gethash 'noema-pi-auto-start config--registry)
                             'noema-pi-auto-start nil)
      (should-not noema-pi-assistant-mode)
      (should-not (memq timer timer-idle-list)))))

(ert-deftest pi-owned-c18-node-trust-uses-the-host-bundle-and-preserves-explicit-config ()
  (let ((process-environment (seq-remove (lambda (entry) (string-prefix-p "NODE_EXTRA_CA_CERTS=" entry)) process-environment)))
    (cl-letf (((symbol-function 'file-readable-p) (lambda (_) t)))
      (should (equal (+agent-acp--pi-node-environment '("PI_CODING_AGENT_DIR=/owned"))
                     '("NODE_EXTRA_CA_CERTS=/etc/ssl/cert.pem" "PI_CODING_AGENT_DIR=/owned")))
      (should (equal (+agent-acp--pi-node-environment '("NODE_EXTRA_CA_CERTS=/explicit"))
                     '("NODE_EXTRA_CA_CERTS=/explicit")))
      (let ((process-environment (cons "NODE_EXTRA_CA_CERTS=/inherited" process-environment)))
        (should (equal (+agent-acp--pi-node-environment '("PI_CODING_AGENT_DIR=/owned"))
                       '("PI_CODING_AGENT_DIR=/owned")))))))

(provide 'pi-owned-tests)
