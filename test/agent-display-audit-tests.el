      (cl-letf (((symbol-function 'completing-read) (lambda (&rest _) (signal 'quit nil)))
                ((symbol-function '+agent-acp-start) (lambda (&rest _) (ert-fail "Implicit agent startup"))))
        (condition-case nil (+agent/pool) (quit (setq cancelled t))))
