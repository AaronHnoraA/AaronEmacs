           (b (agent-display-audit--agent "local-b" root 'popup))
           (foreign (agent-display-audit--agent "other-project" "/tmp/another-agent-project/"))
           (remote (agent-display-audit--agent "other-target" root))
           (private (agent-display-audit--agent "private" root))
           (+agent-session-private-functions
            (list (lambda (session) (eq private (plist-get session :buffer))))))
      (with-current-buffer remote (setq default-directory "/fs:audit-target:/work/"))
      (cl-letf (((symbol-function 'completing-read)
                 (lambda (_prompt choices &rest _)
                   (should (rassq a choices))
                   (should (rassq b choices))
                   (should-not (rassq foreign choices))
                   (should-not (rassq remote choices))
                   (should-not (rassq private choices))
                   (car (rassq b choices))))
                ((symbol-function '+agent-acp-start)
                 (lambda (&rest _) (ert-fail "Selecting a session started an agent"))))
        (+agent/pool-switch))
      (should (eq (current-buffer) b))
      (should (eq (window-buffer origin) source))
      (+agent-acp-hide b)
      (should (eq (selected-window) origin)))))

