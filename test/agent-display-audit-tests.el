(ert-deftest c32-popup-hide-returns-to-the-exact-source-window ()
  (agent-display-audit--layout
    (let ((other (split-window-right)))
      ;; Both editors show the same buffer: a buffer-only origin is ambiguous.
      (set-window-buffer other source)
      (let ((popup (generate-new-buffer "c32-popup")))
        (+portal-popup-display-buffer popup)
        (let ((window (selected-window)))
          (select-window other)
          (+portal-popup--auto-hide)
          (should (eq (selected-window) other))
          (should-not (window-live-p window)))
        (select-window origin)
        (+portal-popup-display-buffer popup)
        (+windows/close-view)
        (should (eq (selected-window) origin))
        (should (buffer-live-p popup))))))

(ert-deftest agent-close-c28-native-and-menu-kills-share-confirmation-and-cleanup ()
  (dolist (entry '(native menu ibuffer))
    (dolist (accept '(nil t))
      (agent-display-audit--layout
        (let* ((agent (agent-display-audit--agent "guarded" root))
               (process (map-nested-elt (buffer-local-value 'agent-shell--state agent)
                                        '(:client :process)))
               (closed 0) (questions 0)
               (+agent-session-close-functions
                (list (lambda (buffer) (when (eq buffer agent) (cl-incf closed))))))
          (+agent-acp-show-buffer agent)
          (cl-letf (((symbol-function '+agent-acp-busy-p)
                     (lambda (buffer) (eq buffer agent)))
                    ((symbol-function 'yes-or-no-p)
                     (lambda (_) (cl-incf questions) accept))
                    ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
            (pcase entry
              ('native (kill-buffer agent))
              ('menu (+agent-acp-close agent))
              ('ibuffer
               (ibuffer nil "*c28-Ibuffer*")
               (with-current-buffer "*c28-Ibuffer*"
                 (ibuffer-update nil t)
                 (goto-char (point-min))
                 (while (and (not (eobp)) (not (eq (ibuffer-current-buffer) agent)))
                   (forward-line 1))
                 (should (eq (ibuffer-current-buffer) agent))
                 (ibuffer-set-mark ibuffer-deletion-char)
                 (ibuffer-do-kill-on-deletion-marks)))))
          (should (= questions 1))
          (should (= closed (if accept 1 0)))
          (should (eq (buffer-live-p agent) (not accept)))
          (should (eq (and (process-live-p process) t) (not accept))))))))

(ert-deftest agent-entry-c29-existing-keys-share-the-native-terminal-bindings ()
