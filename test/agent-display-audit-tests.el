    (dolist (state '(normal insert emacs))
      (evil-change-state state)
      (should (eq (key-binding (kbd "C-c a")) #'+agent/pool))))
  (dolist (map (list (car portal-terminal--native-maps) (cdr portal-terminal--native-maps)))
    (should (eq (lookup-key map (kbd "C-c a")) #'+agent/pool))
    (should (eq (lookup-key map (kbd "C-c A n")) #'+agent-menu-new))))

(ert-deftest agent-entry-c29-native-terminal-recalls-agent-and-returns-with-shell-alive ()
  (skip-unless (and (display-graphic-p)
                    (equal (getenv "WINDOW_COHERENCE_NATIVE_TEST") "1")
                    (fboundp 'portal-test-native-key)))
  (agent-display-audit--layout
    (let* ((agent (agent-display-audit--agent "native-entry" root))
           (portal-terminal-confirm-kill nil)
           (terminal (+portal-create :directory root :display nil
                                     :command '("/bin/sh" "-c" "sleep 30"))))
      (unwind-protect
          (progn
            (+portal-move-buffer-to-window terminal origin)
            (select-frame-set-input-focus (selected-frame))
            (should (portal-view--with-frame-title
                     (selected-frame) #'portal-test-native-target-frame))
            (portal-test-native-focus-target)
            (redisplay t)
            (let ((deadline (+ (float-time) 3)))
              (while (and (< (float-time) deadline)
                          (not (portal-input--action "focused" (portal-view-target))))
                (+portal--focus-selected-window (selected-frame) t)
                (accept-process-output nil 0.02)))
            (should (portal-input--action "focused" (portal-view-target)))
            (portal-test-native-key 8 (ash 1 18) "\C-c")
            (portal-test-native-key 0 0 "a")
            (let ((event (aref (with-timeout (5 (ert-fail "No native handoff"))
                                (read-key-sequence-vector nil)) 0)))
              (should (eq (car-safe event) 'portal-input-binding))
              (with-timeout (5 (ert-fail "Agent entry stalled"))
                (portal-input--dispatch event)))
            (should (eq (current-buffer) agent))
            (should (eq (window-buffer origin) terminal))
            (+agent-acp-hide)
            (should (eq (selected-window) origin))
            (should (eq (current-buffer) terminal))
            (should-not (plist-get (portal-terminal-metadata terminal) :exited)))
        (setq unread-command-events nil)
        (when (buffer-live-p terminal) (kill-buffer terminal))))))

