;;; agent-display-audit-tests.el --- Project pools and display ownership -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'tools/agent/manager)
(require 'term/portal/popup)

(defun agent-display-audit--agent (name root &optional origin)
  (let* ((buffer (generate-new-buffer (format "*Agent display audit %s*" name)))
         (process (make-pipe-process :name (buffer-name buffer) :noquery t)))
    (with-current-buffer buffer
      (setq major-mode 'agent-shell-mode)
      (setq-local default-directory root +agent-acp-session-root root
                  +agent-acp-session-name name +agent-acp-session-agent "codex"
                  +agent-acp-session-origin (or origin 'manual)
                  agent-shell--state (agent-shell--make-state :buffer buffer :agent-config '((:identifier . codex))))
      (setf (map-elt agent-shell--state :client) (list (cons :process process))
            (map-elt agent-shell--state :init-finished) t
            (map-elt (map-elt agent-shell--state :session) :id) name)
      (add-hook 'kill-buffer-hook (lambda () (when (process-live-p process) (delete-process process))) nil t))
    buffer))

(defmacro agent-display-audit--layout (&rest body)
  (declare (indent 0))
  `(let* ((root (file-name-as-directory (make-temp-file "agent-display-audit-" t)))
          (source (generate-new-buffer "agent audit editor"))
          (document (generate-new-buffer "agent audit second editor"))
          (+portal-popup-buffers nil) (+portal-popup-current-buffer nil)
          (+portal-popup-origin-buffer nil)
          (before (buffer-list)))
     (save-window-excursion
       (unwind-protect
           (progn
             (dolist (window (cdr (window-list nil 'nomini))) (ignore-errors (delete-window window)))
             (switch-to-buffer source)
             (setq default-directory root)
             (let ((origin (selected-window))) ,@body))
         (dolist (buffer (buffer-list))
           (when (or (eq buffer source) (eq buffer document) (not (memq buffer before)))
             (with-current-buffer buffer
               (let ((kill-buffer-query-functions nil)) (kill-buffer buffer)))))
         (delete-directory root t)))))

(ert-deftest agent-display-c23-project-pool-includes-popup-and-embedded-members ()
  (agent-display-audit--layout
    (let ((a (agent-display-audit--agent "ordinary" root))
          (b (agent-display-audit--agent "popup" root 'popup))
          (c (agent-display-audit--agent "embedded" root)))
      (with-current-buffer b (setq +agent-acp-display-buffer-function #'+portal-popup-display-buffer))
      (with-current-buffer c (setq +agent-acp-display-buffer-function #'ignore))
      (let ((members (+agent-acp--project-buffers root)))
        (should (memq a members)) (should (memq b members)) (should (memq c members))))))

