;;; agent-manager-gui-e2e.el --- Real child frame navigation -*- lexical-binding: t; -*-
(require 'agent-flow-e2e)
(require 'aaron-ui-float)
(require 'noema-agent-acp)

(defun agent-manager-gui-e2e--key (key)
  "Exercise the effective keymap, including ETAF's native key precedence."
  (let ((command (key-binding (kbd key))))
    (unless (commandp command) (error "Unbound GUI key: %s" key))
    (execute-kbd-macro (kbd key))))

(defun agent-manager-gui-e2e-run ()
  "Return a bounded report from an isolated GUI frame and real ACP clients."
  (unless (display-graphic-p) (error "This probe requires a GUI frame"))
  (let* ((directory (file-name-as-directory (make-temp-file "agent-manager-gui-" t)))
         (store (expand-file-name "sessions.json" directory))
         (agent-shell-elicitation--experimental-feature-enabled t)
         (+agent-acp-notify-function nil)
         (source (get-buffer-create "Agent GUI source"))
         (other (get-buffer-create "Agent GUI second editor"))
         agents panel result)
    (unwind-protect
        (progn
          (set-frame-size nil 150 48)
          (delete-other-windows)
          (switch-to-buffer source)
          (setq default-directory directory)
          (set-window-buffer (split-window-right) other)
          (let ((origin (selected-window)) (initial-count (length (window-list nil 'nomini))))
            (dotimes (index 2)
              (let ((buffer (+agent-acp-start :config (agent-flow-e2e--config store)
                                              :directory directory :origin 'manual)))
                (agent-flow-e2e--wait (lambda () (+agent-acp-state-value buffer '(:init-finished))))
                (+agent-acp-mark-session-buffer buffer (if (zerop index) "Research review" "Editor task") "fixture" directory)
                (when (zerop index)
                  (with-current-buffer buffer (setq-local noema-agent-promote--session-id "research-fixture")))
                (push buffer agents)))
            (let ((research (car (last agents))))
              (agent-flow-e2e--send research "permission")
              (agent-flow-e2e--wait (lambda () (eq (plist-get (+agent-session-snapshot research) :attention-kind) 'permission)))
              (with-current-buffer research (setq +agent-acp-attention 'permission))
              (select-window origin)
              (switch-to-buffer source)
              (agent-manager-gui-e2e--key "C-c A S")
              (setq panel (aaron-ui-float-panel-for-buffer (get-buffer +agent-manager-buffer-name)))
              (should (aaron-ui-float-visible-p panel))
              (should (= 2 (length (window-list nil 'nomini))))
              (let ((navigation (aaron-ui-float-content-window panel)))
                (progn
                  (select-window navigation)
                  (should (equal (buffer-name) +agent-manager-buffer-name))
                  (should (string-match-p "Noema Research" (buffer-substring-no-properties (point-min) (point-max))))
                  (should (string-match-p "Interactive" (buffer-substring-no-properties (point-min) (point-max))))
                  (let ((before +agent-manager--selected))
                    (agent-manager-gui-e2e--key "j")
                    (should-not (eq before +agent-manager--selected))
                    (should (get-buffer-window +agent-manager--selected (selected-frame)))
                    (agent-manager-gui-e2e--key "k")
                    (should (eq before +agent-manager--selected)))
                  (let* ((runtime (etaf-runtime-for-buffer (current-buffer)))
                         (last-input-event (list 'mouse-1 (posn-at-point))))
                    (etaf-dispatch-event runtime (+agent-manager--ref research) 'press)
                    (should (eq +agent-manager--selected research))
                    (should (aaron-ui-float-visible-p panel)))
                  (should (eq (buffer-local-value '+agent-acp-attention research) 'permission))
                  (let ((runtime (etaf-runtime-for-buffer (current-buffer)))
                        (unread-command-events (append (string-to-list "Research") (list ?\r))))
                    (etaf-dispatch-event runtime 'agent-manager-filter 'press))
                  (should (equal +agent-manager--query "Research"))
                  (should (= 1 (length (plist-get (etaf-value +agent-manager--model) :sessions))))
                  (+agent-manager-search "")
                  (agent-manager-gui-e2e--key ".")
                  (should (eq (transient-scope '+agent-session-menu) +agent-manager--selected))
                  (agent-manager-gui-e2e--key "C-g")
                  (agent-manager-gui-e2e--key "q"))
                (should-not (aaron-ui-float-visible-p panel))
                (should-not (get-buffer-window research t))
                (should (= initial-count (length (window-list nil 'nomini))))
                (should (eq (selected-window) origin))
                ;; Every daily route targets the same retained view.
                (dolist (entry '(("C-c A G" attention) ("C-c A U" usage) ("C-c A S" sessions)))
                  (agent-manager-gui-e2e--key (car entry))
                  (progn
                    (select-window (aaron-ui-float-content-window panel))
                    (should (eq +agent-manager--view (cadr entry)))
                    (when (eq (cadr entry) 'usage)
                      (etaf-runtime-flush (etaf-runtime-for-buffer (current-buffer)))
                      (should (string-match-p "Input tokens" (buffer-string)))
                      (should (string-match-p "Reported cost" (buffer-string)))
                      (should-not (get-buffer-window +agent-manager--selected (selected-frame))))
                    (agent-manager-gui-e2e--key "q")))
                ;; Native input invoked inside a preview leaves the child
                ;; frame through the same display owner as an explicit open.
                (agent-manager-gui-e2e--key "C-c A S")
                (select-window (aaron-ui-float-content-window panel))
                (+agent-manager-select research)
                (select-window (get-buffer-window research (selected-frame)))
                (agent-manager-gui-e2e--key "C-c C-e")
                (should-not (frame-parent (selected-frame)))
                (should-not (aaron-ui-float-visible-p panel))
                (should (eq (window-buffer (selected-window)) research))
                (+agent-acp-hide research)
                (agent-manager-gui-e2e--key "C-c A S")
                (progn
                    (select-window (aaron-ui-float-content-window panel))
                  (+agent-manager-select research)
                  (etaf-runtime-flush (etaf-runtime-for-buffer (current-buffer)))
                  (etaf-focus (etaf-runtime-for-buffer (current-buffer)) (+agent-manager--ref research))
                  (let ((runtime (etaf-runtime-for-buffer (current-buffer))))
                    (unless (eq (etaf-focused-host-ref runtime) (+agent-manager--ref research))
                      (error "Focus changed before RET: selected=%s research-selected=%s"
                             (buffer-name +agent-manager--selected) (eq research +agent-manager--selected)))
                    (unless (eq research +agent-manager--selected)
                      (error "Wrong entity before RET: %s" (buffer-name +agent-manager--selected))))
                  (agent-manager-gui-e2e--key "RET"))
                (should-not (aaron-ui-float-visible-p panel))
                (should (eq (window-buffer (selected-window)) research))
                (should (= 1 (length (get-buffer-window-list research nil (selected-frame)))))
                (should-not (buffer-local-value '+agent-acp-attention research))
                (goto-char (point-min))
                (should (eq (key-binding (kbd "?")) #'+agent-acp-help-or-insert))
                (agent-manager-gui-e2e--key "?")
                (should (eq (transient-scope '+agent-session-menu) research))
                (agent-manager-gui-e2e--key "C-g")
                (should (eq (plist-get (+agent-session-snapshot research) :attention-kind) 'permission))
                (+agent-acp-hide research)
                (should (eq (selected-window) origin))
                (agent-manager-gui-e2e--key "H-A")
                (aaron-ui-float-close panel)
                (should-not (aaron-ui-float-live-p panel))
                (should-not (get-buffer +agent-manager-buffer-name))
                (should-not (memq #'+agent-manager--changed-h +agent-acp-changed-functions))
                (dolist (buffer agents) (should (+agent-session-live-p buffer)))
                (setq result (list :passed t :real-clients (length agents)
                                   :native-child-frame t :routes '(sessions attention usage)
                                   :source-groups '(interactive noema) :keys t :preview-unread t
                                   :return-origin t :input-from-preview t :pointer-preview t :native-filter t :chat-menu t :close-keeps-execution t))))))
      (when-let* ((buffer (get-buffer +agent-manager-buffer-name))) (kill-buffer buffer))
      (dolist (buffer agents)
        (when (buffer-live-p buffer)
          (with-current-buffer buffer
            (let ((kill-buffer-query-functions nil)) (kill-buffer buffer)))))
      (kill-buffer source) (kill-buffer other)
      (delete-directory directory t))
    result))
