;;; pi-butler-e2e.el --- Real ACP butler dispatch without model calls -*- lexical-binding: t; -*-
(require 'tools/agent/api)
(require 'noema-pi-router)
(require 'tools/agent/queue)
(load (expand-file-name "test/agent-flow-e2e.el" user-emacs-directory) nil t)

(ert-deftest pi-butler-e2e-c11-native-queue-results-draft-and-stop ()
  (save-window-excursion
    (let* ((directory (file-name-as-directory (make-temp-file "pi-butler-e2e-" t)))
           (store (expand-file-name "sessions.json" directory))
           (config (agent-flow-e2e--config store))
           (source (window-buffer (selected-window)))
           (+agent-acp-notify-function nil)
           buffer identity)
      (unwind-protect
          (progn
            (cl-letf (((symbol-function '+agent-acp-config-for) (lambda (_) config)))
              (let ((result (+agent/api `((action . "create") (root . ,directory) (agent . "flow-fixture")))))
                (setq buffer (get-buffer (alist-get 'buffer (alist-get 'session result))))))
            (agent-flow-e2e--wait (lambda () (+agent-acp-state-value buffer '(:init-finished))))
            (setq identity `((buffer . ,(buffer-name buffer))
                             (nativeSessionId . ,(+agent-acp-state-value buffer '(:session :id)))))
            (should (eq (window-buffer (selected-window)) source))
            (with-current-buffer buffer (goto-char (point-max)) (insert "PRIVATE EDITABLE DRAFT"))
            (+agent/api (append '((action . "send") (prompt . "permission")) identity))
            (agent-flow-e2e--wait
             (lambda () (eq (plist-get (+agent-session-snapshot buffer) :attention-kind) 'permission)))
            (+agent/api (append '((action . "send") (prompt . "after permission")) identity))
            (should (= (+agent-acp-pending-prompt-count buffer) 1))
            (+agent-render-flush buffer)
            (agent-flow-e2e--control buffer 'agent-shell-permission-button #'identity)
            (agent-flow-e2e--wait
             (lambda () (and (not (+agent-acp-busy-p buffer))
                             (zerop (+agent-acp-pending-prompt-count buffer)))))
            (let ((output (alist-get 'text (+agent/api (append '((action . "read")) identity)))))
              (should (string-match-p "APPROVAL_OK" output))
              (should (string-match-p "Reply: after permission" output))
              (should-not (string-match-p "PRIVATE EDITABLE DRAFT" output)))
            (should (equal (with-current-buffer buffer
                             (buffer-substring-no-properties (+agent-acp--input-start buffer) (point-max)))
                           "PRIVATE EDITABLE DRAFT"))
            (should (eq (window-buffer (selected-window)) source))
            (+agent/api (append '((action . "send") (prompt . "hold")) identity))
            (agent-flow-e2e--wait (lambda () (+agent-acp-busy-p buffer)))
            (+agent/api (append '((action . "send") (prompt . "must remain held")) identity))
            (+agent/api (append '((action . "stop")) identity))
            (agent-flow-e2e--idle buffer)
            (should (= (+agent-acp-held-prompt-count buffer) 1))
            (should (eq (window-buffer (selected-window)) source))
            (+agent-queue-clear buffer)
            (+agent/api (append '((action . "send") (prompt . "refuse")) identity))
            (agent-flow-e2e--idle buffer)
            (let ((status (alist-get 'session (+agent/api (append '((action . "status")) identity)))))
              (should (equal (alist-get 'stopReason status) "refusal"))
              (should (equal (alist-get 'attention status) "failed")))
            (princ "PI_BUTLER_E2E: native create/send/queued continuation/read/stop; draft and focus preserved.\n"))
        (when (buffer-live-p buffer) (+agent-acp-kill buffer))
        (delete-directory directory t)))))

(ert-deftest pi-butler-e2e-c9-c10-real-view-returns-to-source ()
  (save-window-excursion
    (let* ((directory (file-name-as-directory (make-temp-file "pi-view-e2e-" t)))
           (store (expand-file-name "sessions.json" directory))
           (source (generate-new-buffer "*Pi editor origin fixture*"))
           (buffer (+agent-acp-start :config (agent-flow-e2e--config store)
                                     :directory directory :focus nil :origin 'manual))
           (noema-pi-router--emacs-buffer buffer)
           (+agent-acp-notify-function nil))
      (unwind-protect
          (progn
            (agent-flow-e2e--wait (lambda () (+agent-acp-state-value buffer '(:init-finished))))
            (with-current-buffer source
              (setq-local buffer-file-name (expand-file-name "source.txt" directory))
              (insert "one\ntwo\nthree\n"))
            (set-window-buffer (selected-window) source)
            (set-window-point (selected-window) 6)
            (let ((editor (selected-window)))
              (cl-letf (((symbol-function '+noema--ensure-server) #'ignore)) (pi))
              (should (eq (window-buffer (selected-window)) buffer))
              (let ((context (alist-get 'context (noema-pi-api '((action . "context"))))))
                (should (equal (alist-get 'buffer context) (buffer-name source)))
                (should (= (alist-get 'line context) 2)))
              (pi)
              (should (eq (selected-window) editor))
              (should (eq (window-buffer editor) source))
              (should (= (window-point editor) 6))))
        (when (buffer-live-p buffer) (+agent-acp-kill buffer))
        (with-current-buffer source (set-buffer-modified-p nil))
        (kill-buffer source)
        (delete-directory directory t)))))

(ert-deftest pi-butler-e2e-c10-context-follows-each-frame ()
  (skip-unless (display-graphic-p))
  (let* ((directory (file-name-as-directory (make-temp-file "pi-frames-e2e-" t)))
         (buffer (+agent-acp-start :config (agent-flow-e2e--config (expand-file-name "sessions.json" directory))
                                   :directory directory :focus nil :origin 'manual))
         (noema-pi-router--emacs-buffer buffer)
         (frame-a (selected-frame)) (frame-b (make-frame)) sources)
    (unwind-protect
        (progn
          (agent-flow-e2e--wait (lambda () (+agent-acp-state-value buffer '(:init-finished))))
          (dolist (frame (list frame-a frame-b))
            (with-selected-frame frame
              (delete-other-windows)
              (let ((source (generate-new-buffer "*Pi per-frame source*")))
                (push source sources)
                (with-current-buffer source
                  (setq-local buffer-file-name (expand-file-name (format "%s.txt" (length sources)) directory))
                  (insert "one\ntwo\nthree\n"))
                (set-window-buffer (selected-window) source)
                (set-window-point (selected-window) (if (eq frame frame-a) 6 10))
                (cl-letf (((symbol-function '+noema--ensure-server) #'ignore)) (pi)))))
          (dolist (frame (list frame-a frame-b))
            (with-selected-frame frame
              (select-window (get-buffer-window buffer frame))
              (let ((context (alist-get 'context (noema-pi-api '((action . "context"))))))
                (should (equal (alist-get 'file context)
                               (expand-file-name (if (eq frame frame-a) "1.txt" "2.txt") directory)))
                (should (= (alist-get 'line context) (if (eq frame frame-a) 2 3)))))))
      (when (frame-live-p frame-b) (delete-frame frame-b t))
      (when (buffer-live-p buffer) (+agent-acp-kill buffer))
      (dolist (source sources)
        (with-current-buffer source (set-buffer-modified-p nil))
        (kill-buffer source))
      (delete-directory directory t))))

(ert-deftest pi-butler-e2e-c13-c16-history-after-api-turn-and-zero-idle-requests ()
  (save-window-excursion
    (let* ((directory (file-name-as-directory (make-temp-file "pi-idle-native-e2e-" t)))
           (noema-pi-agent-directory (expand-file-name "pi-state/" directory))
           (noema-pi-router--emacs-buffer nil)
           (noema-pi-router--buffers (make-hash-table :test #'equal))
           (store (expand-file-name "native.json" directory))
           (+agent-acp-notify-function nil)
           (buffer (+agent-acp-start :config (agent-flow-e2e--config store)
                                     :directory directory :focus nil :origin 'pi-project))
           identity)
      (unwind-protect
          (progn
            (agent-flow-e2e--wait (lambda () (+agent-acp-state-value buffer '(:init-finished))))
            ;; Simulate the SDK's real empty-session boundary, using only the
            ;; local fixture's transport when an actual turn later completes.
            (cl-letf (((symbol-function '+agent-acp-list-native-sessions)
                       (lambda (_ callback &optional _) (funcall callback nil nil))))
              (noema-pi-router--attach directory buffer))
            (should-not (noema-pi-sessions-active-native directory))
            (setq identity `((buffer . ,(buffer-name buffer))
                             (nativeSessionId . ,(+agent-acp-state-value buffer '(:session :id)))))
            (+agent/api (append '((action . "send") (prompt . "permission")) identity))
            (agent-flow-e2e--wait
             (lambda () (eq (plist-get (+agent-session-snapshot buffer) :attention-kind) 'permission)))
            (+agent/api (append '((action . "send") (prompt . "after history check")) identity))
            (+agent-render-flush buffer)
            (agent-flow-e2e--control buffer 'agent-shell-permission-button #'identity)
            (agent-flow-e2e--wait (lambda () (and (not (+agent-acp-busy-p buffer))
                                                 (zerop (+agent-acp-pending-prompt-count buffer)))))
            (agent-flow-e2e--wait
             (lambda () (equal (noema-pi-sessions-active-native directory)
                               (+agent-acp-state-value buffer '(:session :id)))))
            (+agent-render-flush buffer)
            (let ((signature (noema-pi-sessions--signature (noema-pi-sessions--file)))
                  (wire (with-temp-buffer (insert-file-contents (concat store ".events")) (buffer-string))))
              (dotimes (_ 5) (accept-process-output nil 0.2))
              (should (equal signature (noema-pi-sessions--signature (noema-pi-sessions--file))))
              (should (equal wire (with-temp-buffer (insert-file-contents (concat store ".events")) (buffer-string))))
              (should-not (buffer-local-value 'noema-pi-router--history-timer buffer))
              (should-not (buffer-local-value 'noema-pi-router--history-request buffer)))
            (let ((+noema--ready t)) (noema-pi-router--schedule-claim directory buffer))
            (should (timerp (buffer-local-value 'noema-pi-router--claim-timer buffer)))
            (+agent-acp-shutdown buffer)
            (should-not (buffer-local-value 'noema-pi-router--claim-timer buffer))
            (should-not (buffer-local-value 'noema-pi-router--subscriptions buffer))
            (should (equal (noema-pi-sessions-active-native directory) (alist-get 'nativeSessionId identity)))
            (princ "PI_IDLE_NATIVE: API completion saved real history; queued turn continued; idle emitted no requests or metadata writes; shutdown released owned work.\n"))
        (when (buffer-live-p buffer) (+agent-acp-kill buffer))
        (delete-directory directory t)))))

(ert-deftest pi-butler-e2e-c17-real-project-and-global-pi-use-separate-management ()
  (save-window-excursion
    (let* ((directory (file-name-as-directory (make-temp-file "pi-scoped-native-" t)))
           (noema-pi-agent-directory (expand-file-name "pi-state/" directory))
           (noema-pi-companion-directory directory)
           (noema-pi-router--emacs-buffer nil)
           (noema-pi-router--buffers (make-hash-table :test #'equal))
           (+agent-acp-notify-function nil) (serial 0) buffers main child worker)
      (unwind-protect
          (cl-letf (((symbol-function 'noema-pi-deploy) (lambda () nil))
                    ((symbol-function '+noema--ensure-server) #'ignore)
                    ((symbol-function '+agent-acp-pi-config)
                     (lambda (_)
                       (agent-flow-e2e--config (expand-file-name (format "pi-%d.json" (cl-incf serial)) directory)))))
            (setq main (noema-pi-emacs-ensure)
                  child (noema-pi-project-ensure directory)
                  worker (+agent-acp-start :config (agent-flow-e2e--config (expand-file-name "worker.json" directory))
                                           :directory directory :focus nil :origin 'manual)
                  buffers (list main child worker))
            (dolist (buffer buffers)
              (agent-flow-e2e--wait (lambda () (+agent-acp-state-value buffer '(:init-finished)))))
            (+agent-acp-mark-session-buffer worker "manual/codex" "fixture" directory)
            (should (= 1 (length (+agent-pool-sessions directory))))
            (+agent-acp-show-buffer worker)
            (with-current-buffer worker
              (should-not (string-match-p "pi/emacs" (+agent-acp--tab-line)))
              (should (equal (+agent-acp--project-buffers directory) (list worker))))
            (noema-pi-router-open directory)
            (with-current-buffer child
              (should (string-prefix-p " Pi " (+agent-acp--tab-line)))
              (should-not (string-match-p "manual/codex" (+agent-acp--tab-line)))
              (call-interactively #'+agent-acp-session-manager))
            (let ((view (get-buffer "*Pi Sessions*")))
              (should (equal (buffer-local-value 'noema-pi-sessions--scope view) (noema-pi-project-root directory)))
              (with-current-buffer view
                (noema-pi-sessions-refresh)
                (should (= 1 (length tabulated-list-entries)))))
            (+agent-acp-show-buffer main)
            (with-current-buffer main (call-interactively #'+agent-acp-session-manager))
            (should (equal (buffer-local-value 'noema-pi-sessions--scope (get-buffer "*Pi Sessions*")) "emacs"))
            (princ "PI_SCOPED_NATIVE: worker tabs excluded Pi; project Pi and global Pi opened their own scoped history through the real management entry.\n"))
        (when-let* ((view (get-buffer "*Pi Sessions*"))) (kill-buffer view))
        (dolist (buffer buffers) (when (buffer-live-p buffer) (+agent-acp-kill buffer)))
        (delete-directory directory t)))))

(provide 'pi-butler-e2e)
