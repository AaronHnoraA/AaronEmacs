;;; init-performance-tests.el --- Performance Watch ETAF regression -*- lexical-binding: t -*-

(require 'ert)
(require 'cl-lib)
(require 'config/performance/config)

(defvar +noema--process)
(defvar +noema--ready)
(defvar +noema--file-buffers)
(defvar +noema--client-buffers)
(defvar +noema--host-event-queue)
(defvar +noema--post-queue)
(defvar +noema--process-log-bytes)
(defvar +activity-noema--tasks)
(defvar +activity-noema--agents)

(ert-deftest +performance-etaf-sections-and-report-stay-available ()
  "The dedicated page uses ETAF tabs and keeps the full export."
  (let ((source (generate-new-buffer " *performance source*"))
        (+performance-record-directory temporary-file-directory)
        board)
    (unwind-protect
        (save-window-excursion
          (switch-to-buffer source)
          (cl-letf (((symbol-function '+performance--ps-lines)
                     (lambda (&rest _) nil))
                    ((symbol-function '+performance-watch-display-buffer)
                     (lambda (buffer) (switch-to-buffer buffer))))
            (+performance/watch)
            (setq board (current-buffer))
            (should (etaf-runtime-for-buffer board))
            (should (eq +performance--inspected-buffer source))
            (should (string-match-p "Emacs CPU" (buffer-string)))
            (call-interactively (key-binding "2"))
            (should (string-match-p "Emacs Process List" (buffer-string)))
            (+performance/watch-select-tab 'buffers)
            (should (string-match-p "Largest Buffers" (buffer-string)))
            (+performance/watch-select-tab 'noema)
            (should (string-match-p "Queued host events" (buffer-string)))
            (+performance/watch-select-tab 'activity)
            (should (= 1 (how-many "Refresh" (point-min) (point-max))))
            (+performance/copy-page)
            (should (string-match-p "Emacs Process List" (current-kill 0)))))
      (when (buffer-live-p board)
        (kill-buffer board))
      (when (buffer-live-p source)
        (kill-buffer source)))))

(ert-deftest +performance-watch-uses-aaron-float-and-one-titlebar ()
  "The dashboard monitor uses the shared floating host in a GUI."
  (require 'aaron-ui-float)
  (let ((buffer (generate-new-buffer " *performance float test*"))
        shown)
    (unwind-protect
        (cl-letf (((symbol-function 'display-graphic-p)
                   (lambda (&rest _) t))
                  ((symbol-function 'posframe-workable-p) (lambda () t))
                  ((symbol-function 'aaron-ui-float-show)
                   (lambda (item &rest options)
                     (setq shown (cons item options))))
                  ((symbol-function 'pop-to-buffer)
                   (lambda (&rest _) (ert-fail "Monitor replaced a window"))))
          (+performance-watch-display-buffer buffer)
          (should (eq (car shown) buffer))
          (should (eq (plist-get (cdr shown) :key) 'performance-watch))
          (should (plist-get (cdr shown) :owned))
          (should (functionp (plist-get (cdr shown) :on-hide))))
      (kill-buffer buffer))))

(ert-deftest +performance-noema-snapshot-reads-cache-without-starting-host ()
  "Sampling Noema does not start the host or call its API."
  (let ((+noema--process nil)
        (+noema--ready nil)
        (+noema--file-buffers (make-hash-table :test #'equal))
        (+noema--client-buffers (make-hash-table :test #'equal))
        (+noema--host-event-queue '(one two))
        (+noema--post-queue '(one))
        (+noema--process-log-bytes 2048)
        (+activity-noema--tasks '(one))
        (+activity-noema--agents (make-hash-table :test #'eq)))
    (puthash "note.md" t +noema--file-buffers)
    (cl-letf (((symbol-function '+performance--ps-lines)
               (lambda (&rest _) (ert-fail "Offline Noema invoked ps")))
              ((symbol-function '+noema-api-call)
               (lambda (&rest _) (ert-fail "Sampling called Noema API"))))
      (let ((snapshot (+performance-noema-snapshot)))
        (should-not (plist-get snapshot :host-live))
        (should (= (plist-get snapshot :pages) 1))
        (should (= (plist-get snapshot :tasks) 1))
        (should (= (plist-get snapshot :events) 2))
        (should (= (plist-get snapshot :posts) 1))
        (should (= (plist-get snapshot :log-bytes) 2048))))))

(ert-deftest +performance-records-use-a-new-schema-file-for-noema ()
  "Noema columns never append to an existing Org-era TSV file."
  (let ((+performance-record-directory temporary-file-directory))
    (should (string-suffix-p "-v2.tsv" (+performance-record-file)))
    (should (string-match-p "noema-pages" (+performance--record-header)))
    (should-not (string-match-p "org-buffers" (+performance--record-header)))))

(ert-deftest +performance-buffer-context-menu-exposes-management-actions ()
  "Focused buffer rows have open, close, and file actions."
  (require 'etaf)
  (let ((source (generate-new-buffer "monitor-action-source"))
        (board (generate-new-buffer " *monitor-action-board*"))
        menu)
    (unwind-protect
        (with-current-buffer board
          (let ((+performance--buffer-entries (make-hash-table :test #'eq))
                (ref 'monitor-action-source))
            (puthash ref source +performance--buffer-entries)
            (cl-letf (((symbol-function 'etaf-runtime-for-buffer)
                       (lambda (&rest _) t))
                      ((symbol-function 'etaf-focused-host-ref)
                       (lambda (&rest _) nil))
                      ((symbol-function 'etaf-host-ref-at)
                       (lambda (&rest _) ref))
                      ((symbol-function 'popup-menu)
                       (lambda (value &rest _) (setq menu value))))
              (+performance/watch-context-menu)
              (should (string-match-p "打开 buffer" (format "%S" menu)))
              (should (string-match-p "关闭 buffer" (format "%S" menu))))))
      (kill-buffer source)
      (kill-buffer board))))

(ert-deftest +performance-file-delete-confirms-path-and-unsaved-edits ()
  "Deleting a monitored file requires path and unsaved-edit confirmations."
  (let* ((file (make-temp-file "monitor-delete-"))
         (buffer (find-file-noselect file))
         prompts)
    (unwind-protect
        (cl-letf (((symbol-function 'yes-or-no-p)
                   (lambda (prompt)
                     (push prompt prompts)
                     (not (string-match-p "Discard unsaved" prompt))))
                  ((symbol-function '+performance/watch-refresh-current)
                   #'ignore))
          (with-current-buffer buffer
            (goto-char (point-max))
            (insert "unsaved"))
          (should-error (+performance/delete-file buffer) :type 'user-error)
          (should (file-exists-p file))
          (should (buffer-live-p buffer))
          (should (seq-some (lambda (prompt) (string-match-p file prompt))
                            prompts))
          (cl-letf (((symbol-function 'yes-or-no-p)
                     (lambda (&rest _) t)))
            (+performance/delete-file buffer))
          (should-not (file-exists-p file))
          (should-not (buffer-live-p buffer)))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (set-buffer-modified-p nil))
        (kill-buffer buffer))
      (when (file-exists-p file)
        (delete-file file)))))

(ert-deftest +performance-hidden-monitor-stops-both-refresh-timers ()
  "Hiding the shared float releases monitor and Activity refresh timers."
  (let* ((+performance-buffer-name " *performance hidden test*")
         (buffer (get-buffer-create +performance-buffer-name))
         (performance-timer (run-with-timer 60 60 #'ignore))
         (activity-timer (run-with-timer 60 60 #'ignore)))
    (unwind-protect
        (with-current-buffer buffer
          (setq-local +performance--auto-refresh-timer performance-timer
                      +activity-board--auto-timer activity-timer)
          (+performance--float-hidden nil)
          (should-not +performance--auto-refresh-timer)
          (should-not +activity-board--auto-timer)
          (should-not (memq performance-timer timer-list))
          (should-not (memq activity-timer timer-list)))
      (cancel-timer performance-timer)
      (cancel-timer activity-timer)
      (kill-buffer buffer))))

(ert-deftest +performance-processes-auto-refresh-updates-task-rows ()
  "The Processes timer refreshes both runtime metrics and Activity rows."
  (let ((buffer (generate-new-buffer " *performance processes timer*"))
        (timer (run-with-timer 60 60 #'ignore))
        (activity 0)
        (metrics 0))
    (unwind-protect
        (with-current-buffer buffer
          (setq-local +performance--tab-state (etaf-ref 'processes)
                      +performance--auto-refresh-timer timer)
          (cl-letf (((symbol-function '+activity-board/refresh)
                     (lambda () (cl-incf activity)))
                    ((symbol-function '+performance/watch-refresh)
                     (lambda () (cl-incf metrics))))
            (+performance--auto-refresh-buffer buffer)
            (should (= activity 1))
            (should (= metrics 1))))
      (cancel-timer timer)
      (kill-buffer buffer))))

(provide 'init-performance-tests)
;;; init-performance-tests.el ends here
