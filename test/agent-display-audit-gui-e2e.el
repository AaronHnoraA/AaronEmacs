;;; agent-display-audit-gui-e2e.el --- Real project-pool navigation -*- lexical-binding: t; -*-
(require 'agent-flow-e2e)
(require 'aaron-ui-float)
(require 'term/portal/popup)

(defun agent-display-gui--key (key)
  (unless (commandp (key-binding (kbd key))) (error "Unbound GUI key: %s" key))
  (execute-kbd-macro (kbd key)))

(defun agent-display-audit-gui-e2e-run ()
  "Audit real ACP buffers across two owned GUI frames and a manager child."
  (unless (display-graphic-p) (error "GUI required"))
  (let* ((root (file-name-as-directory (make-temp-file "agent-display-gui-" t)))
         (frame1 (selected-frame))
         (source1 (generate-new-buffer "Agent pool editor one"))
         (source2 (generate-new-buffer "Agent pool editor two"))
         (+agent-acp-notify-function nil)
         (agent-shell-confirm-interrupt nil)
         frame2 origin1 origin2 a b c panel clients report
         (stage 'setup))
    (unwind-protect
        (condition-case err
            (progn
              (set-frame-size frame1 160 55)
              (delete-other-windows)
              (switch-to-buffer source1)
              (setq default-directory root origin1 (selected-window))
              (setq frame2 (make-frame '((name . "Owned agent pool audit") (width . 160) (height . 55))))
              (select-frame-set-input-focus frame2)
              (switch-to-buffer source2)
              (setq default-directory root origin2 (selected-window))
              (dotimes (index 3)
                (let ((store (expand-file-name (format "client-%d.json" index) root)))
                  ;; Distinct native IDs; B has real provider history to resume.
                  (when (> index 0)
                    (with-temp-file store
                      (insert (json-encode
                               (cl-loop for seed below index
                                        collect (cons (intern (format "history-%d" seed))
                                                      `((cwd . ,root) (turns . ["saved turn"]))))))))
                  (let ((buffer (+agent-acp-start :config (agent-flow-e2e--config store)
                                                  :directory root :origin (if (= index 1) 'popup 'manual))))
                    (push buffer clients)
                    (agent-flow-e2e--wait (lambda () (+agent-acp-state-value buffer '(:init-finished))))
                    (+agent-acp-mark-session-buffer buffer (char-to-string (+ ?a index)) "fixture" root))))
              (setq a (nth 2 clients) b (nth 1 clients) c (nth 0 clients))
              (with-current-buffer c (setq-local noema-agent-promote--session-id "owned-research"))
              (select-frame-set-input-focus frame1) (select-window origin1)
              (+portal-popup-display-buffer b) (+agent-acp-hide b)
              (+agent-view-embed c origin1) (+agent-acp-hide c)
              (should (eq (window-buffer origin1) source1))
              (should (= 3 (length (+agent-pool-sessions root))))
              (with-current-buffer a (should (= 3 (length (+agent-acp--project-buffers root)))))

              (setq stage 'pool-switch)
              (+agent-acp-show-buffer a)
              (let ((dock (selected-window)))
                (agent-display-gui--key "C-c C-n")
                (should (eq (selected-window) dock)) (should (eq (current-buffer) b))
                (let ((manual (split-window origin1 nil 'below)))
                  (set-window-buffer manual a)
                  (+agent-acp-show-buffer c)
                  (should (eq (selected-window) dock))
                  (should (eq (window-buffer manual) a))
                  (+agent-acp-hide c)
                  (should-not (window-live-p dock))
                  (should (eq (selected-window) origin1))
                  (should (eq (window-buffer manual) a))
                  (delete-window manual)))
              (agent-display-gui--key "C-c a")
              (should (+agent-acp-agent-buffer-p (current-buffer)))
              (agent-display-gui--key "C-c a")
              (should (eq (selected-window) origin1))

              (setq stage 'frame-local-display)
              (+agent-acp-show-buffer a)
              (let ((dock1 (selected-window)))
                (select-frame-set-input-focus frame2) (select-window origin2)
                (+agent-acp-show-buffer a)
                (should (eq (selected-frame) frame2))
                (+agent-acp-hide a)
                (should (eq (selected-window) origin2))
                (should (eq (window-buffer dock1) a))
                ;; Background native approval must not acquire keyboard focus.
                (agent-flow-e2e--send c "permission")
                (agent-flow-e2e--wait (lambda () (eq (plist-get (+agent-session-snapshot c) :attention-kind) 'permission)))
                (should (eq (selected-window) origin2))
                (should (eq (window-buffer origin2) source2))
                (select-frame-set-input-focus frame1) (select-window dock1)
                (+agent-acp-hide a))

              (setq stage 'manager-reparent)
              (agent-display-gui--key "H-A")
              (setq panel (aaron-ui-float-panel-for-buffer (get-buffer +agent-manager-buffer-name)))
              (let ((old-child (aaron-ui-float-panel-frame panel)))
                (should (eq (frame-parent old-child) frame1))
                (select-frame-set-input-focus frame2) (select-window origin2)
                (agent-display-gui--key "H-A")
                (should (aaron-ui-float-visible-p panel))
                (should (eq (frame-parent (aaron-ui-float-panel-frame panel)) frame2))
                (should-not (frame-live-p old-child)))
              (select-window (aaron-ui-float-content-window panel))
              (+agent-manager-select a)
              (select-window (get-buffer-window a (aaron-ui-float-panel-frame panel)))
              (agent-display-gui--key "C-c C-n")
              (should (eq (selected-frame) frame2))
              (should (eq (current-buffer) b))
              (should-not (aaron-ui-float-visible-p panel))

              (setq stage 'restart-in-current-dock)
              (+agent-acp-hide b)
              (+agent-acp-show-buffer a) (+agent-acp-show-buffer b)
              (let ((dock (selected-window)) (id (+agent-acp-state-value b '(:session :id)))
                    (sibling (with-selected-frame frame1
                               (select-window origin1)
                               (+agent-acp-show-buffer a) (+agent-acp-show-buffer b)
                               (selected-window))))
                (should (window-parameter dock 'agent-workspace))
                (should-not (+portal-popup--window))
                (agent-shell-insert :text "unsent gui draft" :submit nil :no-focus t :shell-buffer b)
                (with-current-buffer b (setf (map-elt agent-shell--state :pending-prompts) '("queued gui intent")))
                (cl-letf (((symbol-function 'yes-or-no-p) (lambda (&rest _) t))
                          ((symbol-function 'y-or-n-p) (lambda (&rest _) t)))
                  (setq b (+agent-acp-restart-native b)))
                (push b clients)
                (agent-flow-e2e--wait (lambda () (+agent-acp-state-value b '(:init-finished))))
                (should (equal id (+agent-acp-state-value b '(:session :id))))
                (should (eq (selected-window) dock)) (should (eq (selected-frame) frame2))
                (should (eq (window-buffer sibling) b))
                (should (eq (plist-get (window-parameter sibling '+agent-view) :buffer) b))
                (should-not (+portal-popup--window))
                (should (equal (buffer-local-value '+agent-acp--held-prompts b) '("queued gui intent")))
                (should (equal (with-current-buffer b (agent-shell--prompt-input)) "unsent gui draft"))
                (with-current-buffer b
                  (setq +agent-acp--held-prompts nil)
                  (agent-shell--clear-prompt-input))
                (setq stage 'resume-in-current-dock)
                (cl-letf (((symbol-function 'completing-read)
                           (lambda (_prompt choices &rest _)
                             (car (seq-find (lambda (choice) (equal (cdr choice) "history-0")) choices)))))
                  (with-current-buffer b (+agent-shell/resume))
                  (agent-flow-e2e--wait (lambda () (and (buffer-live-p (window-buffer dock))
                                                         (equal (+agent-acp-state-value (window-buffer dock) '(:session :id)) "history-0")))))
                (setq b (window-buffer dock)) (push b clients)
                (should (eq (selected-window) dock)) (should (eq (selected-frame) frame2))
                (should (eq (window-buffer sibling) b))
                (with-selected-window sibling
                  (+agent-acp-hide b)
                  (should (eq (selected-window) origin1)))
                (+agent-acp-hide b)
                (should (eq (selected-window) origin2)))

              (setq stage 'restart-popup)
              (let ((popup1 (with-selected-frame frame1
                              (select-window origin1) (+portal-popup-display-buffer b)
                              (selected-window))))
                (+portal-popup-display-buffer b)
                (+agent-acp-hide b)
                (should (eq (selected-window) origin2))
                (should (window-live-p popup1))
                (should (eq (window-buffer popup1) b))
                (with-selected-window popup1 (+agent-acp-hide b)))
              (+portal-popup-display-buffer b)
              (let ((id (+agent-acp-state-value b '(:session :id))))
                (setq b (+agent-acp-restart-native b)) (push b clients)
                (agent-flow-e2e--wait (lambda () (+agent-acp-state-value b '(:init-finished))))
                (should (equal id (+agent-acp-state-value b '(:session :id))))
                (should (eq (selected-frame) frame2))
                (should (window-parameter (selected-window) '+portal-popup))
                (should-not (+agent-acp--workspace-window))
                (+agent-acp-hide b)
                (should (eq (selected-window) origin2)))
              (should-not +agent-view-request)
              (dolist (buffer (list a b c)) (should (+agent-session-live-p buffer)))
              (should (eq (window-buffer origin1) source1))
              (should (eq (window-buffer origin2) source2))
              (setq report '(:passed t :real-clients 3 :ordinary-frames 2 :project-pool t
                             :native-tab-switch t :manual-split t :frame-local-return t
                             :background-approval t :manager-reparent t :preview-switch t
                             :restart-draft-queue t :native-resume t :popup-restart t :popup-local-return t)))
          (error (error "Agent display GUI stage %s: %S" stage err)))
      (when (and panel (aaron-ui-float-live-p panel)) (aaron-ui-float-close panel))
      (dolist (buffer (delete-dups clients))
        (when (buffer-live-p buffer)
          (with-current-buffer buffer (let ((kill-buffer-query-functions nil)) (kill-buffer buffer)))))
      (when (frame-live-p frame2) (delete-frame frame2 t))
      (select-frame frame1)
      (mapc #'kill-buffer (list source1 source2))
      (delete-directory root t))
    report))

(provide 'agent-display-audit-gui-e2e)
