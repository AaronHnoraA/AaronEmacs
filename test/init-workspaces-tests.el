;;; init-workspaces-tests.el --- Tab and Perspective lifecycle -*- lexical-binding: t; -*-

(require 'ert)
(require 'perspective)
(require 'ui/workspaces/config)

(ert-deftest workspace-native-tab-close-keeps-the-workspace-and-buffer ()
  (persp-mode 1)
  (tab-bar-mode 1)
  (let* ((original (persp-current-name))
         (name (make-temp-name "workspace-tab-"))
         (initial-tabs (+tab-count))
         (buffer (generate-new-buffer " *workspace-tab-close-test*")))
    (unwind-protect
        (progn
          (+tab-switch-to-current-workspace)
          (+workspaces/tab-new name)
          (persp-add-buffer buffer)
          (should (= (+tab-count) (1+ initial-tabs)))
          (should (member name (persp-names)))
          (tab-close)
          (should (= (+tab-count) initial-tabs))
          (should (member name (persp-names)))
          (should (buffer-live-p buffer))
          ;; A closed tab leaves its Perspective available.  A new paired tab
          ;; must not silently reuse that existing Perspective.
          (should-error (+workspaces/tab-new name) :type 'user-error)
          (should (= (+tab-count) initial-tabs)))
      (when (member name (persp-names))
        (persp-switch original)
        (persp-kill name))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

(ert-deftest workspace-native-unpaired-tab-close-does-not-kill-current-workspace ()
  (persp-mode 1)
  (tab-bar-mode 1)
  (let* ((original (persp-current-name))
         (initial-tabs (+tab-count)))
    (unwind-protect
        (progn
          (+tab-switch-to-current-workspace)
          (tab-bar-new-tab)
          (should (= (+tab-count) (1+ initial-tabs)))
          (tab-close)
          (should (= (+tab-count) initial-tabs))
          (should (member original (persp-names))))
      (while (> (+tab-count) initial-tabs)
        (tab-close)))))

(ert-deftest workspace-generated-name-skips-native-tab-name ()
  (persp-mode 1)
  (tab-bar-mode 1)
  (let* ((original (persp-current-name))
         (initial-tabs (+tab-count))
         (generated nil))
    (unwind-protect
        (progn
          (+tab-switch-to-current-workspace)
          (tab-bar-new-tab)
          (tab-bar-rename-tab "#1")
          (setq generated (+workspace--generate-name))
          (should-not (equal generated "#1"))
          (+workspaces/tab-new generated)
          (should (equal (+tab-current-name) generated))
          (should (member generated (persp-names))))
      (while (> (+tab-count) initial-tabs)
        (tab-close))
      (when (and generated (member generated (persp-names)))
        (persp-switch original)
        (persp-kill generated)))))

(ert-deftest workspace-delete-closes-matching-tab ()
  (persp-mode 1)
  (tab-bar-mode 1)
  (let* ((original (persp-current-name))
         (initial-tabs (+tab-count))
         (name (make-temp-name "workspace-delete-")))
    (unwind-protect
        (progn
          (+tab-switch-to-current-workspace)
          (+workspaces/tab-new name)
          (should (member name (+tab-list-names)))
          (+workspace/kill)
          (should-not (member name (persp-names)))
          (should-not (member name (+tab-list-names)))
          (should (= (+tab-count) initial-tabs))
          (should (equal (+workspace-current-name) original))
          (should (equal (+tab-current-name) original)))
      (when (member name (persp-names))
        (persp-switch original)
        (persp-kill name))
      (while (> (+tab-count) initial-tabs)
        (tab-close)))))

(ert-deftest workspace-delete-reuses-the-only-tab ()
  (persp-mode 1)
  (tab-bar-mode 1)
  (let* ((original (persp-current-name))
         (initial-tabs (+tab-count))
         (name (make-temp-name "workspace-sole-tab-")))
    (unwind-protect
        (progn
          (+tab-switch-to-current-workspace)
          (+workspace/new name)
          (should (equal (+tab-current-name) name))
          (+workspace/kill)
          (should-not (member name (persp-names)))
          (should-not (member name (+tab-list-names)))
          (should (= (+tab-count) initial-tabs))
          (should (equal (+tab-current-name) original)))
      (when (member name (persp-names))
        (persp-switch original)
        (persp-kill name))
      (+tab-switch-to-current-workspace))))

(ert-deftest workspace-delete-respects-tab-close-veto ()
  (persp-mode 1)
  (tab-bar-mode 1)
  (let* ((original (persp-current-name))
         (initial-tabs (+tab-count))
         (name (make-temp-name "workspace-veto-"))
         (prevent (lambda (tab _last)
                    (equal (alist-get 'name tab) name))))
    (unwind-protect
        (progn
          (+tab-switch-to-current-workspace)
          (+workspaces/tab-new name)
          (tab-bar-switch-to-tab original)
          (add-hook 'tab-bar-tab-prevent-close-functions prevent)
          (should-error (+workspace/kill name) :type 'user-error)
          (should (member name (persp-names)))
          (should (member name (+tab-list-names)))
          (remove-hook 'tab-bar-tab-prevent-close-functions prevent)
          (+workspace/kill name)
          (should-not (member name (persp-names)))
          (should-not (member name (+tab-list-names)))
          (should (= (+tab-count) initial-tabs)))
      (remove-hook 'tab-bar-tab-prevent-close-functions prevent)
      (while (> (+tab-count) initial-tabs)
        (tab-close))
      (when (member name (persp-names))
        (persp-switch original)
        (persp-kill name)))))

(provide 'init-workspaces-tests)
;;; init-workspaces-tests.el ends here
