;;; noema-document-run-tests.el --- Document runs in native compilation -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'noema/bridge/document-run)

(ert-deftest noema-document-run-starts-after-native-command-review ()
  (let* ((+noema--document-runs nil)
         (directory (make-temp-file "noema-run-test-" t))
         (note (expand-file-name "example.md" directory))
         (params (list '(action . "start") '(command . "printf 'authored'")
                       (cons 'note note)
                       (cons 'directory directory)))
         (reviewed nil)
         (run nil))
    (write-region "# Example\n" nil note nil 'silent)
    (unwind-protect
        (cl-letf (((symbol-function 'compilation-read-command)
                   (lambda (command)
                     (setq reviewed command)
                     "printf 'actual output\\n'")))
          (let* ((started (+noema--document-run-api params nil))
                 (id (alist-get 'id started)))
            (should (equal (alist-get 'status started) "awaiting"))
            (should-not reviewed)
            (setq run (car +noema--document-runs))
            (let ((deadline (+ (float-time) 7)) snapshot)
              (while (and (< (float-time) deadline)
                          (progn
                            (setq snapshot (+noema--document-run-api
                                            (list '(action . "status") (cons 'id id) (cons 'note note)) nil))
                            (member (alist-get 'status snapshot) '("awaiting" "running"))))
                (accept-process-output nil 0.04))
              (should (equal reviewed "printf 'authored'"))
              (should (equal (alist-get 'status snapshot) "succeeded"))
              (should (= 0 (alist-get 'exitCode snapshot)))
              (should (string-match-p "actual output" (alist-get 'output snapshot))))))
      (when-let* ((run) (buffer (+noema--document-run-buffer run)))
        (when (buffer-live-p buffer) (kill-buffer buffer)))
      (delete-directory directory t))))

(ert-deftest noema-document-run-quit-before-launch ()
  (let ((+noema--document-runs nil)
        (note (make-temp-file "noema-run-note-" nil ".md")))
    (unwind-protect
        (cl-letf (((symbol-function 'compilation-read-command)
                   (lambda (_) (signal 'quit nil)))
                  ((symbol-function '+output-compile)
                   (lambda (&rest _) (ert-fail "A cancelled prompt started compilation"))))
          (let* ((start (+noema--document-run-api
                         (list '(action . "start") '(command . "printf 'skipped'") (cons 'note note)
                               (cons 'directory temporary-file-directory)) nil))
                 (id (alist-get 'id start))
                 (status-params (list '(action . "status") (cons 'id id) (cons 'note note)))
                 (deadline (+ (float-time) 5))
                 state)
            (while (and (< (float-time) deadline)
                        (equal (setq state (alist-get 'status (+noema--document-run-api status-params nil)))
                               "awaiting"))
              (accept-process-output nil 0.04))
            (should (equal state "cancelled"))))
      (delete-file note))))

;;; noema-document-run-tests.el ends here
