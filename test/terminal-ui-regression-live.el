;;; terminal-ui-regression-live.el --- Preserve native terminal interactions -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'term/portal/config)
(require 'config/background/config)

(defconst terminal-ui-regression--command
  '("/bin/sh" "-c" "printf 'TERMINAL-UI-READY\\n'; exec /bin/sh"))

(defun terminal-ui-regression--wait (predicate)
  "Wait for a native event satisfying PREDICATE."
  (let ((deadline (+ (float-time) 20)))
    (while (and (not (funcall predicate)) (< (float-time) deadline))
      (accept-process-output nil 0.03)
      (redisplay t))
    (should (funcall predicate))))

(defun terminal-ui-regression--ready (buffer)
  "Wait for BUFFER's real shell, then return its native handle."
  (let ((handle (buffer-local-value 'portal-view--target buffer)))
    (terminal-ui-regression--wait
     (lambda () (string-match-p "TERMINAL-UI-READY" (or (portal--terminal-text handle) ""))))
    handle))

(defun terminal-ui-regression--exit (buffer)
  "Type exit into BUFFER's real PTY and wait for its ordinary close."
  (remote-terminal-send-string (buffer-local-value 'remote-terminal-instance buffer) "exit\n")
  (terminal-ui-regression--wait (lambda () (not (buffer-live-p buffer)))))

(ert-deftest terminal-ui-regression-raycast-opens-one-window-and-exit-closes-its-frame ()
  (skip-unless (display-graphic-p))
  (let* ((origin (selected-frame))
         (configuration (current-window-configuration))
         (original (symbol-function '+portal-create))
         (source (generate-new-buffer " *terminal-ui-source*"))
         (peer (generate-new-buffer " *terminal-ui-peer*"))
         (display-buffer-alist (cons '("\\`\\*portal:" (display-buffer-pop-up-window)
                                      (inhibit-same-window . t)) display-buffer-alist))
         (directory (make-temp-file "terminal-ui-" t))
         frame buffer)
    (unwind-protect
        (progn
          (delete-other-windows)
          (switch-to-buffer source)
          (set-window-buffer (split-window-right) peer)
          (with-current-buffer source (setq default-directory (file-name-as-directory directory)))
          (cl-letf (((symbol-function '+portal-create)
                     (lambda (&rest options)
                       (setq buffer (apply original (plist-put options :command terminal-ui-regression--command))))))
            (+portal/open-new))
          (setq frame (selected-frame))
          (should-not (eq frame origin))
          (terminal-ui-regression--ready buffer)
          (should (= 1 (length (window-list frame 'nomini))))
          (should (eq (window-buffer (frame-selected-window frame)) buffer))
          (should (= 2 (length (window-list origin 'nomini))))
          (should (get-buffer-window source origin))
          (should (get-buffer-window peer origin))
          (should (buffer-local-value 'portal-terminal-auto-close-on-exit buffer))
          (terminal-ui-regression--exit buffer)
          (terminal-ui-regression--wait (lambda () (not (frame-live-p frame))))
          (should (frame-live-p origin))
          (should (= 2 (length (window-list origin 'nomini))))
          (should (get-buffer-window source origin))
          (should (get-buffer-window peer origin)))
      (when (buffer-live-p buffer)
        (with-current-buffer buffer (let ((kill-buffer-query-functions nil)) (kill-buffer buffer))))
      (when (and frame (frame-live-p frame)) (delete-frame frame t))
      (when (frame-live-p origin)
        (select-frame origin)
        (set-window-configuration configuration))
      (dolist (candidate (list source peer)) (when (buffer-live-p candidate) (kill-buffer candidate)))
      (delete-directory directory t))))

(ert-deftest terminal-ui-regression-command-t-keeps-each-requested-placement ()
  (skip-unless (display-graphic-p))
  (let* ((origin (selected-frame))
         (configuration (current-window-configuration))
         (original (symbol-function '+portal-create))
         (source (generate-new-buffer " *terminal-selector-source*"))
         (peer (generate-new-buffer " *terminal-selector-peer*"))
         (directory (make-temp-file "terminal-selector-ui-" t))
         (display-buffer-alist (cons '("\\`\\*portal:" (display-buffer-pop-up-window)
                                      (inhibit-same-window . t)) display-buffer-alist))
         buffers frames)
    (unwind-protect
        (dolist (placement '(current right below frame))
          (select-frame origin)
          (delete-other-windows)
          (switch-to-buffer source)
          (with-current-buffer source (setq default-directory (file-name-as-directory directory)))
          (let* ((left (selected-window))
                 (right (split-window-right))
                 buffer frame)
            (set-window-buffer right peer)
            (cl-letf (((symbol-function 'completing-read)
                       (lambda (_prompt choices &rest _)
                         (setq +terminal-selector-placement placement)
                         (car (rassq :new choices))))
                      ((symbol-function '+portal-create)
                       (lambda (&rest options)
                         (setq buffer (apply original (plist-put options :command terminal-ui-regression--command))))))
              (call-interactively #'terminal-switcher))
            (push buffer buffers)
            (setq frame (selected-frame))
            (unless (eq frame origin) (push frame frames))
            (terminal-ui-regression--ready buffer)
            (should (eq (lookup-key portal-terminal-native-map (kbd "s-t")) #'+portal/terminal-selector))
            (should (eq (window-buffer) buffer))
            (should (get-buffer-window peer origin))
            (pcase placement
              ('frame
               (should-not (eq frame origin))
               (should (= 1 (length (window-list frame 'nomini))))
               (should (= 2 (length (window-list origin 'nomini)))))
              ('current
               (should (eq frame origin))
               (should (eq (selected-window) left))
               (should (= 2 (length (window-list origin 'nomini)))))
              (_
               (should (eq frame origin))
               (should (= 3 (length (window-list origin 'nomini))))
               (should (get-buffer-window source origin))))
            (terminal-ui-regression--exit buffer)))
      (dolist (buffer buffers)
        (when (buffer-live-p buffer)
          (with-current-buffer buffer (let ((kill-buffer-query-functions nil)) (kill-buffer buffer)))))
      (dolist (frame frames) (when (frame-live-p frame) (delete-frame frame t)))
      (when (frame-live-p origin)
        (select-frame origin) (set-window-configuration configuration))
      (dolist (buffer (list source peer)) (when (buffer-live-p buffer) (kill-buffer buffer)))
      (delete-directory directory t))))

(provide 'terminal-ui-regression-live)
;;; terminal-ui-regression-live.el ends here
