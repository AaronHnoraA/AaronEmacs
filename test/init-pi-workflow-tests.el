;;; init-pi-workflow-tests.el --- Pi and startup visibility -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'ibuffer)
(require 'ibuf-ext)
(require 'noema-pi-router)

(ert-deftest pi-workflow-c3-cold-app-chooses-dashboard-without-taking-file-launches ()
  (let ((noninteractive nil) (initial-buffer-choice nil)
        (command-line-args '("Emacs")))
    (+dashboard-configure-startup-choice)
    (let ((home (+window-dashboard-buffer)))
      (should (eq (funcall initial-buffer-choice) home))))
  (let ((noninteractive nil) (initial-buffer-choice nil)
        (command-line-args '("Emacs" "/tmp/requested.md")))
    (+dashboard-configure-startup-choice)
    (should-not initial-buffer-choice)))

(ert-deftest pi-workflow-c4-background-pi-is-discoverable-in-ibuffer ()
  (let ((pi (generate-new-buffer "*Pi ibuffer visibility test*")) listing)
    (unwind-protect
        (save-window-excursion
          (with-current-buffer pi
            (setq major-mode 'agent-shell-mode)
            (setq-local +agent-acp-session-origin 'pi-emacs))
          (should (aaron-ibuffer-pi-buffer-p pi))
          (ibuffer)
          (setq listing (current-buffer))
          (ibuffer-update nil t)
          (goto-char (point-min))
          (should (search-forward (buffer-name pi) nil t))
          (beginning-of-line)
          (should (eq (ibuffer-current-buffer) pi))
          (should (equal (caar (ibuffer-current-filter-groups-with-position)) "Pi")))
      (when (buffer-live-p listing) (kill-buffer listing))
      (kill-buffer pi))))

(ert-deftest pi-workflow-c3-background-start-preserves-the-selected-buffer ()
  (save-window-excursion
    (let ((source (window-buffer (selected-window))) (noema-pi-assistant-mode t)
          (noema-pi-router--startup-timer nil)
          (+project-active-root nil) (noninteractive nil) (main-called nil))
      (cl-letf (((symbol-function 'noema-pi-emacs-ensure)
                 (lambda (&optional focus) (should-not focus) (setq main-called t)))
                ((symbol-function 'noema-pi-router--project-activated) #'ignore))
        (unwind-protect
            (progn
              (noema-pi-router--startup)
              (should-not main-called)
              (should (timerp noema-pi-router--startup-timer))
              (cancel-timer noema-pi-router--startup-timer)
              (noema-pi-router--warmup)
              (should main-called)
              (should (eq (window-buffer (selected-window)) source)))
          (noema-pi-router--cancel-startup))))))

(ert-deftest pi-workflow-c2-failed-restore-does-not-fall-back-to-a-new-session ()
  (with-temp-buffer
    (setq-local major-mode 'agent-shell-mode
                +agent-acp-strict-restore t
                agent-shell--state (let ((state (make-hash-table)))
                                      (puthash :buffer (current-buffer) state)
                                      (puthash :supports-session-load t state)
                                      state))
    (let (failed)
      (cl-letf (((symbol-function 'agent-shell--update-bootstrapping-fragment) #'ignore)
                ((symbol-function 'agent-shell-cwd) (lambda () temporary-file-directory))
                ((symbol-function 'agent-shell--send-request)
                 (lambda (&rest args) (funcall (plist-get args :on-failure) 'missing nil)))
                ((symbol-function '+agent-acp--restore-failed)
                 (lambda (_buffer id) (setq failed id)))
                ((symbol-function 'agent-shell--initiate-session-list-and-load)
                 (lambda (&rest _) (ert-fail "Strict restore must not select another conversation"))))
        (agent-shell--initiate-session-resume-by-id
         :session-id "saved-id" :shell-buffer (current-buffer) :on-session-init #'ignore)
        (should (equal failed "saved-id"))))))

(ert-deftest pi-workflow-c2-unsupported-restore-is-reported-before-session-creation ()
  (with-temp-buffer
    (setq-local +agent-acp-strict-restore t
                agent-shell--state '((:resume-session-id . "saved-id")))
    (let (failed started)
      (cl-letf (((symbol-function '+agent-acp--restore-failed) (lambda (_ id) (setq failed id))))
        (+agent-acp--strict-initiate-session (lambda (&rest _) (setq started t)) :shell-buffer (current-buffer))
        (should (equal failed "saved-id"))
        (should-not started)))))

(ert-deftest pi-workflow-c9-global-entry-toggles-and-project-entry-uses-source ()
  (save-window-excursion
    (let ((main (generate-new-buffer "*Pi global entry fixture*")) ensured hidden project)
      (unwind-protect
          (let ((noema-pi-router--emacs-buffer main))
            (cl-letf (((symbol-function 'noema-pi-emacs-ensure) (lambda (&optional focus) (setq ensured focus) main))
                      ((symbol-function '+agent-acp-hide) (lambda (b) (setq hidden b)))
                      ((symbol-function 'noema-pi-router-open) (lambda (&optional _) (setq project t))))
              (noema-pi-emacs-open)
              (should ensured)
              (should (eq (lookup-key +agent-prefix-map (kbd "P")) #'noema-pi-open))
              (set-window-buffer (selected-window) main)
              (noema-pi-emacs-open)
              (should (eq hidden main))
              (noema-pi-emacs-open '(4))
              (should project)))
        (kill-buffer main)))))

(ert-deftest pi-workflow-c10-context-resolves-selected-editor-not-gateway-buffer ()
  (save-window-excursion
    (let ((source (generate-new-buffer "*Pi context source*")))
      (unwind-protect
          (progn
            (set-window-buffer (selected-window) source)
            (with-current-buffer source
              (setq-local buffer-file-name "/tmp/pi-context-source.txt")
              (insert "first\nsecond\n")
              (goto-char 9))
            (set-window-point (selected-window) 9)
            (with-temp-buffer
              (cl-letf (((symbol-function 'noema-pi-emacs-ensure) (lambda (&rest _) (ert-fail "Query started Pi"))))
                (let ((context (alist-get 'context (noema-pi-api '((action . "context"))))))
                  (should (equal (alist-get 'file context) "/tmp/pi-context-source.txt"))
                  (should (= (alist-get 'line context) 2))
                  (should (eq (alist-get 'modified context) t))
                  (should-not (string-match-p "first" (prin1-to-string context)))))))
        (with-current-buffer source (set-buffer-modified-p nil))
        (kill-buffer source)))))

(ert-deftest pi-workflow-c10-page-context-does-not-invent-position-or-modified-state ()
  (require 'tools/agent/context)
  (save-window-excursion
    (with-temp-buffer
      (let ((source (current-buffer)))
        (setq-local +noema-buffer-file-name "/tmp/pi-page.md")
        (insert "placeholder has nothing to do with source\n")
        (set-window-buffer (selected-window) source)
        (cl-letf (((symbol-function 'noema-md-bridge-pane-p) (lambda (&optional b) (eq b source))))
          (let ((context (+agent-context-state)))
            (should (equal (alist-get 'file context) "/tmp/pi-page.md"))
            (should (eq (alist-get 'pageOwned context) t))
            (should-not (assq 'line context))
            (should-not (assq 'selection context))
            (should-not (assq 'modified context))))))))

(ert-deftest pi-workflow-c10-context-booleans-survive-gateway-encoding ()
  (require 'remote-gateway)
  (require 'tools/agent/context)
  (save-window-excursion
    (with-temp-buffer
      (set-window-buffer (selected-window) (current-buffer))
      (let* ((json (remote-gateway--encode (+agent-context-state)))
             (context (json-parse-string json :object-type 'alist :false-object :json-false)))
        (should (eq (alist-get 'sourceAvailable context) t))
        (should (eq (alist-get 'pageOwned context) :json-false))
        (should (eq (alist-get 'modified context) :json-false))))))

(ert-deftest pi-workflow-c11-background-send-preserves-no-focus-through-initialization ()
  (let ((buffer (generate-new-buffer "*Pi send fixture*")) callback sent)
    (unwind-protect
        (cl-letf (((symbol-function 'noema-pi-emacs-ensure) (lambda (&rest _) buffer))
                  ((symbol-function '+agent-session-snapshot) (lambda (_) '(:process-state starting)))
                  ((symbol-function '+agent-acp-state-value) (lambda (&rest _) nil))
                  ((symbol-function '+agent-acp-subscribe) (lambda (&rest args) (setq callback (plist-get args :callback)) 'subscription))
                  ((symbol-function '+agent-acp-unsubscribe) #'ignore)
                  ((symbol-function '+agent-acp-show-buffer) (lambda (_) (ert-fail "Background Pi send selected a window"))))
          (noema-pi-api '((action . "send") (companion . t) (prompt . "Explicit request")))
          (should callback)
          (cl-letf (((symbol-function '+agent-acp-state-value) (lambda (&rest _) "native"))
                    ((symbol-function '+agent-acp-busy-p) (lambda (_) nil))
                    ((symbol-function '+agent-acp-pending-prompt-count) (lambda (_) 0))
                    ((symbol-function '+agent-acp-prompt) (lambda (&rest _) (setq sent t))))
            (funcall callback nil)
            (should sent)))
      (kill-buffer buffer))))

(ert-deftest pi-workflow-w3-slash-watch-routes-to-the-local-command ()
  (with-temp-buffer
    (let ((agent-shell--state '((:available-commands . nil))))
      (should (eq (+agent-shell--local-slash "/watch") 'noema-project-graph-add-watch))
      (should-not (+agent-shell--local-slash "/watch 20m")))))

(ert-deftest pi-workflow-c22-send-names-the-proven-agent-session ()
  (require 'tools/agent/api)
  (let ((buffer (generate-new-buffer "*Agent · codex*")) sent)
    (unwind-protect
        (cl-letf (((symbol-function 'noema-pi-emacs-ensure) (lambda (&rest _) buffer))
                  ((symbol-function 'noema-pi-send)
                   (lambda (_root prompt &rest _) (setq sent prompt) buffer))
                  ((symbol-function '+agent-acp-state-value) (lambda (&rest _) "pi-native"))
                  ((symbol-function 'noema-pi-sessions--state) (lambda (_) "idle"))
                  ((symbol-function '+agent-api-identified)
                   (lambda (from)
                     (should (equal (alist-get 'buffer from) "*Agent · codex*"))
                     (list :agent 'codex :buffer buffer :native-session-id "codex-native" :root "/tmp/p/"))))
          (noema-pi-api '((action . "send") (companion . t) (prompt . "Who owns this?")
                          (from . ((buffer . "*Agent · codex*") (nativeSessionId . "codex-native")))))
          (should (string-prefix-p "[From Agent session: agent=codex buffer=*Agent · codex* nativeSessionId=codex-native root=/tmp/p/."
                                   sent))
          (should (multibyte-string-p sent))
          (should (string-match-p "\"buffer\":\"\\*Agent · codex\\*\"" sent))
          (should (string-suffix-p "\n\nWho owns this?" sent))
          (setq sent nil)
          (noema-pi-api '((action . "send") (companion . t) (prompt . "Plain")))
          (should (equal sent "Plain"))
          (cl-letf (((symbol-function '+agent-api-identified)
                     (lambda (_) (user-error "Session identity no longer matches"))))
            (setq sent nil)
            (should-error (noema-pi-api '((action . "send") (companion . t) (prompt . "Forged")
                                          (from . ((buffer . "x") (nativeSessionId . "y")))))
                          :type 'user-error)
            (should-not sent)))
      (kill-buffer buffer))))

(ert-deftest pi-workflow-c11-project-children-have-complete-independent-pagination ()
  (let ((noema-pi-router--buffers (make-hash-table :test #'equal))
        (one (generate-new-buffer "*Pi child one fixture*"))
        (two (generate-new-buffer "*Pi child two fixture*")))
    (unwind-protect
        (cl-letf (((symbol-function 'noema-pi-sessions-records) (lambda () nil))
                  ((symbol-function '+agent-acp-state-value) (lambda (&rest _) nil)))
          (puthash "/tmp/project-b/" two noema-pi-router--buffers)
          (puthash "/tmp/project-a/" one noema-pi-router--buffers)
          (let ((first (noema-pi-api '((action . "list") (limit . 1))))
                (second (noema-pi-api '((action . "list") (offset . 1) (limit . 1)))))
            (should (= (alist-get 'childrenTotal first) 2))
            (should (= (alist-get 'childrenNextOffset first) 1))
            (should-not (alist-get 'nextOffset first))
            (should (equal (alist-get 'root (aref (alist-get 'children first) 0)) "/tmp/project-a/"))
            (should (equal (alist-get 'root (aref (alist-get 'children second) 0)) "/tmp/project-b/"))
            (should-not (alist-get 'childrenNextOffset second))))
      (kill-buffer one) (kill-buffer two))))

(ert-deftest pi-workflow-c10-no-editor-does-not-present-pi-home-as-user-project ()
  (require 'tools/agent/context)
  (save-window-excursion
    (with-temp-buffer
      (setq major-mode 'agent-shell-mode)
      (set-window-buffer (selected-window) (current-buffer))
      (cl-letf (((symbol-function '+agent-view-origin-window) (lambda (&optional _) nil)))
        (let ((context (+agent-context-state)))
          (should (eq (alist-get 'sourceAvailable context) :json-false))
          (should-not (alist-get 'directory context))
          (should-not (alist-get 'root context)))
        (should-error (noema-pi-router-open) :type 'user-error)))))

(ert-deftest pi-workflow-c9-project-front-door-delegates-source-to-existing-owner ()
  (let (ensured shown)
    (cl-letf (((symbol-function '+agent-context-state)
               (lambda (&optional _) '((directory . "/tmp/source-project/"))))
              ((symbol-function 'noema-pi-project-ensure)
               (lambda (directory) (setq ensured directory) 'project-child))
              ((symbol-function 'noema-pi-router--show-or-resume)
               (lambda (buffer) (setq shown buffer))))
      (let ((default-directory "~/")) (noema-pi-router-open))
      (should (equal ensured "/tmp/source-project/"))
      (should (eq shown 'project-child)))))

(provide 'init-pi-workflow-tests)
