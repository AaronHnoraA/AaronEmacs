;;; init-file-open-frame-tests.el --- File prompt frame choice -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'consult)
(require 'init-minibuffer)
(require 'init-windows)

(ert-deftest file-open-prompt-keeps-native-return-and-routes-shift-return ()
  (let (visited framed)
    (cl-letf (((symbol-function 'find-file-read-args)
               (lambda (&rest _) (list "/tmp/new-file.md" t)))
              ((symbol-function 'find-file)
               (lambda (file &optional wildcards)
                 (setq visited (list file wildcards))))
              ((symbol-function 'file-open-new-frame)
               (lambda (file &optional wildcards)
                 (setq framed (list file wildcards)))))
      (my/find-file-with-frame-choice)
      (should (equal visited '("/tmp/new-file.md" t)))
      (should-not framed))
    (setq visited nil)
    (cl-letf (((symbol-function 'find-file-read-args)
               (lambda (&rest _)
                 (my/minibuffer-open-new-frame)
                 (list "/tmp/new-file.md" t)))
              ((symbol-function 'my/minibuffer-file-completion-p)
               (lambda () t))
              ((symbol-function 'exit-minibuffer)
               (lambda () nil))
              ((symbol-function 'find-file)
               (lambda (&rest _) (setq visited t)))
              ((symbol-function 'file-open-new-frame)
               (lambda (file &optional wildcards)
                 (setq framed (list file wildcards)))))
      (let ((vertico--input nil))
        (my/find-file-with-frame-choice))
      (should-not visited)
      (should (equal framed '("/tmp/new-file.md" t))))))

(ert-deftest file-open-prompt-splits-at-the-selected-window ()
  "File prompt modifiers open the same target beside the source pane."
  (let ((file (make-temp-file "file-open-split-" nil ".txt")))
    (unwind-protect
        (progn
          (with-temp-file file (insert "split target\n"))
          (dolist (case '((right . right) (below . below)))
            (save-window-excursion
              (delete-other-windows)
              (let ((source (selected-window))
                    (source-buffer (window-buffer)))
                (cl-letf (((symbol-function 'find-file-read-args)
                           (lambda (&rest _)
                             (setq my/file-open-placement (car case))
                             (list file nil))))
                  (my/find-file-with-frame-choice))
                (should (eq (window-buffer source) source-buffer))
                (should (file-equal-p (buffer-file-name (window-buffer)) file))
                (should (= (length (window-list)) 2))
                (let ((opened (selected-window)))
                  (if (eq (cdr case) 'right)
                      (should (> (car (window-edges opened))
                                 (car (window-edges source))))
                    (should (> (cadr (window-edges opened))
                               (cadr (window-edges source))))))))))
      (when-let* ((buffer (get-file-buffer file))) (kill-buffer buffer))
      (delete-file file))))

(ert-deftest file-open-prompt-modifier-exits-vertico-with-candidate ()
  "The split key must reach both file and terminal prompts through Vertico."
  (require 'vertico)
  (let ((my/file-open-new-frame-prompt t)
        (my/file-open-placement 'current)
        (vertico--input t)
        exited)
    (cl-letf (((symbol-function 'my/minibuffer-file-completion-p)
               (lambda () t))
              ((symbol-function 'minibuffer-contents-no-properties)
               (lambda () "/tmp/existing-choice.txt"))
              ((symbol-function 'file-exists-p)
               (lambda (&rest _) t))
              ((symbol-function 'vertico-exit)
               (lambda (&rest _) (setq exited 'candidate))))
      (my/minibuffer-open-right)
      (should (eq my/file-open-placement 'right))
      (should (eq exited 'candidate))
      (my/minibuffer-open-below)
      (should (eq my/file-open-placement 'below))))
  (let ((my/terminal-selector-active t)
        selected)
    (cl-letf (((symbol-function 'my/terminal-selector-exit)
               (lambda (placement) (setq selected placement))))
      (my/minibuffer-open-below)
      (should (eq selected 'below)))))

(ert-deftest file-open-prompt-command-return-keeps-new-name-literal ()
  "Command+Return on a new file must not select a similar existing file."
  (let ((my/file-open-new-frame-prompt t)
        (my/file-open-placement 'current)
        (vertico--input t)
        exited)
    (cl-letf (((symbol-function 'my/minibuffer-file-completion-p)
               (lambda () t))
              ((symbol-function 'minibuffer-contents-no-properties)
               (lambda () "/tmp/new-precise-name.txt"))
              ((symbol-function 'file-exists-p)
               (lambda (&rest _) nil))
              ((symbol-function 'vertico-exit-input)
               (lambda () (setq exited 'input)))
              ((symbol-function 'vertico-exit)
               (lambda (&rest _) (setq exited 'candidate))))
      (my/minibuffer-open-below)
      (should (eq exited 'input))
      (should (eq my/file-open-placement 'current)))))

(ert-deftest consult-buffer-chooser-opens-in-selected-pane ()
  "Consult buffer and file choices share the placement chosen in its prompt."
  (require 'vertico)
  (let ((buffer (generate-new-buffer "consult-placement-choice"))
        (file (make-temp-file "consult-placement-file-" nil ".txt")))
    (unwind-protect
        (dolist (case `((right . ,buffer) (below . ,file)))
          (save-window-excursion
            (delete-other-windows)
            (let ((source (selected-window))
                  (source-buffer (window-buffer))
                  (vertico--input t))
              (cl-letf (((symbol-function 'vertico-exit) #'ignore)
                        ((symbol-function 'consult--multi)
                         (lambda (&rest _)
                           (if (eq (car case) 'right)
                               (my/minibuffer-open-right)
                             (my/minibuffer-open-below))
                           (if (bufferp (cdr case))
                               (consult--buffer-action (cdr case))
                             (consult--file-action (cdr case)))
                           '("chosen" :match t))))
                (consult-buffer))
              (should (eq (window-buffer source) source-buffer))
              (should (= (length (window-list)) 2))
              (if (bufferp (cdr case))
                  (should (eq (window-buffer) buffer))
                (should (file-equal-p (buffer-file-name (window-buffer)) file))))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (when-let* ((visited (get-file-buffer file))) (kill-buffer visited))
      (delete-file file))))

(ert-deftest consult-buffer-frame-choice-keeps-the-selected-source ()
  "A buffer or recent file chosen with Cmd+Shift+Return opens in a frame."
  (let ((buffer (generate-new-buffer "consult-frame-choice"))
        (file (make-temp-file "consult-frame-file-" nil ".txt"))
        displayed)
    (unwind-protect
        (dolist (choice (list buffer file))
          (let ((vertico--input t))
            (cl-letf (((symbol-function 'vertico-exit) #'ignore)
                      ((symbol-function 'my/buffer-display-new-frame)
                       (lambda (target &optional _norecord)
                         (setq displayed target)))
                      ((symbol-function 'consult--multi)
                       (lambda (&rest _)
                         (my/minibuffer-open-new-frame)
                         (if (bufferp choice)
                             (consult--buffer-action choice)
                           (consult--file-action choice))
                         '("chosen" :match t))))
              (consult-buffer))
            (if (bufferp choice)
                (should (eq displayed choice))
              (should (file-equal-p (buffer-file-name displayed) file)))))
      (when (buffer-live-p buffer) (kill-buffer buffer))
      (when-let* ((visited (get-file-buffer file))) (kill-buffer visited))
      (delete-file file))))

(ert-deftest file-open-prompt-uses-one-target-for-both-keys ()
  "Enter and Cmd+Shift+Enter differ only in their destination frame."
  (let ((default-directory "/fs:prompt-audit:/work/")
        visited framed visit-directory)
    (cl-letf (((symbol-function 'find-file-read-args)
               (lambda (&rest _) (list "/tmp/new-file.txt" t)))
              ((symbol-function 'find-file)
               (lambda (file &optional _wildcards)
                 (setq visited file visit-directory default-directory)))
              ((symbol-function 'file-open-new-frame)
               (lambda (file &optional _wildcards) (setq framed file))))
      (my/find-file-with-frame-choice)
      (should (equal visited "/tmp/new-file.txt"))
      (should (equal visit-directory temporary-file-directory))
      (should-not framed)
      (cl-letf (((symbol-function 'find-file-read-args)
                 (lambda (&rest _)
                   (setq my/file-open-new-frame-requested t)
                   (list "/tmp/new-file.txt" t))))
        (my/find-file-with-frame-choice))
      (should (equal framed visited)))))

(ert-deftest file-open-prompt-visits-local-file-from-logical-buffer ()
  "A native absolute file chosen in a remote buffer opens locally."
  (let* ((file (make-temp-file "prompt-logical-open-" nil ".txt"))
         visited)
    (unwind-protect
        (progn
          (with-temp-file file (insert "prompt target\n"))
          (with-temp-buffer
            (setq default-directory "/fs:prompt-audit:/work/")
            (let ((source (current-buffer)))
              (cl-letf (((symbol-function 'completing-read)
                         (lambda (&rest _) file)))
                (setq visited (my/find-file-with-frame-choice)))
              (should (eq (current-buffer) visited))
              (should (equal (buffer-local-value 'default-directory source)
                             "/fs:prompt-audit:/work/"))))
          (should (buffer-live-p visited))
          (should-not (file-remote-p (buffer-file-name visited)))
          (should (file-equal-p (buffer-file-name visited) file))
          (should-not (file-remote-p
                       (buffer-local-value 'default-directory visited))))
      (when (buffer-live-p visited) (kill-buffer visited))
      (delete-file file))))

(ert-deftest file-open-prompt-opens-local-directory-from-remote-buffer ()
  "Switching to a local Dired folder leaves the remote source unchanged."
  (let ((directory (make-temp-file "prompt-local-dir-" t))
        visited)
    (unwind-protect
        (with-temp-buffer
          (setq default-directory "/fs:prompt-audit:/work/")
          (let ((source (current-buffer)))
            (cl-letf (((symbol-function 'find-file-read-args)
                       (lambda (&rest _) (list directory nil))))
              (setq visited (my/find-file-with-frame-choice)))
            (should (eq (current-buffer) visited))
            (should (equal (buffer-local-value 'default-directory source)
                           "/fs:prompt-audit:/work/")))
          (with-current-buffer visited
            (should (derived-mode-p 'dired-mode))
            (should-not (file-remote-p default-directory))
            (should (file-equal-p default-directory directory))))
      (when (buffer-live-p visited) (kill-buffer visited))
      (delete-directory directory t))))

(ert-deftest file-open-frame-keymaps-cover-native-and-vertico-prompts ()
  (require 'vertico)
  (should (eq (lookup-key global-map (kbd "C-x C-f"))
              #'file-open))
  (should (commandp 'file-open))
  (with-current-buffer (get-buffer "*scratch*")
    (evil-normal-state)
    (should (eq (key-binding (kbd "SPC f f")) #'file-open)))
  (when (eq system-type 'darwin)
    (should (eq (key-binding (kbd "H-f")) #'file-open)))
  (dolist (key '("M-S-RET" "M-S-<return>"))
    (should (eq (lookup-key vertico-map (kbd key))
                #'my/minibuffer-open-new-frame))
    (should (eq (lookup-key minibuffer-local-filename-completion-map
                            (kbd key))
                #'my/minibuffer-open-new-frame)))
  (dolist (entry '(("S-RET" . my/minibuffer-open-right)
                   ("S-<return>" . my/minibuffer-open-right)
                   ("M-RET" . my/minibuffer-open-below)
                   ("M-<return>" . my/minibuffer-open-below)
                   ("s-RET" . my/minibuffer-open-below)
                   ("s-<return>" . my/minibuffer-open-below)))
    (should (eq (lookup-key vertico-map (kbd (car entry))) (cdr entry)))
    (should (eq (lookup-key minibuffer-local-filename-completion-map
                            (kbd (car entry)))
                (cdr entry))))
  (should (eq (lookup-key vertico-map (kbd "C-RET"))
              #'vertico-exit-input))
  (should (commandp 'file-open-new-frame)))

(ert-deftest file-open-new-frame-cleans-up-failed-visit ()
  (let (deleted refocused)
    (cl-letf (((symbol-function 'my/frame-new)
               (lambda () (selected-frame)))
              ((symbol-function 'find-file)
               (lambda (&rest _) (error "Visit failed")))
              ((symbol-function 'delete-frame)
               (lambda (&rest _) (setq deleted t)))
              ((symbol-function 'select-frame-set-input-focus)
               (lambda (_frame) (setq refocused t))))
      (should-error (file-open-new-frame "/tmp/missing-file.md"))
      (should deleted)
      (should refocused))))

(ert-deftest file-open-new-frame-resolves-relative-path-before-frame ()
  (let ((default-directory "/tmp/")
        opened)
    (cl-letf (((symbol-function 'my/frame-open-with)
               (lambda (visit) (funcall visit)))
              ((symbol-function 'find-file)
               (lambda (file &optional wildcards)
                 (setq opened (list file wildcards find-file-run-dired)))))
      (file-open-new-frame "frame-new.md" t))
    (should (equal opened '("/tmp/frame-new.md" t t)))))

(ert-deftest file-open-new-frame-keeps-the-source-target ()
  "Relative and explicit logical names keep their target across frames."
  (let ((default-directory "/fs:frame-audit:/work/")
        opened)
    (cl-letf (((symbol-function 'my/frame-open-with)
               (lambda (visit) (funcall visit)))
              ((symbol-function 'find-file)
               (lambda (file &optional _wildcards)
                 (push file opened))))
      (file-open-new-frame "/tmp/new-note.md")
      (file-open-new-frame "notes/new-note.md")
      (file-open-new-frame "/fs:other-audit:/tmp/../new-note.md"))
    (should (equal (nreverse opened)
                   '("/tmp/new-note.md"
                     "/fs:frame-audit:/work/notes/new-note.md"
                     "/fs:other-audit:/new-note.md")))))

(ert-deftest file-open-new-frame-visits-local-file-from-logical-buffer ()
  "A native absolute name must work with `find-file' from a remote buffer."
  (let* ((file (make-temp-file "frame-logical-open-" nil ".txt"))
         (default-directory "/fs:frame-audit:/work/")
         visited)
    (unwind-protect
        (progn
          (with-temp-file file (insert "frame target\n"))
          (cl-letf (((symbol-function 'my/frame-open-with)
                     (lambda (visit) (funcall visit))))
            (setq visited (file-open-new-frame file)))
          (should (buffer-live-p visited))
          (should-not (file-remote-p (buffer-file-name visited)))
          (should (file-equal-p (buffer-file-name visited) file)))
      (when (buffer-live-p visited) (kill-buffer visited))
      (delete-file file))))

(ert-deftest buffer-open-new-frame-uses-consult-buffer-sources ()
  (let (sources scope display)
    (cl-letf (((symbol-function 'consult--multi)
               (lambda (chosen-sources &rest _args)
                 (setq sources chosen-sources
                       scope consult-buffer-list-function
                       display consult--buffer-display)
                 (cons "unused" '(:match t)))))
      (buffer-open-new-frame))
    (should (equal sources '(consult-source-buffer
                             consult-source-other-buffer
                             consult-source-hidden-buffer)))
    (should (eq scope #'my/consult-buffer-list))
    (should (eq display #'my/buffer-display-new-frame))
    (should (commandp 'buffer-open-new-frame))
    (with-current-buffer (get-buffer "*scratch*")
      (evil-normal-state)
      (should (eq (key-binding (kbd "SPC b F"))
                  #'buffer-open-new-frame)))
    (should (eq (lookup-key global-map (kbd "C-x 5 b"))
                #'switch-to-buffer-other-frame))))

(ert-deftest buffer-open-new-frame-uses-neutral-frame-factory ()
  (let ((buffer (generate-new-buffer "frame-buffer-visit"))
        focused)
    (unwind-protect
        (save-window-excursion
          (cl-letf (((symbol-function 'my/frame-new)
                     (lambda () (selected-frame)))
                    ((symbol-function 'select-frame-set-input-focus)
                     (lambda (_frame) (setq focused t))))
            (should (eq (my/buffer-display-new-frame buffer) buffer))
            (should focused)))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

(ert-deftest buffer-open-new-frame-moves-portal-instead-of-sharing-it ()
  (let ((buffer (generate-new-buffer "frame-portal-visit"))
        moved)
    (unwind-protect
        (progn
          (require 'portal-view)
          (with-current-buffer buffer
            (setq-local portal-view--target "terminal:test"))
          (cl-letf (((symbol-function 'my/frame-open-with)
                     (lambda (visit) (funcall visit)))
                    ((symbol-function 'my/portal-move-buffer-to-window)
                     (lambda (target window)
                       (setq moved (list target window)))))
            (should (eq (my/buffer-display-new-frame buffer) buffer))
            (should (equal moved (list buffer (selected-window))))))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

(ert-deftest buffer-open-new-frame-keeps-old-frame-with-another-pane ()
  "Moving a terminal must leave its old frame's other pane intact."
  (let ((buffer (generate-new-buffer "frame-portal-owner"))
        (other (generate-new-buffer "frame-portal-other"))
        (frame (selected-frame))
        (old-owner (frame-parameter (selected-frame) 'my/portal-terminal))
        deleted)
    (unwind-protect
        (save-window-excursion
          (require 'portal-view)
          (with-current-buffer buffer
            (setq-local portal-view--target "terminal:owner"))
          (delete-other-windows)
          (switch-to-buffer buffer)
          (set-window-buffer (split-window-right) other)
          (set-frame-parameter frame 'my/portal-terminal buffer)
          (cl-letf (((symbol-function 'my/frame-open-with)
                     (lambda (visit) (funcall visit)))
                    ((symbol-function 'my/portal-move-buffer-to-window)
                     (lambda (&rest _) buffer))
                    ((symbol-function 'delete-frame)
                     (lambda (&rest _) (setq deleted t))))
            (should (eq (my/buffer-display-new-frame buffer) buffer)))
          (should-not deleted)
          (should-not (frame-parameter frame 'my/portal-terminal)))
      (set-frame-parameter frame 'my/portal-terminal old-owner)
      (dolist (entry (list buffer other))
        (when (buffer-live-p entry) (kill-buffer entry))))))

(ert-deftest buffer-open-new-frame-releases-popup-terminal ()
  (let ((buffer (generate-new-buffer "frame-popup-visit"))
        moved)
    (unwind-protect
        (progn
          (require 'init-portal-popup)
          (with-current-buffer buffer
            (setq-local my/portal-popup-instance-p t))
          (cl-letf (((symbol-function 'my/frame-open-with)
                     (lambda (visit) (funcall visit)))
                    ((symbol-function 'my/portal-popup-move-buffer-to-window)
                     (lambda (target window)
                       (setq moved (list target window)))))
            (should (eq (my/buffer-display-new-frame buffer) buffer))
            (should (equal moved (list buffer (selected-window))))))
      (when (buffer-live-p buffer) (kill-buffer buffer)))))

(ert-deftest buffer-open-new-frame-splits-noema-without-sharing-xwidget ()
  (let ((buffer (generate-new-buffer "*Noema: frame-page.md*"))
        (file "/tmp/frame-page.md")
        split)
    (unwind-protect
        (progn
          (with-current-buffer buffer
            (setq major-mode 'xwidget-webkit-mode)
            (setq-local my/noema-buffer-file-name file))
          (cl-letf (((symbol-function 'my/frame-new)
                     (lambda () (error "Should not create a generic frame")))
                    ((symbol-function 'my/noema-open-file-split-frame)
                     (lambda (path) (setq split path))))
            (my/buffer-display-new-frame buffer))
          (should (equal split file)))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

(ert-deftest buffer-open-new-frame-rejects-other-xwidget-sharing ()
  (let ((buffer (generate-new-buffer "*Browser xwidget*")))
    (unwind-protect
        (progn
          (with-current-buffer buffer
            (setq major-mode 'xwidget-webkit-mode))
          (should-error (my/buffer-display-new-frame buffer)
                        :type 'user-error))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))))

