;;; pi-project-tabs-tests.el --- Pi management follows its project -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'tools/agent/manager)
(require 'tools/agent/menu)
(require 'noema-pi-router)

(defun pi-project-tabs-tests--buffer (name root origin &optional provider)
  "Make an isolated real agent buffer and local pipe, without a model."
  (let* ((buffer (generate-new-buffer (format "*Pi scope test %s*" name)))
         (process (make-pipe-process :name (buffer-name buffer) :noquery t)))
    (with-current-buffer buffer
      (setq major-mode 'agent-shell-mode)
      (setq-local default-directory root +agent-acp-session-root root
                  +agent-acp-session-name name +agent-acp-session-agent (or provider "codex")
                  +agent-acp-session-origin origin
                  agent-shell--state (agent-shell--make-state :buffer buffer :agent-config '((:identifier . codex))))
      (setf (map-elt agent-shell--state :client) (list (cons :process process))
            (map-elt agent-shell--state :init-finished) t
            (map-elt (map-elt agent-shell--state :session) :id) name)
      (when (eq (+agent-session-kind buffer) 'pi)
        (setq-local noema-pi-router--scope (if (eq origin 'pi-emacs) "emacs" root)))
      (add-hook 'kill-buffer-hook (lambda () (when (process-live-p process) (delete-process process))) nil t))
    buffer))

(defmacro pi-project-tabs-tests--pool (&rest body)
  (declare (indent 0))
  `(let* ((temporary (file-name-as-directory (make-temp-file "pi-project-tabs-" t)))
          (root (expand-file-name "a/" temporary)) (other-root (expand-file-name "b/" temporary))
          (noema-pi-agent-directory (expand-file-name "pi-state/" temporary))
          (noema-pi-router--buffers (make-hash-table :test #'equal))
          (noema-pi-router--emacs-buffer nil)
          (+agent-acp-notify-function nil)
          (source (generate-new-buffer "*Pi scoped editor fixture*"))
          worker engine child main other workers)
     (make-directory root t) (make-directory other-root t)
     (setq worker (pi-project-tabs-tests--buffer "manual/codex" root 'manual)
           engine (pi-project-tabs-tests--buffer "manual/pi" root 'manual "pi")
           child (pi-project-tabs-tests--buffer "pi" root 'pi-project "pi")
           main (pi-project-tabs-tests--buffer "pi/emacs" root 'pi-emacs "pi")
           other (pi-project-tabs-tests--buffer "other/pi" other-root 'pi-project "pi")
           workers (list worker engine child main other)
           noema-pi-router--emacs-buffer main)
     (puthash root child noema-pi-router--buffers)
     (puthash other-root other noema-pi-router--buffers)
     (save-window-excursion
       (unwind-protect
           (progn
             (with-current-buffer source (setq-local default-directory root) (insert "one\ntwo\n"))
             (switch-to-buffer source)
             ,@body)
         (dolist (buffer workers)
           (when (buffer-live-p buffer) (+agent-acp-kill buffer)))
         (when-let* ((view (get-buffer "*Pi Sessions*"))) (kill-buffer view))
         (kill-buffer source)
         (delete-directory temporary t)))))

(ert-deftest pi-project-c17-tabs-and-pools-separate-managed-pi-from-execution-engines ()
  (pi-project-tabs-tests--pool
    (let ((all (+agent-acp-sessions)))
      (should (memq child (mapcar (lambda (s) (plist-get s :buffer)) all)))
      (should (= 5 (length (+agent-pool-sessions nil nil 'all))))
      (should (= 2 (length (+agent-pool-sessions root))))
      (should (= 2 (length (+agent-pool-sessions root nil 'pi))))
      (should (= 2 (length (+agent-manager--sessions all 'all nil "")))))
    (with-current-buffer worker
      (should (equal (+agent-acp--project-buffers root) (list worker engine)))
      (let ((tabs (+agent-acp--tab-line)))
        (should (string-match-p "Agents" tabs))
        (should-not (string-match-p "pi/emacs" tabs))))
    (with-current-buffer child
      (should (equal (+agent-acp--project-buffers root) (list child)))
      (should (string-prefix-p " Pi " (+agent-acp--tab-line)))
      (should-not (string-match-p "manual/" (+agent-acp--tab-line))))
    (with-current-buffer main
      (should (equal (+agent-acp--project-buffers root) (list main))))))

(ert-deftest pi-project-c17-manager-menu-and-history-use-the-pi-owner ()
  (pi-project-tabs-tests--pool
    (let (opened ordinary)
      (cl-letf (((symbol-function 'noema-pi-sessions)
                 (lambda (&optional _) (interactive "P") (push (noema-pi-sessions--context-scope) opened)))
                ((symbol-function '+agent/manager) (lambda (&optional _) (interactive) (setq ordinary t))))
        (with-current-buffer child
          (+agent-acp-session-manager)
          (+agent-acp-switch-session)
          (+agent-session-menu)
          (+agent-menu-history))
        (should (equal opened (make-list 4 root)))
        (should-not ordinary)
        (with-current-buffer main (+agent-acp-session-manager))
        (should (equal (car opened) "emacs"))
        (with-current-buffer worker (+agent-acp-session-manager))
        (should ordinary)))))

(ert-deftest pi-project-c17-next-tab-and-bulk-close-do-not-cross-management-domains ()
  (pi-project-tabs-tests--pool
    (let (shown closed)
      (cl-letf (((symbol-function '+agent-acp-show-buffer) (lambda (buffer) (setq shown buffer)))
                ((symbol-function '+agent-acp-confirm-stop) (lambda (&rest _) t))
                ((symbol-function '+agent-acp-kill) (lambda (buffer) (push buffer closed))))
        (with-current-buffer child (+agent-acp-next-session))
        (should (eq shown child))
        (+agent-acp-close-others worker)
        (should (equal closed (list engine)))
        (setq closed nil)
        (+agent-acp-close-others child)
        (should-not closed)))))

(ert-deftest pi-project-c17-project-stop-does-not-stop-managed-pi ()
  (pi-project-tabs-tests--pool
    (dolist (buffer (list worker child main other))
      (with-current-buffer buffer (setf (map-elt agent-shell--state :active-requests) '(((:method . "session/prompt"))))))
    (let (stopped)
      (cl-letf (((symbol-function '+agent-acp-stop) (lambda (buffer) (push buffer stopped))))
        (should (= (+agent-pool-stop root) 1))
        (should (equal stopped (list worker)))))))

(ert-deftest pi-project-c17-execution-names-cannot-retire-or-resolve-project-pi ()
  (pi-project-tabs-tests--pool
    (+agent-acp-mark-session-buffer worker "pi" "codex" root)
    (should (equal (buffer-local-value '+agent-acp-session-name child) "pi"))
    (should-not (+agent-acp-retired-p child))
    (with-current-buffer worker (should (eq (+agent-acp-session-buffer "pi" root) worker)))
    (with-current-buffer child (should (eq (+agent-acp-session-buffer "pi" root child) child)))))

(ert-deftest pi-project-c17-history-state-and-lookup-include-scope-not-only-native-id ()
  (pi-project-tabs-tests--pool
    (dolist (buffer (list child main other))
      (with-current-buffer buffer (setf (map-elt (map-elt agent-shell--state :session) :id) "same-native")))
    (let ((record (noema-pi-sessions-import-native root "same-native" "fixture")))
      (noema-pi-sessions-import-native other-root "same-native" "fixture")
      (noema-pi-sessions-import-native "emacs" "same-native" "fixture")
      (should (eq (noema-pi-sessions--buffer record) child)))
    (with-current-buffer other (setq-local +agent-acp-last-error "only project B failed"))
    (with-current-buffer (get-buffer-create "*Pi Sessions*")
      (noema-pi-sessions-mode)
      (setq noema-pi-sessions--scope root)
      (noema-pi-sessions-refresh)
      (should (= (length tabulated-list-entries) 1))
      (should (equal (aref (cadr (car tabulated-list-entries)) 2) "ready"))
      (setq noema-pi-sessions--scope nil)
      (noema-pi-sessions-refresh)
      (should (= (length tabulated-list-entries) 3)))))

(ert-deftest pi-project-c17-project-view-follows-project-switch-global-view-does-not ()
  (pi-project-tabs-tests--pool
    (with-current-buffer (get-buffer-create "*Pi Sessions*")
      (noema-pi-sessions-mode)
      (setq noema-pi-sessions--scope root)
      (noema-pi-sessions--project-activated other-root)
      (should (equal noema-pi-sessions--scope (noema-pi-project-root other-root)))
      (setq noema-pi-sessions--scope "emacs")
      (noema-pi-sessions--project-activated root)
      (should (equal noema-pi-sessions--scope "emacs"))
      (setq noema-pi-sessions--scope nil)
      (noema-pi-sessions--project-activated root)
      (should-not noema-pi-sessions--scope))))

(ert-deftest pi-project-c17-empty-project-new-keeps-that-project-scope ()
  (pi-project-tabs-tests--pool
    (let (created)
      (with-current-buffer (get-buffer-create "*Pi Sessions*")
        (noema-pi-sessions-mode)
        (setq noema-pi-sessions--scope other-root)
        (cl-letf (((symbol-function 'tabulated-list-get-id) (lambda () nil))
                  ((symbol-function 'noema-pi-sessions-new) (lambda (scope) (setq created scope))))
          (noema-pi-sessions-new-at-point)
          (should (equal created other-root)))))))

(ert-deftest pi-project-c17-editor-entry-is-project-scoped-and-all-is-explicit ()
  (pi-project-tabs-tests--pool
    (with-current-buffer source
      (setq-local buffer-file-name (expand-file-name "source.md" root))
      (set-buffer-modified-p nil))
    (switch-to-buffer source)
    (cl-letf (((symbol-function '+agent-acp-start) (lambda (&rest _) (ert-fail "History query started a client"))))
      (noema-pi-sessions)
      (should (equal (buffer-local-value 'noema-pi-sessions--scope (get-buffer "*Pi Sessions*"))
                     (noema-pi-project-root root)))
      (noema-pi-sessions t)
      (should-not (buffer-local-value 'noema-pi-sessions--scope (get-buffer "*Pi Sessions*"))))))

(ert-deftest pi-project-c17-new-action-keeps-the-management-scope ()
  (pi-project-tabs-tests--pool
    (let (created execution)
      (cl-letf (((symbol-function 'noema-pi-sessions-new) (lambda (scope) (push scope created)))
                ((symbol-function '+agent/start) (lambda (&optional _) (interactive) (setq execution t))))
        (with-current-buffer child (+agent-menu-new))
        (with-current-buffer main (+agent-menu-new))
        (should (equal created (list "emacs" root)))
        (should-not execution)
        (with-current-buffer engine (+agent-menu-new))
        (should execution)
        (setq execution nil)
        (cl-letf (((symbol-function '+agent-acp-command-buffer) (lambda (&optional _) child)))
          (with-current-buffer source (+agent-menu-new)))
        (should execution)
        (should (= (length created) 2))
        (with-current-buffer (get-buffer-create "*Pi Sessions*")
          (noema-pi-sessions-mode)
          (setq noema-pi-sessions--scope other-root)
          (+agent-menu-new))
        (should (equal (car created) other-root))))))

(provide 'pi-project-tabs-tests)
