;;; pi-idle-benchmark.el --- Local Pi cost counters, no models -*- lexical-binding: t; -*-
;; Run with make pi-idle-benchmark in an isolated batch Emacs.
(unless noninteractive (user-error "Run this benchmark in an isolated batch Emacs"))
(require 'benchmark)
(require 'noema-pi-router)
(defun pi-idle-benchmark-run ()
  (let* ((temporary (make-temp-file "pi-idle-bench-" t))
         (noema-pi-agent-directory temporary)
         (noema-pi-router--emacs-buffer nil)
         (noema-pi-router--buffers (make-hash-table :test #'equal))
         (source (generate-new-buffer "*Pi idle benchmark source*"))
         (view (generate-new-buffer "*Pi Sessions*"))
         fillers metrics)
    (unwind-protect
        (save-window-excursion
          (let ((store (noema-pi-sessions--empty)))
            (dotimes (index 300) (noema-pi-sessions--record store "emacs" (format "fixture-%d" index)))
            (noema-pi-sessions--write store))
          (let ((parses 0) (parser (symbol-function 'json-parse-buffer)))
            (cl-letf (((symbol-function 'json-parse-buffer)
                       (lambda (&rest args) (cl-incf parses) (apply parser args))))
              (let ((time (benchmark-run 100 (noema-pi-sessions-records))))
                (push (list :metadata-reads 100 :json-parses parses :seconds (car time)) metrics))))
          (with-current-buffer source (setq-local +agent-acp-session-origin 'pi-emacs))
          (setq noema-pi-router--emacs-buffer source)
          (let ((writes 0) (writer (symbol-function 'noema-pi-sessions--write)))
            (cl-letf (((symbol-function 'noema-pi-sessions--write)
                       (lambda (value) (cl-incf writes) (funcall writer value)))
                      ((symbol-function '+agent-acp-state-value)
                       (lambda (_buffer path &optional _default)
                         (pcase path ('(:session :id) "fixture-299")
                                ('(:resume-session-id) "fixture-299") ('(:request-count) 0)))))
              (let ((time (benchmark-run 100 (noema-pi-router--remember "emacs" source))))
                (push (list :same-generation-observations 100 :writes writes :seconds (car time)) metrics))))
          (with-current-buffer view (noema-pi-sessions-mode))
          (set-window-buffer (selected-window) view)
          (let ((redraws 0))
            (cl-letf (((symbol-function 'noema-pi-sessions-refresh) (lambda () (cl-incf redraws))))
              (dotimes (_ 200) (noema-pi-sessions--refresh-visible source))
              (accept-process-output nil 0.25)
              (push (list :view-events 200 :redraws redraws) metrics)))
          (dotimes (_ 300) (push (generate-new-buffer " *idle-filler*") fillers))
          (let ((checks 0) (predicate (symbol-function '+agent-acp-agent-buffer-p))
                (+agent-acp--warm-sweep-timer nil))
            (cl-letf (((symbol-function '+agent-acp-agent-buffer-p)
                       (lambda (buffer) (cl-incf checks) (funcall predicate buffer))))
              (dotimes (_ 200) (+agent-acp--sync-warm-sweep source))
              (push (list :pi-state-events 200 :retention-buffer-checks checks) metrics)))
          (princ (format "PI_IDLE_BENCHMARK %S\n" (nreverse metrics))))
      (kill-buffer view) (kill-buffer source)
      (mapc #'kill-buffer fillers)
      (delete-directory temporary t))))
(pi-idle-benchmark-run)
