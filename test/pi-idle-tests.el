;;; pi-idle-tests.el --- Pi lifetime and idle work contracts -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'noema-pi-router)

(defmacro pi-idle-tests--store (&rest body)
  (declare (indent 0))
  `(let* ((temporary (make-temp-file "pi-idle-test-" t))
          (noema-pi-agent-directory temporary)
          (noema-pi-sessions--cache-file nil) (noema-pi-sessions--cache-signature nil)
          (noema-pi-sessions--cache-store nil) (noema-pi-sessions--cache-json nil)
          (noema-pi-router--emacs-buffer nil)
          (noema-pi-router--buffers (make-hash-table :test #'equal)))
     (unwind-protect (progn ,@body) (delete-directory temporary t))))

(defun pi-idle-tests--fire (timer)
  "Execute one captured timer deterministically, as the command loop would."
  (let ((function (timer--function timer)) (arguments (timer--args timer)))
    (cancel-timer timer)
    (apply function arguments)))

(ert-deftest pi-idle-c12-latest-project-is-prewarmed-once-after-idle ()
  (let ((noema-pi-assistant-mode t) (noninteractive nil)
        (noema-pi-router--startup-timer nil) (noema-pi-router--pending-project nil)
        (+project-active-root nil) (parents 0) children)
    (unwind-protect
        (cl-letf (((symbol-function 'noema-pi-emacs-ensure) (lambda (&optional focus) (should-not focus) (cl-incf parents)))
                  ((symbol-function 'noema-pi-project-ensure) (lambda (root) (push root children))))
          (noema-pi-router--startup)
          (let ((timer noema-pi-router--startup-timer))
            (noema-pi-router--project-activated "/tmp/first/")
            (noema-pi-router--project-activated "/tmp/latest/")
            (should (eq timer noema-pi-router--startup-timer))
            (should (= parents 0))
            (pi-idle-tests--fire timer))
          (should (= parents 1))
          (should (equal children '("/tmp/latest/")))
          (should-not noema-pi-router--startup-timer)
          (should-not noema-pi-router--pending-project))
      (noema-pi-router--cancel-startup))))

(ert-deftest pi-idle-c12-disable-cancels-work-without-ending-existing-clients ()
  (let ((noema-pi-assistant-mode t) (noninteractive nil)
        (noema-pi-router--startup-timer nil) (noema-pi-router--pending-project nil)
        (emacs-startup-hook emacs-startup-hook) (+project-activated-hook +project-activated-hook))
    (unwind-protect
        (cl-letf (((symbol-function '+agent-acp-shutdown) (lambda (_) (ert-fail "Disabling closed a client"))))
          (noema-pi-router--project-activated "/tmp/project/")
          (let ((timer noema-pi-router--startup-timer))
            (noema-pi-assistant-mode -1)
            (should-not (memq timer timer-idle-list))
            (should-not noema-pi-router--pending-project)
            (should-not noema-pi-router--startup-timer)))
      (noema-pi-router--cancel-startup))))

(ert-deftest pi-idle-c13-history-is-single-flight-and-repeated-turns-do-not-write ()
  (pi-idle-tests--store
    (with-temp-buffer
      (let ((generation 0) (queries 0) (writes 0) callback)
        (cl-letf (((symbol-function '+agent-acp-state-value)
                   (lambda (_ path &optional _default)
                     (pcase path ('(:session :id) "native") ('(:request-count) generation))))
                  ((symbol-function '+agent-acp-list-native-sessions)
                   (lambda (_ fn &optional _) (cl-incf queries) (setq callback fn)))
                  ((symbol-function 'noema-pi-sessions-observe) (lambda (&rest _) (cl-incf writes))))
          (dotimes (_ 100) (noema-pi-router--remember "emacs" (current-buffer)))
          (should (= queries 1))
          (setq generation 1)
          (noema-pi-router--remember "emacs" (current-buffer))
          (funcall callback '(((sessionId . "native"))) nil)
          (should (= queries 1))
          (should (= writes 2))
          (dotimes (_ 100) (noema-pi-router--remember "emacs" (current-buffer)))
          (should (= writes 2))
          (should-not noema-pi-router--history-request))))))

(ert-deftest pi-idle-c13-released-or-replaced-clients-cannot-change-active-history ()
  (pi-idle-tests--store
    (with-temp-buffer
      (let ((buffer (current-buffer)) callback)
        (setq-local noema-pi-router--scope "emacs")
        (setq noema-pi-router--emacs-buffer buffer)
        (cl-letf (((symbol-function '+agent-acp-state-value)
                   (lambda (_ path &optional _default) (pcase path ('(:session :id) "old") ('(:request-count) 1))))
                  ((symbol-function '+agent-acp-list-native-sessions) (lambda (_ fn &optional _) (setq callback fn))))
          (noema-pi-router--remember "emacs" buffer)
          (setq noema-pi-router--emacs-buffer nil)
          (funcall callback '(((sessionId . "old"))) nil)
          (should-not (noema-pi-sessions-records))
          (setq noema-pi-router--emacs-buffer buffer)
          (noema-pi-router--remember "emacs" buffer)
          (noema-pi-router--release buffer)
          (funcall callback '(((sessionId . "old"))) nil)
          (should-not (noema-pi-sessions-records)))))))

(ert-deftest pi-idle-c13-synchronous-history-error-releases-request-ownership ()
  (pi-idle-tests--store
    (with-temp-buffer
      (cl-letf (((symbol-function '+agent-acp-state-value)
                 (lambda (_ path &optional _default) (when (equal path '(:session :id)) "native")))
                ((symbol-function '+agent-acp-list-native-sessions) (lambda (&rest _) (error "Transport unavailable"))))
        (should-error (noema-pi-router--remember "emacs" (current-buffer)))
        (should-not noema-pi-router--history-request)))))

(ert-deftest pi-idle-c13-claim-bursts-do-not-probe-project-or-reset-deadline ()
  (let ((buffer (generate-new-buffer "*Pi claim lifetime test*")) (+noema--ready t)
        (probes 0) (claims 0))
    (unwind-protect
        (cl-letf (((symbol-function 'noema-project-root) (lambda (_) (cl-incf probes) "/tmp/project/"))
                  ((symbol-function 'noema-pi-router-claim)
                   (lambda (_ &optional complete) (cl-incf claims) (when complete (funcall complete))))
                  ((symbol-function '+agent-acp-state-value)
                   (lambda (_ path &optional _) (when (equal path '(:session :id)) "native"))))
          (noema-pi-router--schedule-claim "/tmp/project/" buffer)
          (let ((timer (buffer-local-value 'noema-pi-router--claim-timer buffer)))
            (dotimes (_ 200) (noema-pi-router--schedule-claim "/tmp/project/" buffer))
            (should (eq timer (buffer-local-value 'noema-pi-router--claim-timer buffer)))
            (should (= probes 0))
            (pi-idle-tests--fire timer)
            (should (= probes 1))
            (should (= claims 1)))
          (noema-pi-router--schedule-claim "/tmp/project/" buffer)
          (let ((timer (buffer-local-value 'noema-pi-router--claim-timer buffer)))
            (noema-pi-router--release buffer)
            (pi-idle-tests--fire timer)
            (should (= claims 1))))
      (kill-buffer buffer))))

(ert-deftest pi-idle-c13-shutdown-visits-snapshot-even-when-callback-removes-other-roots ()
  (let ((noema-pi-router--emacs-buffer nil) (noema-pi-router--buffers (make-hash-table :test #'equal))
        (one (generate-new-buffer "*Pi shutdown one*")) (two (generate-new-buffer "*Pi shutdown two*")) stopped)
    (unwind-protect
        (cl-letf (((symbol-function '+agent-acp-shutdown)
                   (lambda (buffer) (push buffer stopped) (clrhash noema-pi-router--buffers))))
          (puthash "one" one noema-pi-router--buffers)
          (puthash "two" two noema-pi-router--buffers)
          (noema-pi-router--shutdown-all)
          (should (= (length stopped) 2)))
      (kill-buffer one) (kill-buffer two))))

(ert-deftest pi-idle-c14-cache-validates-external-replacement-and-does-not-expose-mutable-records ()
  (pi-idle-tests--store
    (noema-pi-sessions-import-native "emacs" "one" "test")
    (puthash "nativeSessionId" "mutated-copy" (car (noema-pi-sessions-records)))
    (should (equal (noema-pi-sessions-active-native "emacs") "one"))
    (let* ((file (noema-pi-sessions--file)) (stamp (file-attribute-modification-time (file-attributes file)))
           (replacement (concat file ".external")))
      (with-temp-buffer
        (insert-file-contents file)
        (goto-char (point-min))
        (while (search-forward "one" nil t) (replace-match "two" t t))
        (write-region nil nil replacement nil 'silent))
      (set-file-times replacement stamp)
      (rename-file replacement file t)
      (should (equal (noema-pi-sessions-active-native "emacs") "two"))
      (write-region "corrupt" nil file nil 'silent)
      (should-error (noema-pi-sessions-records)))))

(ert-deftest pi-idle-c14-warm-queries-do-not-reparse-and-failed-writes-do-not-pollute-cache ()
  (pi-idle-tests--store
    (noema-pi-sessions-import-native "emacs" "original" "test")
    (cl-letf (((symbol-function 'json-parse-buffer) (lambda (&rest _) (ert-fail "Warm query parsed JSON again"))))
      (dotimes (_ 50) (should (equal (noema-pi-sessions-active-native "emacs") "original"))))
    (cl-letf (((symbol-function 'rename-file) (lambda (&rest _) (error "Cannot commit"))))
      (should-error (noema-pi-sessions-import-native "emacs" "uncommitted" "test")))
    (should (= (length (noema-pi-sessions-records)) 1))
    (should (equal (noema-pi-sessions-active-native "emacs") "original"))
    (should-not (directory-files temporary nil "sessions.json\\."))))

(ert-deftest pi-idle-c14-unchanged-store-does-not-write-again ()
  (pi-idle-tests--store
    (noema-pi-sessions-import-native "emacs" "native" "test")
    (cl-letf (((symbol-function 'rename-file) (lambda (&rest _) (ert-fail "Identical metadata was rewritten"))))
      (noema-pi-sessions--write (noema-pi-sessions--edit)))))

(ert-deftest pi-idle-c14-archive-does-not-overwrite-facts-arriving-during-close ()
  (pi-idle-tests--store
    (let ((record (noema-pi-sessions-import-native "emacs" "original" "test"))
          (buffer (generate-new-buffer "*Pi archive lifetime test*")))
      (unwind-protect
          (cl-letf (((symbol-function 'noema-pi-sessions--buffer) (lambda (_) buffer))
                    ((symbol-function '+agent-acp-close)
                     (lambda (b) (noema-pi-sessions-import-native "/tmp/other/" "other" "during-close") (kill-buffer b))))
            (noema-pi-sessions-archive record)
            (should (= (length (noema-pi-sessions-records)) 2))
            (should (equal (noema-pi-sessions-active-native "/tmp/other/") "other")))
        (when (buffer-live-p buffer) (kill-buffer buffer))))))

(ert-deftest pi-idle-c15-view-events-coalesce-and-hide-releases-ui-work ()
  (save-window-excursion
    (let ((view (generate-new-buffer "*Pi Sessions*")) (redraws 0))
      (unwind-protect
          (progn
            (with-current-buffer view (noema-pi-sessions-mode))
            (set-window-buffer (selected-window) view)
            (noema-pi-sessions--visibility-h)
            (cl-letf (((symbol-function 'noema-pi-sessions-refresh) (lambda () (cl-incf redraws))))
              (dotimes (_ 200) (noema-pi-sessions--refresh-visible))
              (let ((timer (buffer-local-value 'noema-pi-sessions--refresh-timer view)))
                (pi-idle-tests--fire timer)
                (should (= redraws 1)))
              (noema-pi-sessions--refresh-visible)
              (let ((timer (buffer-local-value 'noema-pi-sessions--refresh-timer view)))
                (set-window-buffer (selected-window) (get-buffer-create "*scratch*"))
                (noema-pi-sessions--visibility-h)
                (should-not (memq #'noema-pi-sessions--refresh-visible +agent-acp-changed-functions))
                (should-not (buffer-local-value 'noema-pi-sessions--refresh-timer view))
                (pi-idle-tests--fire timer)
                (should (= redraws 1)))))
        (kill-buffer view)))))

(ert-deftest pi-idle-c16-completion-is-deferred-and-client-release-cancels-it ()
  (with-temp-buffer
    (setq-local noema-pi-router--scope "emacs")
    (let ((noema-pi-router--emacs-buffer (current-buffer)) (observations 0))
      (cl-letf (((symbol-function 'noema-pi-router--remember) (lambda (&rest _) (cl-incf observations))))
        (unwind-protect
            (progn
              (dotimes (_ 50) (noema-pi-router--turn-complete (current-buffer) nil))
              (should (= observations 0))
              (pi-idle-tests--fire noema-pi-router--history-timer)
              (should (= observations 1))
              (noema-pi-router--turn-complete (current-buffer) nil)
              (let ((timer noema-pi-router--history-timer))
                (noema-pi-router--release (current-buffer))
                (pi-idle-tests--fire timer)
                (should (= observations 1))))
          (noema-pi-router--release (current-buffer)))))))

(ert-deftest agent-idle-c46-history-rpc-is-not-a-model-turn-but-unknown-requests-remain-protected ()
  (with-temp-buffer
    (setq major-mode 'agent-shell-mode)
    (setq-local agent-shell--state '((:active-requests . (((:method . "session/list")))))
                shell-maker--busy nil)
    (should-not (+agent-acp-busy-p (current-buffer)))
    (setf (map-elt agent-shell--state :active-requests) '(((:method . "session/prompt"))))
    (should (+agent-acp-busy-p (current-buffer)))
    (setf (map-elt agent-shell--state :active-requests) '(unknown))
    (should (+agent-acp-busy-p (current-buffer)))))

(ert-deftest agent-idle-c46-pi-updates-do-not-scan-buffers-or-enter-warm-retention ()
  (with-temp-buffer
    (setq-local +agent-acp-session-origin 'pi-project)
    (let ((+agent-acp-auto-stop-origins '(run pi pi-emacs pi-project)))
      (cl-letf (((symbol-function 'buffer-list) (lambda (&rest _) (ert-fail "Pi update scanned all buffers"))))
        (dotimes (_ 200) (+agent-acp--sync-warm-sweep (current-buffer))))
      (should-not (+agent-acp-auto-stoppable-p (current-buffer))))))

(ert-deftest agent-idle-c46-capability-queries-and-drafts-avoid-snapshot-and-text-copies ()
  (with-temp-buffer
    (setq-local agent-shell--state '((:session . ((:id . "native"))) (:supports-session-load . t)))
    (insert " \t\n\r")
    (setq-local comint-last-prompt (cons (point-min-marker) (point-min-marker)))
    (cl-letf (((symbol-function '+agent-session-snapshot) (lambda (&rest _) (ert-fail "Capability query built full snapshot")))
              ((symbol-function 'buffer-substring-no-properties) (lambda (&rest _) (ert-fail "Draft copied"))))
      (should (+agent-acp-resumable-p (current-buffer)))
      (should-not (+agent-acp--unsent-input-p (current-buffer)))
      (insert "draft")
      (should (+agent-acp--unsent-input-p (current-buffer))))))

(ert-deftest pi-idle-c13-slow-claim-has-one-in-flight-request-and-one-follow-up ()
  (with-temp-buffer
    (let ((buffer (current-buffer)) (+noema--ready t) (calls 0) complete)
      (unwind-protect
          (cl-letf (((symbol-function 'noema-project-root) (lambda (_) "/tmp/project/"))
                    ((symbol-function 'noema-pi-router-claim)
                     (lambda (_ &optional callback) (cl-incf calls) (setq complete callback)))
                    ((symbol-function '+agent-acp-state-value)
                     (lambda (_ path &optional _) (when (equal path '(:session :id)) "native"))))
            (noema-pi-router--schedule-claim "/tmp/project/" buffer)
            (pi-idle-tests--fire noema-pi-router--claim-timer)
            (dotimes (_ 200) (noema-pi-router--schedule-claim "/tmp/project/" buffer))
            (should (= calls 1))
            (should-not noema-pi-router--claim-timer)
            (funcall complete)
            (should (timerp noema-pi-router--claim-timer))
            (pi-idle-tests--fire noema-pi-router--claim-timer)
            (should (= calls 2))
            (noema-pi-router--release buffer)
            (funcall complete)
            (should-not noema-pi-router--claim-timer))
        (noema-pi-router--release buffer)))))

(ert-deftest pi-idle-c13-coordinator-completion-releases-owner-after-error-or-empty-result ()
  (require 'noema-agent-worker)
  (let ((completions 0) callback)
    (cl-letf (((symbol-function 'noema-agent-worker--api)
               (lambda (_channel _body fn &optional _) (setq callback fn)))
              ((symbol-function 'display-warning) #'ignore))
      (noema-agent-worker-claim-coordinator-requests "/tmp/" (lambda () (cl-incf completions)))
      (funcall callback nil "offline")
      (should (= completions 1))
      (noema-agent-worker-claim-coordinator-requests "/tmp/" (lambda () (cl-incf completions)))
      (funcall callback '((requests . [])) nil)
      (should (= completions 2)))))

(ert-deftest pi-idle-c13-changing-buffer-mode-detaches-physical-pi-owner ()
  (with-temp-buffer
    (let ((noema-pi-router--emacs-buffer nil)
          (noema-pi-router--buffers (make-hash-table :test #'equal))
          (removed 0))
      (cl-letf (((symbol-function '+agent-acp-subscribe) (lambda (&rest _) (make-symbol "subscription")))
                ((symbol-function '+agent-acp-unsubscribe) (lambda (&rest _) (cl-incf removed))))
        (noema-pi-router--attach "emacs" (current-buffer))
        (should (eq noema-pi-router--emacs-buffer (current-buffer)))
        (special-mode)
        (should-not noema-pi-router--emacs-buffer)
        (should (= removed 2))))))

(provide 'pi-idle-tests)
