;;; pi-session-live-smoke.el --- Native Pi lifecycle, no model requests -*- lexical-binding: t; -*-
;; Uses an isolated native SDK history fixture; never mutates user sessions.

(require 'noema-pi-router)
(let* ((temporary (make-temp-file "noema-pi-native-" t))
       (noema-pi-agent-directory (expand-file-name "agent/" temporary))
       (noema-pi-companion-directory (expand-file-name "companion/" temporary))
       (project (expand-file-name "project/" temporary))
       (noema-pi-router--emacs-buffer nil)
       (noema-pi-router--buffers (make-hash-table :test #'equal))
       (+noema--ready nil)
       (+agent-session-adopt-functions '(noema-pi-router--adopt-runtime))
       (buffers nil)
       (original-window (selected-window))
       (original-buffer (window-buffer (selected-window))))
  (unwind-protect
      (progn
        (make-directory noema-pi-companion-directory t)
        (make-directory project t)
        (setq noema-pi-companion-directory (file-truename noema-pi-companion-directory))
        (let ((fixture (with-temp-buffer
                         (unless (zerop (call-process (executable-find "node") nil t nil
                                                    (expand-file-name "test/fixtures/pi-native-session.mjs" user-emacs-directory)
                                                    (executable-find "pi-acp") noema-pi-companion-directory noema-pi-agent-directory))
                           (error "Native fixture failed: %s" (buffer-string)))
                         (string-trim (buffer-string)))))
          (noema-pi-sessions-import-native "emacs" fixture "native-sdk-test-fixture"))
        (let* ((parent (noema-pi-emacs-ensure))
               (child (noema-pi-project-ensure project))
               (deadline (+ (float-time) 25)))
          (setq buffers (list parent child))
          (while (and (< (float-time) deadline)
                      (not (and (+agent-acp-state-value parent '(:init-finished))
                                (+agent-acp-state-value child '(:init-finished)))))
            (accept-process-output nil 0.1))
          (unless (and (+agent-acp-state-value parent '(:session :id))
                       (+agent-acp-state-value child '(:session :id)))
            (error "Pi native handshake failed; parent=%S child=%S"
                   (+agent-acp-state-value parent '(:init-finished))
                   (+agent-acp-state-value child '(:init-finished))))
          (cl-assert (not (equal (+agent-acp-state-value parent '(:session :id))
                                 (+agent-acp-state-value child '(:session :id)))))
          (cl-assert (eq (buffer-local-value 'noema-pi-parent child) parent))
          (cl-assert (eq (noema-pi-project-ensure project) child))
          (cl-assert (eq (window-buffer original-window) original-buffer))
          (cl-assert (= (length (noema-pi-sessions-records)) 1))
          ;; A physical restart must restore the native conversation and
          ;; reattach the Pi owner, rather than retaining the dead buffer.
          (let* ((native (+agent-acp-state-value parent '(:session :id)))
                 (replacement (+agent-acp-restart-native parent native))
                 (deadline (+ (float-time) 20)))
            (push replacement buffers)
            (while (and (< (float-time) deadline)
                        (not (+agent-acp-state-value replacement '(:init-finished))))
              (accept-process-output nil 0.1))
            (cl-assert (equal (+agent-acp-state-value replacement '(:session :id)) native))
            (cl-assert (eq noema-pi-router--emacs-buffer replacement))
            (cl-assert (eq (buffer-local-value 'noema-pi-parent child) replacement))
            (cl-assert (= (length (noema-pi-sessions-records)) 1)))
          (princ "PI_NATIVE_SMOKE: two initialized native sessions; child reused; parent link preserved after physical restart; no model prompt submitted.\n")))
    (dolist (buffer buffers)
      (when (buffer-live-p buffer) (ignore-errors (+agent-acp-kill buffer))))
    (delete-directory temporary t)))
