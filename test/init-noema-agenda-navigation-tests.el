;;; init-noema-agenda-navigation-tests.el --- Agenda to rendered notes -*- lexical-binding: t; -*-
(require 'ert)
(require 'cl-lib)
(require 'noema/bridge/config)
(require 'noema-agenda)
(require 'noema/bridge/agenda-navigation nil t)

(defmacro noema-agenda-nav-test--pane (&rest body)
  (declare (indent 0))
  `(let* ((source (generate-new-buffer " *Agenda navigation origin*"))
          (pane (generate-new-buffer " *Agenda navigation note*"))
          (file (file-truename (expand-file-name "agenda-navigation.md" temporary-file-directory)))
          (canonical (+noema--canonical-file file))
          (noema-agenda--visit-request 10)
          (noema-agenda--waiting-visit nil)
          (pre-command-hook pre-command-hook)
          (+noema--port 9876)
          (record `((file . ,file) (id . "#task")))
          posted)
     (save-window-excursion
       (unwind-protect
           (progn
             (delete-other-windows)
             (switch-to-buffer source)
             (with-current-buffer pane
               (setq-local +noema-buffer-file-name canonical +noema--client-id "agenda-note"
                           +noema--loaded-file canonical))
             (cl-letf (((symbol-function '+noema--ensure-server) (lambda (callback) (funcall callback)))
                       ((symbol-function '+noema--buffer-for-file) (lambda (_) pane))
                       ((symbol-function '+noema--post) (lambda (payload) (push payload posted))))
               ,@body))
         (kill-buffer pane)
         (kill-buffer source)))))

(ert-deftest noema-agenda-nav-reuses-visible-note-and-addresses-only-that-client ()
  (should (fboundp '+noema-agenda-visit-record))
  (noema-agenda-nav-test--pane
    (let* ((origin (selected-window)) (target (split-window-right)))
      (set-window-buffer target pane)
      (cl-letf (((symbol-function 'find-file-noselect) (lambda (&rest _) (ert-fail "Raw source visit"))))
        (should (+noema-agenda-visit-record record 10)))
      (should (eq (selected-window) target))
      (should (eq (window-buffer origin) source))
      (should (= (length (window-list)) 2))
      (should (equal (alist-get 'client (car posted)) "agenda-note"))
      (should (equal (alist-get 'command (car posted)) "agenda-visit"))
      (should (equal (alist-get 'file (alist-get 'detail (car posted))) file)))))

(ert-deftest noema-agenda-nav-waits-for-the-exact-page-and-cancels-on-focus-change ()
  (should (fboundp '+noema-agenda-visit-record))
  (noema-agenda-nav-test--pane
    (with-current-buffer pane (setq +noema--loaded-file nil))
    (+noema-agenda-visit-record record 10)
    (should-not posted)
    (with-current-buffer pane (setq +noema--loaded-file canonical))
    (run-hook-with-args '+noema-current-file-functions canonical pane)
    (should (= (length posted) 1))
    (setq posted nil)
    (with-current-buffer pane (setq +noema--loaded-file nil))
    (+noema-agenda-visit-record record 10)
    (switch-to-buffer source)
    (with-current-buffer pane (setq +noema--loaded-file canonical))
    (run-hook-with-args '+noema-current-file-functions canonical pane)
    (should-not posted)
    (should (eq (current-buffer) source))))

(ert-deftest noema-agenda-nav-cold-host-does-not-reopen-after-another-action ()
  (should (fboundp '+noema-agenda-visit-record))
  (noema-agenda-nav-test--pane
    (let (ready)
      (cl-letf (((symbol-function '+noema--ensure-server) (lambda (callback) (setq ready callback))))
        (+noema-agenda-visit-record record 10)
        (cl-incf noema-agenda--visit-request)
        (funcall ready)
        (should (eq (current-buffer) source))
        (should-not posted)))))

(ert-deftest noema-agenda-nav-leaving-and-returning-cannot-revive-a-cold-page-visit ()
  (noema-agenda-nav-test--pane
    (with-current-buffer pane (setq +noema--loaded-file nil))
    (+noema-agenda-visit-record record 10)
    ;; Emulate the command loop, including the pre-command cancellation.
    (run-hooks 'pre-command-hook)
    (switch-to-buffer source)
    (run-hooks 'pre-command-hook)
    (switch-to-buffer pane)
    (with-current-buffer pane (setq +noema--loaded-file canonical))
    (run-hook-with-args '+noema-current-file-functions canonical pane)
    (should-not posted)))

(ert-deftest noema-agenda-nav-new-pane-waits-for-its-current-file-event ()
  (noema-agenda-nav-test--pane
    (with-current-buffer pane (setq +noema--loaded-file nil))
    (let (opened)
      (cl-letf (((symbol-function '+noema--buffer-for-file) (lambda (_) nil))
                ((symbol-function '+noema--open-url)
                 (lambda (_url target)
                   (setq opened target)
                   (switch-to-buffer pane)
                   pane)))
        (+noema-agenda-visit-record record 10))
      (should (equal opened canonical))
      (should-not posted)
      (with-current-buffer pane (setq +noema--loaded-file canonical))
      (run-hook-with-args '+noema-current-file-functions canonical pane)
      (should (= (length posted) 1)))))

(ert-deftest noema-agenda-nav-accepts-structured-records-and-cancels-after-host-exit ()
  (noema-agenda-nav-test--pane
    (setq record (let ((object (make-hash-table :test #'equal)))
                   (puthash "file" file object) (puthash "id" "#task" object) object))
    (+noema-agenda-visit-record record 10)
    (should (equal (alist-get 'id (alist-get 'detail (car posted))) "#task"))
    (setq posted nil)
    (with-current-buffer pane (setq +noema--loaded-file nil))
    (+noema-agenda-visit-record record 10)
    (noema-agenda-host-stopped)
    (with-current-buffer pane (setq +noema--loaded-file canonical))
    (run-hook-with-args '+noema-current-file-functions canonical pane)
    (should-not posted)))

(ert-deftest noema-agenda-nav-preserves-logical-remote-file-identity ()
  (should (fboundp '+noema-agenda-visit-record))
  (noema-agenda-nav-test--pane
    (setq file "/fs:other:/project/tasks.md" canonical file record `((file . ,file) (id . "#task")))
    (with-current-buffer pane (setq +noema-buffer-file-name file +noema--loaded-file file))
    (cl-letf (((symbol-function '+noema--canonical-file) #'identity)
              ((symbol-function '+noema--host-file) #'identity))
      (+noema-agenda-visit-record record 10))
    (should (equal (alist-get 'file (alist-get 'detail (car posted))) file))))

(ert-deftest noema-agenda-nav-current-file-event-delivers-the-waiting-navigation ()
  (noema-agenda-nav-test--pane
    (let ((+noema--client-buffers (make-hash-table :test #'equal))
          (+noema--file-buffers (make-hash-table :test #'equal))
          (+noema--activity-hooks-installed nil))
      (puthash "agenda-note" pane +noema--client-buffers)
      (with-current-buffer pane (setq +noema--loaded-file nil))
      (+noema-agenda-visit-record record 10)
      (should-not posted)
      (+noema--sync-app-buffer-file file "agenda-note")
      (should (equal (buffer-local-value '+noema--loaded-file pane) canonical))
      (should (= (length posted) 1)))))

(ert-deftest noema-agenda-nav-resumes-the-selected-pane-before-sending-its-visit ()
  (noema-agenda-nav-test--pane
    (let ((+noema--activity-hooks-installed t) (+noema--manual-paused nil))
      (with-current-buffer pane (setq-local +noema--activity-paused t))
      (cl-letf (((symbol-function '+noema--activity-snapshot) (lambda () (list (cons pane t)))))
        (+noema-agenda-visit-record record 10))
      (should (equal (mapcar (lambda (item) (alist-get 'command item)) (reverse posted))
                     '("resume" "agenda-visit")))
      (should (seq-every-p (lambda (item) (equal (alist-get 'client item) "agenda-note")) posted)))))

(ert-deftest noema-agenda-nav-keeps-journal-reference-quotes-exact ()
  (noema-agenda-nav-test--pane
    (setq record `((file . ,file) (id . "#c-7777") (sourceKind . "comment-reference")
                   (quote . "Unique theorem\n  with exact spacing")))
    (+noema-agenda-visit-record record 10)
    (let ((body (alist-get 'detail (car posted))))
      (should (equal (alist-get 'sourceKind body) "comment-reference"))
      (should (equal (alist-get 'quote body) "Unique theorem\n  with exact spacing")))))

(ert-deftest noema-agenda-nav-attention-prequery-cannot-replace-a-newer-visit ()
  (save-window-excursion
    (noema-agenda-nav-test--pane
      (let ((noema-agenda--project-scope "scope") (noema-agenda--project-request 0)
            (noema-agenda--visit-request 0) query visited)
        (cl-letf (((symbol-function '+project-activate) #'ignore)
                  ((symbol-function 'noema-agenda-activate-project)
                   (lambda (_root callback) (funcall callback '((id . "scope")) nil)))
                  ((symbol-function 'noema-agenda--call)
                   (lambda (_op _body callback) (setq query callback)))
                  ((symbol-function 'noema-agenda-visit-record) (lambda (record) (setq visited record))))
          (+noema--agenda-attention-visit '((root . "/project") (file . "/project/a.md") (uid . "old")))
          (cl-incf noema-agenda--visit-request)
          (funcall query '((todos . [((uid . "old") (file . "/project/a.md"))])) nil)
          (should-not visited)
          (+noema--agenda-attention-visit '((root . "/project") (file . "/project/a.md") (uid . "old")))
          (switch-to-buffer pane)
          (funcall query '((todos . [((uid . "old") (file . "/project/a.md"))])) nil)
          (should-not visited))))))

(provide 'init-noema-agenda-navigation-tests)
