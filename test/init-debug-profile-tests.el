;;; init-debug-profile-tests.el --- Debug profile entry and rerun scope -*- lexical-binding: t; -*-

(require 'ert)
(require 'cl-lib)
(require 'init-debug-profile)

(ert-deftest debug-profile-menu-is-searchable-and-preserves-native-dape ()
  (should (member "debug-profile-menu"
                  (all-completions "debug-profile-menu" obarray #'commandp)))
  (dolist (entry '(("d" . my/debug-profile-run)
                   ("r" . my/debug-profile-rerun)
                   ("D" . dape)))
    (should (eq (plist-get (cdr (transient-get-suffix
                                'debug-profile-menu (car entry))) :command)
                (cdr entry)))))

(ert-deftest debug-profile-rerun-stays-in-frame-and-project-and-survives-failure ()
  (let ((active-frame 'frame-a)
        (root "/fs:local:/tmp/debug-a/")
        (history (make-hash-table :test #'eq))
        calls)
    (cl-letf (((symbol-function 'selected-frame)
               (lambda () active-frame))
              ((symbol-function 'frame-live-p)
               (lambda (_frame) t))
              ((symbol-function 'frame-parameter)
               (lambda (frame key) (alist-get key (gethash frame history))))
              ((symbol-function 'set-frame-parameter)
               (lambda (frame key value)
                 (puthash frame
                          (cons (cons key value)
                                (assq-delete-all key (gethash frame history)))
                          history)))
              ((symbol-function 'my/debug-profile-root)
               (lambda () root))
              ((symbol-function 'my/debug-profile-candidates)
               (lambda () '(("first" . first)
                            ("second" . second)
                            ("broken" . broken))))
              ((symbol-function 'my/debug-profile--spec->config)
               (lambda (spec &optional _root)
                 (list 'program (symbol-name spec))))
              ((symbol-function 'dape)
               (lambda (config &optional _skip-compile)
                 (when (equal (plist-get config 'program) "broken")
                   (error "Dape launch failed"))
                 (push (list active-frame default-directory
                             (plist-get config 'program))
                       calls)
                 'accepted)))
      (should (eq (my/debug-profile-run "first") 'accepted))
      (should (equal (car calls)
                     '(frame-a "/fs:local:/tmp/debug-a/" "first")))
      (setq active-frame 'frame-b)
      (should-error (my/debug-profile-rerun) :type 'user-error)
      (setq active-frame 'frame-a
            root "/fs:local:/tmp/debug-b/")
      (should-error (my/debug-profile-rerun) :type 'user-error)
      (setq root "/fs:local:/tmp/debug-a/")
      (should-error (my/debug-profile-run "broken") :type 'error)
      (should (eq (my/debug-profile-rerun) 'accepted))
      (should (equal (car calls)
                     '(frame-a "/fs:local:/tmp/debug-a/" "first")))
      (setq active-frame 'frame-b)
      (should (eq (my/debug-profile-run "second") 'accepted))
      (setq active-frame 'frame-a)
      (should (eq (my/debug-profile-rerun) 'accepted))
      (should (equal (car calls)
                     '(frame-a "/fs:local:/tmp/debug-a/" "first"))))))

(provide 'init-debug-profile-tests)
;;; init-debug-profile-tests.el ends here
