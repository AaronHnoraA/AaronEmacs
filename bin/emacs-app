#!/bin/bash
# emacs-app --- run Emacs as a background application on macOS.
#
#   start [--background]   launch Emacs; with --background keep it hidden
#   show | hide | toggle   bring Emacs forward or send it to the background
#   mx                     M-x in a floating frame, from any application
#   terminal               a new Ghostel terminal in its own frame, every time
#   status                 visible | background | busy | stopped
#   quit                   quit Emacs, showing it first for its questions
#   build                  build the window module and menu bar item
#   install | uninstall    manage the login LaunchAgents

set -u

ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
APP=/Applications/Emacs.app
CLIENT=$APP/Contents/MacOS/bin/emacsclient
BUILD=$ROOT/var/macos-background
SOURCE=$ROOT/tools/macos-background
AGENTS=$HOME/Library/LaunchAgents
LABELS=(local.emacs.background local.emacs.menubar)

# Bounded: an Emacs waiting on a question never answers, and a caller such
# as the menu bar item must not hang with it.
client() { "$CLIENT" --timeout=4 --eval "$1" 2>/dev/null; }

# The GUI application only: batch and daemon processes never register here.
running() { [ -n "$(/usr/bin/lsappinfo find bundleid=org.gnu.Emacs)" ]; }

status() {
    local answer
    if answer=$(client '(my/background-status)'); then
        echo "${answer//\"/}"
    elif running; then
        echo busy
    else
        echo stopped
    fi
}

wait_for_server() {
    local _
    for _ in $(seq 1 120); do
        client t >/dev/null && return 0
        sleep 0.5
    done
    return 1
}

start() {
    if [ "${1:-}" = "--background" ]; then
        # An Emacs that is already running stays the way the user left it.
        running && return 0
        /usr/bin/open -g -j -a "$APP"
        wait_for_server && client '(my/background-hide)' >/dev/null
    else
        client '(my/background-show)' >/dev/null || /usr/bin/open -a "$APP"
    fi
}

mx() {
    # The application to hand the keyboard back to when the read is cancelled.
    local front
    front=$(/usr/bin/lsappinfo info -only bundleid "$(/usr/bin/lsappinfo front)" \
                | /usr/bin/sed -nE 's/.*[bB]undle(ID|Identifier)"?="([^"]+)".*/\2/p' | head -n1)
    [ "$front" = "org.gnu.Emacs" ] && front=""
    if ! client "(my/global-mx \"$front\")" >/dev/null; then
        echo "Emacs server is not running"
        return 1
    fi
}

build() {
    mkdir -p "$BUILD" || return 1
    /usr/bin/clang -fobjc-arc -shared -O2 -I "$APP/Contents/Resources/include" \
                   -framework AppKit -o "$BUILD/macos-window.dylib" \
                   "$SOURCE/window.m" || return 1
    /usr/bin/swiftc -O -o "$BUILD/emacs-menubar" "$SOURCE/menubar.swift" || return 1
}

plist() {
    local label=$1; shift
    {
        printf '<?xml version="1.0" encoding="UTF-8"?>\n'
        printf '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
        printf '<plist version="1.0"><dict>\n'
        printf '  <key>Label</key><string>%s</string>\n' "$label"
        printf '  <key>RunAtLoad</key><true/>\n'
        printf '  <key>ProgramArguments</key><array>\n'
        printf '    <string>%s</string>\n' "$@"
        printf '  </array>\n</dict></plist>\n'
    } > "$AGENTS/$label.plist"
}

uninstall() {
    local label
    for label in "${LABELS[@]}"; do
        /bin/launchctl bootout "gui/$(id -u)/$label" 2>/dev/null
        rm -f "$AGENTS/$label.plist"
    done
}

install() {
    build || return 1
    uninstall
    mkdir -p "$AGENTS"
    plist local.emacs.background "$ROOT/bin/emacs-app" start --background
    plist local.emacs.menubar "$BUILD/emacs-menubar" "$ROOT/bin/emacs-app"
    local label
    for label in "${LABELS[@]}"; do
        /bin/launchctl bootstrap "gui/$(id -u)" "$AGENTS/$label.plist" || return 1
    done
}

command=${1:-status}
[ $# -gt 0 ] && shift
case "$command" in
    start) start "$@" ;;
    show) client '(my/background-show)' >/dev/null || /usr/bin/open -a "$APP" ;;
    hide) client '(my/background-hide)' >/dev/null ;;
    toggle) client '(my/background-toggle)' >/dev/null || /usr/bin/open -a "$APP" ;;
    mx) mx ;;
    terminal) client '(progn (my/ghostel-open-new) nil)' >/dev/null ;;
    status) status ;;
    quit) client '(my/background-quit)' >/dev/null ;;
    build) build ;;
    install) install ;;
    uninstall) uninstall ;;
    *) /usr/bin/sed -n '2,12p' "$0"; exit 2 ;;
esac
