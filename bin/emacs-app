#!/bin/bash
# emacs-app --- run Emacs as a background application on macOS.
#
#   start [--background]   launch Emacs; with --background keep it hidden
#   restart                quit and start again, visible or hidden as before
#   kill                   end an Emacs that no longer answers
#   show | hide | toggle   bring Emacs forward or send it to the background
#   state                  JSON for status, health, actions and frames at once
#   actions                JSON for the whitelisted actions
#   act ID [ARGUMENT]      run a whitelisted action
#   result ID              poll a queued action or frame operation
#   frames                 JSON for the top-level frames
#   frame ACTION [ID]      focus | hide | hide-others | close | close-others
#                          a frame by ID, or new | show-all | hide-all
#   terminal               a new Portal terminal in its own frame, every time
#   status                 visible | background | busy | stopped
#   quit                   quit Emacs, showing it first for its questions
#   build                  build the window module
#   install | uninstall    manage the login LaunchAgent

set -u

# Emacs and everything it starts inherit this environment through `open'.
# A launcher may export an LC_ALL that is no POSIX locale; tools such as
# pbpaste then fall back to C and turn every non-ASCII character into "?".
unset LC_ALL LC_CTYPE LC_COLLATE LC_MESSAGES LC_MONETARY LC_NUMERIC LC_TIME
case "${LANG:-}" in
    *.UTF-8) ;;
    *) export LANG=en_US.UTF-8 ;;
esac

ROOT=$(cd "$(dirname "$0")/.." && pwd -P)
APP=/Applications/Emacs.app
CLIENT=$APP/Contents/MacOS/bin/emacsclient
BUILD=$ROOT/var/macos-background
SOURCE=$ROOT/tools/macos-background
AGENTS=$HOME/Library/LaunchAgents
LABEL=local.emacs.background

# Bounded: an Emacs waiting on a question never answers, and a caller must
# not hang with it.
client() { "$CLIENT" --timeout=4 --eval "$1" 2>/dev/null; }

# The GUI application only: batch and daemon processes never register here.
running() { [ -n "$(/usr/bin/lsappinfo find bundleid=org.gnu.Emacs)" ]; }

status() {
    local answer
    if answer=$(client '(my/background-status)'); then
        echo "${answer//\"/}"
    elif running; then
        echo busy
    else
        echo stopped
    fi
}

wait_for_server() {
    local _
    for _ in $(seq 1 120); do
        client t >/dev/null && return 0
        sleep 0.5
    done
    return 1
}

wait_for_startup() {
    # The server can answer before the initial graphical frame is ready.
    local _
    for _ in $(seq 1 120); do
        [ "$(client '(and (boundp (quote my/background--startup-done)) my/background--startup-done)' 2>/dev/null)" = t ] && return 0
        sleep 0.5
    done
    return 1
}

start() {
    if [ "${1:-}" = "--background" ]; then
        # An Emacs that is already running stays the way the user left it.
        running && return 0
        /usr/bin/open -g -j -a "$APP"
        wait_for_server && client '(my/background-start-hidden)' >/dev/null
    else
        client '(my/background-show)' >/dev/null || /usr/bin/open -a "$APP"
    fi
}

open_terminal() {
    start || return 1
    if ! wait_for_startup; then
        echo 'Emacs did not complete startup in time' >&2
        return 1
    fi
    "$CLIENT" --timeout=4 --eval '(progn (my/portal-open-new) nil)' >/dev/null
}

wait_for_exit() {
    local _
    for _ in $(seq 1 "${1:-120}"); do
        running || return 0
        sleep 0.5
    done
    return 1
}

# Emacs may be asking about unsaved work; it is shown, and the wait is bounded.
restart() {
    local was
    was=$(status)
    if [ "$was" != stopped ]; then
        client '(my/background-quit)' >/dev/null
        wait_for_exit || { echo "Emacs did not quit; it may be waiting for an answer" >&2; return 1; }
    fi
    if [ "$was" = background ]; then start --background; else start; fi
}

# For an Emacs that no longer answers.  SIGTERM still runs its exit hooks.
force_quit() {
    local pid
    pid=$(/usr/bin/lsappinfo info -only pid org.gnu.Emacs | tr -dc '0-9')
    [ -n "$pid" ] || return 0
    kill -TERM "$pid" 2>/dev/null
    wait_for_exit 20 && return 0
    kill -KILL "$pid" 2>/dev/null
    wait_for_exit 10
}

# Always JSON: an Emacs that does not answer still has a status.
state() {
    local reply
    if reply=$(client '(my/background-state)'); then
        printf '%s' "${reply//\"/}" | /usr/bin/base64 -D
    elif running; then
        echo '{"status":"busy"}'
    else
        echo '{"status":"stopped"}'
    fi
}

# Arguments reach Emacs as base64, so no input can break out of the form.
encode() { printf '%s' "$1" | /usr/bin/base64 | tr -d '\n'; }

# Emacs answers with base64 JSON; print the JSON.
json() {
    local reply
    reply=$(client "$1") || return 1
    printf '%s' "${reply//\"/}" | /usr/bin/base64 -D
}

# Unlike a receipt, an action's final result is read through `result'.
# Preserve validation errors from emacsclient for the external UI.
queued_json() {
    local reply
    if reply=$("$CLIENT" --timeout=4 --eval "$1" 2>&1); then
        printf '%s' "${reply//\"/}" | /usr/bin/base64 -D
        return $?
    fi
    printf '%s\n' "${reply:-Emacs is not answering}" >&2
    return 1
}

act() {
    queued_json "(progn (unless (and (boundp 'my/background-action-protocol) (= my/background-action-protocol 1)) (user-error \"Emacs action protocol is outdated; reload init-background.el\")) (my/background-act \"$(encode "${1:?action id}")\" \"$(encode "${2:-}")\"))"
}

frame() {
    queued_json "(progn (unless (and (boundp 'my/background-action-protocol) (= my/background-action-protocol 1)) (user-error \"Emacs action protocol is outdated; reload init-background.el\")) (my/background-frame-act \"$(encode "${1:?action}")\" \"$(encode "${2:-}")\"))"
}

result() {
    queued_json "(my/background-result \"$(encode "${1:?request id}")\")"
}

build() {
    mkdir -p "$BUILD" || return 1
    /usr/bin/clang -fobjc-arc -shared -O2 -I "$APP/Contents/Resources/include" \
                   -framework AppKit -o "$BUILD/macos-window.dylib" \
                   "$SOURCE/window.m" || return 1
}

uninstall() {
    /bin/launchctl bootout "gui/$(id -u)/$LABEL" 2>/dev/null
    rm -f "$AGENTS/$LABEL.plist"
}

install() {
    build || return 1
    uninstall
    mkdir -p "$AGENTS"
    {
        printf '<?xml version="1.0" encoding="UTF-8"?>\n'
        printf '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
        printf '<plist version="1.0"><dict>\n'
        printf '  <key>Label</key><string>%s</string>\n' "$LABEL"
        printf '  <key>RunAtLoad</key><true/>\n'
        printf '  <key>ProgramArguments</key><array>\n'
        printf '    <string>%s</string>\n' "$ROOT/bin/emacs-app" start --background
        printf '  </array>\n</dict></plist>\n'
    } > "$AGENTS/$LABEL.plist"
    /bin/launchctl bootstrap "gui/$(id -u)" "$AGENTS/$LABEL.plist"
}

command=${1:-status}
[ $# -gt 0 ] && shift
case "$command" in
    start) start "$@" ;;
    restart) restart ;;
    kill) force_quit ;;
    state) state ;;
    show) client '(my/background-show)' >/dev/null || /usr/bin/open -a "$APP" ;;
    hide) client '(my/background-hide)' >/dev/null ;;
    toggle) client '(my/background-toggle)' >/dev/null || /usr/bin/open -a "$APP" ;;
    frames) json '(my/background-frames)' ;;
    frame) frame "$@" ;;
    actions) json '(my/background-actions)' ;;
    act) act "$@" ;;
    result) result "$@" ;;
    terminal) open_terminal ;;
    status) status ;;
    quit) client '(my/background-quit)' >/dev/null ;;
    build) build ;;
    install) install ;;
    uninstall) uninstall ;;
    *) /usr/bin/sed -n '2,19p' "$0"; exit 2 ;;
esac
