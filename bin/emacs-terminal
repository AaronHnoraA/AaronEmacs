#!/usr/bin/env python3
"""Open a macOS file or folder in a Ghostel terminal inside Emacs."""
import json
import pathlib
import subprocess
import sys
import time

CLIENT = "/Applications/Emacs.app/Contents/MacOS/bin/emacsclient"


def open_terminal(path=None, command=None):
    argument = (
        json.dumps(str(pathlib.Path(path).expanduser().resolve()), ensure_ascii=False)
        if path else "nil"
    )
    command_arg = (
        "(list " + " ".join(json.dumps(part, ensure_ascii=False) for part in command) + ")"
        if command else "nil"
    )
    expression = f"(my/ghostel-open-external {argument} {command_arg})"
    command = [CLIENT, "--eval", expression]
    for attempt in range(31):
        result = subprocess.run(command, capture_output=True, text=True)
        if result.returncode == 0:
            return
        if attempt == 0:
            subprocess.run(["/usr/bin/open", "-a", "Emacs"], check=True)
        time.sleep(1)
    raise SystemExit(result.stderr.strip() or "Emacs server did not start")


if __name__ == "__main__":
    if sys.argv[1:2] in (["-e"], ["--"]):
        if len(sys.argv) < 3:
            raise SystemExit("Usage: emacs-terminal -e PROGRAM [ARG ...]")
        open_terminal(command=sys.argv[2:])
    else:
        for item in sys.argv[1:] or [None]:
            open_terminal(path=item)
