#!/usr/bin/env python3
"""Register the Emacs Ghostel launcher as the macOS shell-script handler."""
import pathlib
import plistlib
import shutil
import subprocess

home = pathlib.Path.home()
repo = home / ".config/emacs"
app = home / "Applications/Emacs Terminal.app"
icon = pathlib.Path("/Applications/Emacs.app/Contents/Resources/Emacs.icns")
app.parent.mkdir(parents=True, exist_ok=True)
subprocess.run(["osacompile", "-o", str(app), str(repo / "bin/emacs-terminal.applescript")], check=True)
info_file = app / "Contents/Info.plist"
with info_file.open("rb") as stream:
    info = plistlib.load(stream)
info.update({
    "CFBundleIdentifier": "com.hc.EmacsTerminal",
    "CFBundleName": "Emacs Terminal",
    "CFBundleDisplayName": "Emacs Terminal",
    "CFBundleIconFile": "Emacs.icns",
    "CFBundleIconName": "Emacs",
    "CFBundleDocumentTypes": [{
        "CFBundleTypeName": "Shell command",
        "CFBundleTypeRole": "Viewer",
        "LSItemContentTypes": ["public.shell-script", "public.unix-executable"],
        "CFBundleTypeExtensions": ["command", "tool"],
    }],
})
with info_file.open("wb") as stream:
    plistlib.dump(info, stream)
shutil.copyfile(icon, app / "Contents/Resources/Emacs.icns")
subprocess.run(["codesign", "--force", "--deep", "--sign", "-", str(app)], check=True)
subprocess.run([
    "/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister",
    "-f", str(app),
], check=True)
subprocess.run(["swift", str(repo / "bin/emacs-terminal-default.swift")], check=True)
