(defun +xwidget-setup-control-line ()
  "Install browser controls and a window popup in this xwidget header line."
  (setq-local header-line-format
              `(" "
                ,@(+xwidget--header-browser-buttons)
                "  "
                (:eval (propertize (or (+xwidget-current-url) "")
                                   'face 'shadow))))
