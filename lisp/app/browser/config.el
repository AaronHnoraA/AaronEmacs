      (+xwidget--window-menu-item "Copy selection" #'+xwidget/copy-selection)
      "---"
      (+xwidget--window-menu-item "Back" #'+xwidget/back)
      (+xwidget--window-menu-item "Forward" #'+xwidget/forward)
      (+xwidget--window-menu-item "Reload" #'+xwidget/reload)
      (+xwidget--window-menu-item "Focus editor" #'+xwidget/focus)
      "---"
      (+xwidget--window-menu-item "Undo" #'+xwidget/undo)
      (+xwidget--window-menu-item "Redo" #'+xwidget/redo))
     (list
      "Window"
      (+xwidget--window-menu-item "Switch buffer" #'switch-to-buffer)
      (+xwidget--window-menu-item "Buffer list" #'ibuffer)
      (+xwidget--window-menu-item "Delete window" #'delete-window)
