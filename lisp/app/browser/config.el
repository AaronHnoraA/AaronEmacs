(defalias '+xwidget-setup-header-line #'+xwidget-setup-control-line)

;;;; xwidget-webkit 基础配置（macOS / emacs-plus with-xwidgets）

(defvar +xwidget--callback-advice-installed nil
  "Non-nil when xwidget callback advice has been installed.")

(when (featurep 'xwidget-internal)
  ;; Keep this free of %-escapes: supported xwidget format keys vary across
  ;; Emacs builds, and unsupported keys raise `format-spec' errors.

  ;; 进入 xwidget buffer 时给常用键（不会污染全局）
  (with-eval-after-load 'xwidget
    (+xwidget-keep-emacs-prefix-keys xwidget-webkit-mode-map)
    (+xwidget-keep-emacs-prefix-keys xwidget-webkit-edit-mode-map)
    (+xwidget-pass-editing-keys xwidget-webkit-mode-map)
    (+xwidget-pass-editing-keys xwidget-webkit-edit-mode-map)
    (+xwidget-pass-pointer-keys xwidget-webkit-mode-map)
    (+xwidget-pass-pointer-keys xwidget-webkit-edit-mode-map)
    (define-key xwidget-webkit-mode-map [remap split-window-below] #'+xwidget/split-window-below-ibuffer)
    (define-key xwidget-webkit-mode-map [remap split-window-right] #'+xwidget/split-window-right-ibuffer)
    (define-key xwidget-webkit-mode-map (kbd "q") #'quit-window)
    (define-key xwidget-webkit-mode-map (kbd "g") #'+xwidget/reload)
    (define-key xwidget-webkit-mode-map (kbd "M-r") #'+browser/refresh-current-content)
    (define-key xwidget-webkit-mode-map (kbd "l") #'+xwidget/open-url-current)
    (define-key xwidget-webkit-mode-map (kbd "b") #'+xwidget/back)
    (define-key xwidget-webkit-mode-map (kbd "f") #'+xwidget/forward)
    (define-key xwidget-webkit-mode-map (kbd "y") #'+xwidget/copy-selection)
    (define-key xwidget-webkit-mode-map (kbd "Y") #'+xwidget/copy-url)
    (define-key xwidget-webkit-mode-map (kbd "i") #'+xwidget/focus)
    ;; Drive auto-focus and title sync from WebKit callback events.
    (unless +xwidget--callback-advice-installed
      (advice-add 'xwidget-webkit-callback :after #'+xwidget--load-finished-focus)
      (advice-add 'xwidget-webkit-callback :after #'+xwidget--callback-update-buffer-name)
      (setq +xwidget--callback-advice-installed t))))

