;;; eww <-> xwidget-webkit 互转 (稳健版)

;; ---------- 1. 获取 URL 的工具函数 ----------

(defun +eww-get-url ()
  "获取当前 EWW buffer 的 URL，带空值检查"
  (if (derived-mode-p 'eww-mode)
      (plist-get eww-data :url)
    nil))

(defun +xwidget-get-url ()
  "获取当前 Xwidget buffer 的 URL，带空值检查"
  (if (eq major-mode 'xwidget-webkit-mode)
      (+xwidget-current-url)
    nil))

(defun +browser-build-search-url (search-term engine)
  "Return a search URL for SEARCH-TERM on ENGINE."
  (require 'url-util)
  (let ((encoded-query (url-hexify-string search-term)))
    (pcase engine
      ('bing (format "https://www.bing.com/search?q=%s" encoded-query))
      ('perplexity (format "https://www.perplexity.ai/search?q=%s" encoded-query))
      ('duckduckgo (format "https://duckduckgo.com/?q=%s" encoded-query))
      (_ (format "https://www.bing.com/search?q=%s" encoded-query)))))

(defun +browser-current-backend ()
  "Return the current browser backend symbol, or nil."
  (cond
   ((derived-mode-p 'eww-mode) 'eww)
   ((eq major-mode 'portal-web-mode) 'portal)
   ((eq major-mode 'xwidget-webkit-mode) 'xwidget)
   (t nil)))

(defun +browser-current-url ()
  "Return the current page URL for the active browser backend."
  (pcase (+browser-current-backend)
    ('eww (+eww-get-url))
    ('portal (and (boundp 'portal-web--url) portal-web--url))
    ('xwidget (+xwidget-get-url))
    (_ nil)))

(defun +browser--kill-buffer-and-window ()
  "Kill the current browser buffer and delete its window when possible."
  (let ((buffer (current-buffer))
        (window (selected-window)))
    (let ((kill-buffer-query-functions nil))
      (when (buffer-live-p buffer)
        (kill-buffer buffer)))
    (when (and (window-live-p window)
               (> (length (window-list nil 'no-minibuf)) 1))
      (delete-window window))))

(defun +browser/close-current ()
  "Close the current browser view or tab.
For EWW, Portal and xwidget-webkit, this kills the browser buffer and deletes its
window, avoiding orphan browser buffers/windows."
  (interactive)
  (pcase (+browser-current-backend)
    ('eww
     (+browser--kill-buffer-and-window))
    ('portal
     (+browser--kill-buffer-and-window))
    ('xwidget
     (+browser--kill-buffer-and-window))
    (_
     (user-error "当前 buffer 不是受支持的浏览后端"))))

(defun +browser-open-url-with-backend (backend url &optional reuse-selected)
  "Open URL with browser BACKEND."
  (aaron-open-url-with-backend url backend reuse-selected))

(defun +browser-cleanup-backend (_backend buffer)
  "Kill BUFFER after a successful browser switch."
  (when (buffer-live-p buffer)
    (kill-buffer buffer)))

(defun +browser/refresh-current-content ()
  "Refresh the current web view or file buffer."
  (interactive)
  (cond
   ((derived-mode-p 'eww-mode)
    (call-interactively #'eww-reload))
   ((eq major-mode 'portal-web-mode)
    (call-interactively #'portal-web-reload))
   ((eq major-mode 'xwidget-webkit-mode)
    (call-interactively #'+xwidget/reload))
   ((or (buffer-file-name) (derived-mode-p 'dired-mode))
    (if (buffer-modified-p)
        (user-error "当前 buffer 有未保存修改，先保存再刷新")
      (revert-buffer :ignore-auto :noconfirm :preserve-modes)
      (message "已刷新: %s" (buffer-name))))
   (t
    (user-error "当前 buffer 不支持刷新"))))

(general-define-key
 :keymaps 'global
 "C-c w r" #'+browser/refresh-current-content)

(defun +browser/switch-to (backend)
  "Switch the current browser page to BACKEND."
  (interactive
   (list (aaron-open-read-backend 'url "Switch browser to: ")))
  (let ((backend (aaron-open-normalize-backend backend))
        (source-backend (+browser-current-backend))
        (url (+browser-current-url))
        (old-buf (current-buffer)))
    (unless source-backend
      (user-error "当前 buffer 不是受支持的浏览后端"))
    (unless url
      (user-error "无法获取当前页面 URL"))
    (when (eq source-backend backend)
      (user-error "当前已经是 %s" backend))
    (message "正在切换至 %s: %s" backend url)
    (+browser-open-url-with-backend backend url t)
    (run-at-time "0 sec" nil #'+browser-cleanup-backend source-backend old-buf)))

(defun +browser/switch-to-eww ()
  "Switch the current browser page to EWW."
  (interactive)
  (+browser/switch-to 'eww))

(defun +browser/switch-to-portal ()
  "Switch the current browser page to Portal."
  (interactive)
  (+browser/switch-to 'portal))

(defun +browser/switch-to-xwidget ()
  "Switch the current browser page to xwidget-webkit."
  (interactive)
  (+browser/switch-to 'xwidget))

(defun +browser/switch-to-open ()
  "Open the current browser page with macOS open."
  (interactive)
  (+browser/switch-to 'system))

;; ---------- 2. 核心切换逻辑 (带延迟清理) ----------

(defun +browser/eww-to-xwidget ()
  "从 EWW 切换到 Xwidget，成功后延迟清理旧 Buffer"
  (interactive)
  (let ((url (+eww-get-url))
        (old-buf (current-buffer)))
    (if url
        (progn
          (message "正在切换至 Xwidget: %s" url)
          ;; 启动 xwidget
          (+xwidget/open-url url :display 'current :reuse-selected t)
          ;; 【关键修正】：不要立即杀 buffer。
          ;; 使用 run-at-time 0 让 Emacs 先完成 buffer 切换和界面重绘，
          ;; 待事件循环空闲时再回头杀掉旧 buffer。
          (run-at-time "0 sec" nil 
                       (lambda (b) 
                         (when (buffer-live-p b)
                           (kill-buffer b))) 
                       old-buf))
      (message "错误：无法获取 EWW URL"))))

(defun +xwidget/to-eww ()
  "从 Xwidget 切换到 EWW，成功后延迟清理旧 Buffer"
  (interactive)
  (let ((url (+xwidget-get-url))
        (old-buf (current-buffer)))
    (if url
        (progn
          (message "正在切换至 EWW: %s" url)
          ;; 启动 eww
          (aaron/open-eww-url url t)
          ;; 【关键修正】：同样延迟清理，防止 xwidget 还没隐藏就被杀掉导致闪退
          (run-at-time "0 sec" nil 
                       (lambda (b) 
                         (when (buffer-live-p b)
                           (kill-buffer b))) 
                       old-buf))
      (message "错误：无法获取 Xwidget URL"))))


(defun +browser/open-search (search-term &optional engine browser)
  "Search SEARCH-TERM with selected search ENGINE and BROWSER."
  (interactive
   (list
    (read-string "Search: ")
     (intern (completing-read "Search Engine (default: bing): "
                            '("bing" "perplexity" "duckduckgo")
                            nil t nil nil "bing"))
     (aaron-open-read-backend 'search "Browser: ")))
  (+browser-open-url-with-backend
   (or browser (aaron-open-resolve-backend 'search))
   (+browser-build-search-url search-term engine)))

