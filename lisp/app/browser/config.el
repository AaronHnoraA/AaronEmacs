;;;; xwidget API

(defvar +xwidget--sessions (make-hash-table :test #'equal)
  "Stable xwidget session id to buffer map.")

(defvar +xwidget--session-counter 0
  "Counter used for anonymous xwidget session ids.")

(defvar-local +xwidget-session-url nil
  "Last URL recorded for this xwidget buffer.")

(defvar-local +xwidget-session-title nil
  "Last page title recorded for this xwidget buffer.")

(defvar-local +xwidget--managed-buffer-name nil
  "Last buffer name generated by the xwidget naming helper.")

(defvar-local +xwidget--session-id nil
  "Session id for this xwidget buffer, used to remove its hash entry on kill.")

(defun +xwidget--session-cleanup ()
  "Remove this buffer's entry from `+xwidget--sessions' when the buffer is killed."
  (when (and +xwidget--session-id
             (eq (gethash +xwidget--session-id +xwidget--sessions)
                 (current-buffer)))
    (remhash +xwidget--session-id +xwidget--sessions)))

(config-defvar +xwidget-auto-focus-on-load nil
  "Auto-focus xwidget buffer when its page finishes loading."
  :type 'boolean
  :group 'xwidget)

(defvar-local +xwidget-suppress-auto-focus nil
  "Non-nil means this xwidget buffer must not auto-focus on load/reuse.")
(put '+xwidget-suppress-auto-focus 'permanent-local t)

(defvar-local +xwidget-focus-script nil
  "Optional JS to focus an editable element inside this xwidget buffer.
Set buffer-locally before the page loads (e.g. in the open function).")
(put '+xwidget-focus-script 'permanent-local t)

(defun +xwidget--auto-focus-allowed-p (&optional buffer)
  "Return non-nil when BUFFER may receive automatic xwidget focus."
  (let ((buf (or buffer (current-buffer))))
    (and +xwidget-auto-focus-on-load
         (buffer-live-p buf)
         (with-current-buffer buf
           (not +xwidget-suppress-auto-focus)))))

(defun +xwidget/focus (&optional buffer)
  "Focus the xwidget in BUFFER (default: current buffer) for keyboard input.
Enables edit-mode, runs any buffer-local JS focus script, and switches
to evil insert state if evil is active in the buffer."
  (interactive)
  (let ((buf (or buffer (current-buffer))))
    (when (and (buffer-live-p buf)
               (with-current-buffer buf
                 (eq major-mode 'xwidget-webkit-mode)))
      (with-current-buffer buf
        (when (fboundp 'xwidget-webkit-edit-mode)
          (ignore-errors (xwidget-webkit-edit-mode 1)))
        (when-let* ((session (and (fboundp 'xwidget-webkit-current-session)
                                  (ignore-errors (xwidget-webkit-current-session)))))
          (when (and +xwidget-focus-script
                     (fboundp 'xwidget-webkit-execute-script))
            (ignore-errors
              (xwidget-webkit-execute-script session +xwidget-focus-script))))))))

(defun +xwidget--focus-if-selected (buffer window)
  "Focus BUFFER only while WINDOW is still the selected pane showing it."
  (when (and (window-live-p window)
             (eq window (selected-window))
             (eq buffer (window-buffer window))
             (+xwidget--auto-focus-allowed-p buffer))
    (+xwidget/focus buffer)))

(defun +xwidget--load-finished-focus (xwidget _xwidget-event-type)
  "Schedule focus for XWIDGET's buffer after page load-finished."
  ;; Capture the load-finished detail immediately (last-input-event is ephemeral).
  (when (and (eq _xwidget-event-type 'load-changed)
             (string-equal (nth 3 last-input-event) "load-finished"))
    (let ((buf (and (fboundp 'xwidget-buffer)
                    (ignore-errors (xwidget-buffer xwidget)))))
      (when (and (buffer-live-p buf)
                 (+xwidget--auto-focus-allowed-p buf)
                 (eq buf (window-buffer (selected-window))))
        ;; The user may move to another pane while the page loads.
        (run-at-time 0.3 nil #'+xwidget--focus-if-selected
                     buf (selected-window))))))

(defun +xwidget--callback-update-buffer-name (xwidget xwidget-event-type)
  "Update xwidget buffer name after title or load events."
  (when (memq xwidget-event-type '(document-title-changed title-changed load-changed))
    (let ((buf (and (fboundp 'xwidget-buffer)
                    (ignore-errors (xwidget-buffer xwidget)))))
      (when (buffer-live-p buf)
        (with-current-buffer buf
          (when (and (eq major-mode 'xwidget-webkit-mode)
                     (fboundp 'xwidget-webkit-title))
            (setq-local +xwidget-session-title
                        (ignore-errors (xwidget-webkit-title xwidget))))
          (when (and (eq major-mode 'xwidget-webkit-mode)
                     (fboundp 'xwidget-webkit-uri))
            (setq-local +xwidget-session-url
                        (ignore-errors (xwidget-webkit-uri xwidget)))))
        (+xwidget-update-buffer-name buf)))))

(defun +xwidget--ensure-available ()
  "Ensure native xwidget-webkit primitives are available."
  (unless (fboundp 'xwidget-webkit-browse-url)
    (require 'xwidget))
  (unless (fboundp 'xwidget-webkit-browse-url)
    (user-error "xwidget-webkit is not available in this Emacs")))

(defun +xwidget-session-buffer (id)
  "Return live xwidget buffer for session ID, or nil."
  (let ((buffer (and id (gethash id +xwidget--sessions))))
    (if (and (buffer-live-p buffer)
             (equal (buffer-local-value '+xwidget--session-id buffer) id))
        buffer
      (when id (remhash id +xwidget--sessions))
      nil)))

(defun +xwidget-current-url (&optional buffer)
  "Return current URL for xwidget BUFFER, defaulting to current buffer."
  (let ((buffer (or buffer (current-buffer))))
    (when (buffer-live-p buffer)
      (with-current-buffer buffer
        (or +xwidget-session-url
            (and (eq major-mode 'xwidget-webkit-mode)
                 (fboundp 'xwidget-webkit-current-session)
                 (fboundp 'xwidget-webkit-uri)
                 (ignore-errors
                   (xwidget-webkit-uri (xwidget-webkit-current-session)))))))))

(defun +xwidget-current-title (&optional buffer)
  "Return current page title for xwidget BUFFER, defaulting to current buffer."
  (let ((buffer (or buffer (current-buffer))))
    (when (buffer-live-p buffer)
      (with-current-buffer buffer
        (or +xwidget-session-title
            (and (eq major-mode 'xwidget-webkit-mode)
                 (fboundp 'xwidget-webkit-current-session)
                 (fboundp 'xwidget-webkit-title)
                 (ignore-errors
                   (xwidget-webkit-title (xwidget-webkit-current-session)))))))))

(defun +xwidget--clean-title (title)
  "Return TITLE trimmed for use in an xwidget buffer name, or nil."
  (when (stringp title)
    (let ((title (string-trim title)))
      (unless (or (string-empty-p title)
                  (string-match-p "\\`\\(?:about:blank\\|Loading\\.\\.\\.\\)\\'" title))
        (truncate-string-to-width title 80 nil nil t)))))

(defun +xwidget--url-name-part (url)
  "Return a readable name derived from URL."
  (when (and (stringp url) (not (string-empty-p url)))
    (condition-case nil
        (let* ((parsed (url-generic-parse-url url))
               (host (url-host parsed))
               (path (url-filename parsed))
               (clean-path (and path (car (split-string path "[?#]" t))))
               (leaf (and clean-path
                          (not (string-empty-p clean-path))
                          (file-name-nondirectory
                           (directory-file-name clean-path)))))
          (or (+xwidget--clean-title leaf)
              (+xwidget--clean-title host)
              (+xwidget--clean-title url)))
      (error
       (+xwidget--clean-title url)))))

(defun +xwidget--preferred-buffer-name (&optional buffer)
  "Return the preferred generated xwidget name for BUFFER."
  (let* ((buffer (or buffer (current-buffer)))
         (title (+xwidget-current-title buffer))
         (url (+xwidget-current-url buffer))
         (label (or (+xwidget--clean-title title)
                    (+xwidget--url-name-part url))))
    (when label
      (format "*xwidget: %s*" label))))

(defun +xwidget--noema-owned-p (&optional buffer)
  "Return non-nil when BUFFER has Noema-specific naming."
  (let ((buffer (or buffer (current-buffer))))
    (and (buffer-live-p buffer)
         (with-current-buffer buffer
           (and (boundp '+noema--xwidget-forced-name)
                +noema--xwidget-forced-name)))))

(defun +xwidget-update-buffer-name (&optional buffer)
  "Rename BUFFER from its page title or URL when it is safe to do so."
  (let ((buffer (or buffer (current-buffer))))
    (when (buffer-live-p buffer)
      (with-current-buffer buffer
        (cond
         ((+xwidget--noema-owned-p buffer)
          (unless (equal (buffer-name) +noema--xwidget-forced-name)
            (rename-buffer +noema--xwidget-forced-name t)))
         ((and (eq major-mode 'xwidget-webkit-mode)
               (not (minibufferp)))
          (when-let* ((name (+xwidget--preferred-buffer-name buffer)))
            (when (or (null +xwidget--managed-buffer-name)
                      (equal (buffer-name) +xwidget--managed-buffer-name)
                      (string-match-p "\\`\\*xwidget\\*\\(?:<[0-9]+>\\)?\\'"
                                      (buffer-name)))
              (rename-buffer name t)
              (setq-local +xwidget--managed-buffer-name (buffer-name))))))))))

(defun +xwidget--record-buffer (buffer id url)
  "Record BUFFER as xwidget session ID with URL."
  (when (buffer-live-p buffer)
    (with-current-buffer buffer
      (when (and +xwidget--session-id
                 (not (equal +xwidget--session-id id))
                 (eq (gethash +xwidget--session-id +xwidget--sessions)
                     buffer))
        (remhash +xwidget--session-id +xwidget--sessions))
      (unless (equal +xwidget-session-url url)
        (setq-local +xwidget-session-title nil))
      (setq-local +xwidget-session-url url)
      (setq-local +xwidget-suppress-auto-focus nil)
      (when id
        (setq-local +xwidget--session-id id)
        (add-hook 'kill-buffer-hook #'+xwidget--session-cleanup nil t)))
    (when id
      (puthash id buffer +xwidget--sessions))
    (+xwidget-update-buffer-name buffer)))

(defun +xwidget--display-buffer (buffer display)
  "Display BUFFER according to DISPLAY."
  (pcase display
    ('none nil)
    ('current (switch-to-buffer buffer))
    (_ (pop-to-buffer buffer))))

(cl-defun +xwidget/open-url (url &key id (display 'side) force-new reuse-selected)
  "Open URL through the customized xwidget API.
ID identifies a stable session.  DISPLAY may be `side', `current' or `none'.
When FORCE-NEW is non-nil, replace the old buffer for ID."
  (interactive
   (list (read-string "xwidget URL: ")
         :display 'side))
  (+xwidget--ensure-available)
  (let* ((url (aaron-open-normalize-url url))
         (id (or id (format "xwidget-%d" (cl-incf +xwidget--session-counter))))
         (existing (+xwidget-session-buffer id)))
    (when (and existing force-new)
      (remhash id +xwidget--sessions)
      (kill-buffer existing)
      (setq existing nil))
    (if existing
        (progn
          (if (and (fboundp 'xwidget-webkit-current-session)
                   (fboundp 'xwidget-webkit-goto-uri))
              (with-current-buffer existing
                (xwidget-webkit-goto-uri (xwidget-webkit-current-session) url))
            (user-error "xwidget-webkit-goto-uri is not available"))
          (+xwidget--record-buffer existing id url)
          (+xwidget--display-buffer existing display)
          ;; Page already loaded — no load-finished will fire; schedule focus.
          (when (and (+xwidget--auto-focus-allowed-p existing)
                     (eq existing (window-buffer (selected-window))))
            (run-at-time 0.3 nil #'+xwidget--focus-if-selected
                         existing (selected-window)))
          existing)
      (let ((buffer
             (if (eq display 'side)
                 (aaron-open--with-browser-window
                  'xwidget-webkit-mode reuse-selected
                  (lambda ()
                    (xwidget-webkit-browse-url url t)
                    (current-buffer)))
               (xwidget-webkit-browse-url url t)
               (current-buffer))))
        (+xwidget--record-buffer buffer id url)
        (+xwidget--display-buffer buffer display)
        buffer))))

(defun +xwidget/open-url-current (url)
  "Open URL in xwidget using the selected window."
  (interactive (browse-url-interactive-arg "xwidget URL: "))
  (+xwidget/open-url url :display 'current :reuse-selected t))

(defun +xwidget/reload ()
  "Reload the current xwidget page through the customized API."
  (interactive)
  (if (fboundp 'xwidget-webkit-reload)
      (call-interactively #'xwidget-webkit-reload)
    (user-error "xwidget reload is not available")))

(defun +xwidget/back ()
  "Navigate the current xwidget page backward."
  (interactive)
  (cond
   ((and (bound-and-true-p +noema-keys-mode)
         (fboundp '+noema/back))
    (+noema/back))
   ((fboundp 'xwidget-webkit-back)
    (call-interactively #'xwidget-webkit-back))
   (t (user-error "xwidget back is not available"))))

(defun +xwidget/forward ()
  "Navigate the current xwidget page forward."
  (interactive)
  (cond
   ((and (bound-and-true-p +noema-keys-mode)
         (fboundp '+noema/forward))
    (+noema/forward))
   ((fboundp 'xwidget-webkit-forward)
    (call-interactively #'xwidget-webkit-forward))
   (t (user-error "xwidget forward is not available"))))

(defun +xwidget/copy-selection ()
  "Copy selection from the current xwidget page."
  (interactive)
  (if (fboundp 'xwidget-webkit-copy-selection-as-kill)
      (call-interactively #'xwidget-webkit-copy-selection-as-kill)
    (user-error "xwidget copy selection is not available")))

(defun +xwidget/copy-url ()
  "Copy current xwidget URL."
  (interactive)
  (if-let* ((url (+xwidget-current-url)))
      (progn
        (kill-new url)
        (message "Copied URL."))
    (user-error "No xwidget URL available")))

(defun +xwidget/open-task-manager ()
  "Compatibility command for the current Noema page's task manager."
  (interactive)
  (unless (fboundp '+noema/task-manager)
    (require 'noema/bridge/config))
  (+noema/task-manager))

(defun +xwidget--execute-script (script)
  "Execute JavaScript SCRIPT in the current xwidget session."
  (unless (and (fboundp 'xwidget-webkit-current-session)
               (fboundp 'xwidget-webkit-execute-script))
    (user-error "xwidget script execution is not available"))
  (let ((session (xwidget-webkit-current-session)))
    (unless session
      (user-error "No current xwidget session"))
    (xwidget-webkit-execute-script session script)))

(defun +xwidget--keyboard-command-script (key code modifiers fallback-command)
  "Return JavaScript that dispatches a keyboard command with FALLBACK-COMMAND."
  (format
   "(() => {
  const target = document.activeElement
    || document.querySelector('.cm-content, [contenteditable=\"true\"], textarea, input')
    || document.body;
  const event = new KeyboardEvent('keydown', {
    key: %S,
    code: %S,
    metaKey: %s,
    ctrlKey: %s,
    altKey: %s,
    shiftKey: %s,
    bubbles: true,
    cancelable: true
  });
  const handled = !target.dispatchEvent(event) || event.defaultPrevented;
  if (!handled && document.queryCommandSupported && document.queryCommandSupported(%S)) {
    document.execCommand(%S);
  }
  return true;
})()"
   key
   code
   (if (plist-get modifiers :meta) "true" "false")
   (if (plist-get modifiers :ctrl) "true" "false")
   (if (plist-get modifiers :alt) "true" "false")
   (if (plist-get modifiers :shift) "true" "false")
   fallback-command
   fallback-command))

(defun +xwidget/undo ()
  "Run undo in the current xwidget page."
  (interactive)
  (+xwidget--execute-script
   (+xwidget--keyboard-command-script
    "z" "KeyZ" '(:meta t) "undo")))

(defun +xwidget/redo ()
  "Run redo in the current xwidget page."
  (interactive)
  (+xwidget--execute-script
   (+xwidget--keyboard-command-script
    "Z" "KeyZ" '(:meta t :shift t) "redo")))

(defun +xwidget-keep-emacs-prefix-keys (map)
  "Remove xwidget bindings that should remain normal Emacs keys in MAP."
  (dolist (key '("M-x" "C-x C-f" "C-x" "C-c" "C-s" "C-g" "M-w" "M-q"))
    (define-key map (kbd key) nil)))

(defun +xwidget-pass-editing-keys (map)
  "Send editing/navigation keys in MAP to WebKit instead of Emacs."
  (when (fboundp 'xwidget-webkit-pass-command-event)
    (dolist (key '("<escape>"
                   "<delete>"
                   "<backspace>"
                   "DEL"
                   "RET"
                   "<return>"
                   "TAB"
                   "<tab>"
                   "<backtab>"
                   "<iso-lefttab>"
                   "S-TAB"
                   "S-<tab>"
                   "<left>"
                   "<right>"
                   "<up>"
                   "<down>"
                   "<home>"
                   "<end>"
                   "<prior>"
                   "<next>"
                   ;; macOS: Cmd = Meta; pass clipboard shortcuts to WebKit
                   "M-c"
                   "M-v"))
      (define-key map (kbd key) #'xwidget-webkit-pass-command-event))))

(defun +xwidget-pass-pointer-keys (map)
  "Send pointer wheel events in MAP to WebKit instead of Emacs scrolling."
  (when (fboundp 'xwidget-webkit-pass-command-event)
    (dolist (key '([wheel-up]
                   [wheel-down]
                   [wheel-left]
                   [wheel-right]
                   [double-wheel-up]
                   [double-wheel-down]
                   [double-wheel-left]
                   [double-wheel-right]
                   [triple-wheel-up]
                   [triple-wheel-down]
                   [triple-wheel-left]
                   [triple-wheel-right]
                   [mouse-4]
                   [mouse-5]))
      (define-key map key #'xwidget-webkit-pass-command-event))))

(defun +xwidget--split-to-ibuffer (split-fn)
  "Run SPLIT-FN, select the new window, and show `ibuffer'."
  (let ((window (funcall split-fn)))
    (select-window window)
    (ibuffer)))

(defun +xwidget/split-window-below-ibuffer ()
  "Split below from xwidget and show `ibuffer' in the new window."
  (interactive)
  (+xwidget--split-to-ibuffer #'split-window-below))

(defun +xwidget/split-window-right-ibuffer ()
  "Split right from xwidget and show `ibuffer' in the new window."
  (interactive)
  (+xwidget--split-to-ibuffer #'split-window-right))

