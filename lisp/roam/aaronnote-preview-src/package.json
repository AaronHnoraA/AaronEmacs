{
  "name": "emacs-markdown-preview-runtime",
  "version": "0.3.1",
  "description": "Self-contained read-only Markdown preview runtime for Emacs.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vp dev --config vite.preview.config.ts --host 127.0.0.1",
    "build": "tsc && vp build --config vite.preview.config.ts"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/turndown": "^5.0.6",
    "typescript": "~6.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vite-plus": "latest"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@latest",
    "vitest": "npm:@voidzero-dev/vite-plus-test@latest"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "@lezer/common": "^1.5.2",
    "@lezer/markdown": "^1.6.3",
    "dompurify": "^3.4.4",
    "katex": "^0.16.47",
    "markdown-it": "^14.1.1",
    "markdown-it-emoji": "^3.0.0",
    "mermaid": "^11.15.0",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  }
}
