    payload: dict[str, object]


def should_skip(path: Path) -> bool:
    return any(part in SKIP_DIRS for part in path.parts)


def project_rel_path(path: Path) -> Path:
    try:
        return path.relative_to(ROOT)
    except ValueError:
        pass
    try:
        return Path("roam") / path.resolve().relative_to(ROAM_ROOT.resolve())
    except ValueError as err:
        raise ValueError(f"path is outside publish root: {path}") from err


def iter_project_files() -> Iterator[Path]:
    seen_dirs: set[tuple[int, int]] = set()

    def _walk(walk_root: Path, rel_base: Path | None = None) -> Iterator[Path]:
        for dirpath, dirnames, filenames in os.walk(walk_root, followlinks=True, onerror=lambda _err: None):
            current = Path(dirpath)
            try:
                stat = current.stat()
            except OSError:
                dirnames[:] = []
                continue
            key = (stat.st_dev, stat.st_ino)
            if key in seen_dirs:
                dirnames[:] = []
                continue
            seen_dirs.add(key)
            if rel_base is not None:
                rel_dir = rel_base / current.relative_to(walk_root)
            else:
                try:
                    rel_dir = current.relative_to(ROOT)
                except ValueError:
                    dirnames[:] = []
                    continue
            dirnames[:] = [d for d in dirnames if not should_skip(rel_dir / d)]
            for filename in filenames:
                yield current / filename

    yield from _walk(ROOT)
    # Walk ROAM_ROOT directly when ROOT/roam is not a live symlink to it.
    roam_link = ROOT / "roam"
    if not (roam_link.is_symlink() and roam_link.resolve() == ROAM_ROOT.resolve()):
        if ROAM_ROOT.exists():
            yield from _walk(ROAM_ROOT, rel_base=Path("roam"))


def parse_metadata_block(text: str) -> tuple[dict[str, object], str]:
    match = ORG_META_RE.match(text)
    if match:
        return parse_meta_lines(match.group(1), org_style=True), text[match.end():]
    match = FRONT_MATTER_RE.match(text)
    if not match:
        return {}, text
    return parse_meta_lines(match.group(1), org_style=False), text[match.end():]


def parse_meta_lines(raw: str, org_style: bool) -> dict[str, object]:
    metadata: dict[str, object] = {}
    current_list: str | None = None
    for raw_line in raw.splitlines():
        line = raw_line.rstrip()
        item = re.match(r"^\s*-\s*(.+?)\s*$", line)
        if item and current_list:
            metadata.setdefault(current_list, [])
            assert isinstance(metadata[current_list], list)
            metadata[current_list].append(parse_yaml_scalar(item.group(1)))
            continue
        pair = re.match(r"^([A-Za-z0-9_-]+):(?:\s*(.*))?$", line)
        if not pair:
            continue
        key, value = pair.group(1), (pair.group(2) or "").strip()
        if value == "":
            metadata[key] = []
            current_list = key
        else:
            if org_style and key in {"tags", "aliases", "refs"}:
                metadata[key] = [normalize_meta_string(part) for part in value.split(",") if part.strip()]
            else:
                metadata[key] = parse_yaml_scalar(value)
            current_list = None
    return metadata


def normalize_meta_string(value: object) -> str:
    return str(value).strip().strip('"').replace("\\_", "_")


def normalize_note_kind(value: object) -> str:
    if isinstance(value, list):
        value = value[0] if value else ""
    kind = normalize_meta_string(value).lower()
    if kind in DEFAULT_NOTE_KIND_ALIASES:
        return DEFAULT_NOTE_KIND
    if not KIND_NAME_RE.fullmatch(kind):
        return DEFAULT_NOTE_KIND
    return kind


def note_kind_from_metadata(metadata: dict[str, object]) -> str:
    return normalize_note_kind(metadata.get("kind") or metadata.get("kinds") or DEFAULT_NOTE_KIND)


def active_note_kind(note: Note) -> str:
    return "" if note.kind == DEFAULT_NOTE_KIND else note.kind


def script_json(value: object) -> str:
    return (
        json.dumps(value, ensure_ascii=False)
        .replace("<", "\\u003c")
        .replace(">", "\\u003e")
        .replace("&", "\\u0026")
    )


def parse_yaml_scalar(value: str) -> object:
    value = value.strip()
    if value in {"true", "false"}:
        return value == "true"
    if value.startswith('"') and value.endswith('"'):
        return value[1:-1].replace('\\"', '"').replace("\\\\", "\\").replace("\\_", "_")
    return value.replace("\\_", "_")


def truthy(value: object) -> bool:
    if isinstance(value, bool):
        return value
    return str(value or "").strip().lower() in {"true", "yes", "private", "hidden", "sealed", "no-export"}


def book_meta_from_metadata(metadata: dict[str, object]) -> tuple[str, str]:
    value = metadata.get("book")
    if value is True:
        return "cover", ""
    raw = normalize_meta_string(value)
    if not raw:
        return "", ""
    if raw.lower() in {"true", "yes", "book"}:
        return "cover", ""
    match = re.match(r"^included@(.+)$", raw, flags=re.I)
    if match:
        return "included", match.group(1).strip()
    return "", ""


def include_refs_from_text(text: str) -> list[str]:
    return [match.group(1).strip() for match in INCLUDE_RE.finditer(text) if match.group(1).strip()]


def safe_book_cache_name(book_id: str) -> str:
    safe = re.sub(r"[\\/:\0]+", "_", str(book_id or "book").strip()) or "book"
    return f"{safe}.json"


def sha256_text(text: str) -> str:
    return hashlib.sha256(text.encode("utf-8")).hexdigest()


def strip_meta_block(text: str) -> str:
    _metadata, body = parse_metadata_block(text)
    return body.lstrip()


def slug_book_anchor(value: str) -> str:
    slug = re.sub(r"\s+", " ", str(value or "")).strip().lower()
    slug = re.sub(r"[\x00-\x1f\x7f]", "", slug)
    slug = re.sub(r"""[!"#$%&'()*+,./:;<=>?@[\\\]^`{|}~]""", "", slug)
    slug = re.sub(r"\s+", "-", slug)
    slug = re.sub(r"-+", "-", slug).strip("-")
    return slug or "section"


def book_headings_from_text(text: str, note: Note, used: set[str]) -> list[dict[str, object]]:
    body = strip_meta_block(text)
    headings: list[dict[str, object]] = []
    has_h1 = False
    for line in body.splitlines():
        match = re.match(r"^\s{0,3}(#{1,6})\s+(.+?)\s*#*\s*$", line)
        if not match:
            continue
        level = len(match.group(1))
        has_h1 = has_h1 or level == 1
        if level > 3:
            continue
        title = match.group(2).strip() or "Untitled"
        slug = slug_book_anchor(title)
        base = slug
        suffix = 2
        while slug in used:
            slug = f"{base}-{suffix}"
            suffix += 1
        used.add(slug)
        headings.append({"level": level, "text": title, "slug": slug, "path": note.rel_path, "id": note.id})
    if not has_h1 and note.title:
        slug = slug_book_anchor(note.title)
        base = slug
        suffix = 2
        while slug in used:
            slug = f"{base}-{suffix}"
            suffix += 1
        used.add(slug)
        headings.insert(0, {"level": 1, "text": note.title, "slug": slug, "path": note.rel_path, "id": note.id})
    return headings


def resolve_include_path(note: Note, raw_ref: str) -> Path | None:
    raw = unquote(str(raw_ref or "").split("#", 1)[0].split("?", 1)[0]).strip()
    if not raw or re.match(r"^[a-z][a-z0-9+.-]*:", raw, flags=re.I):
        return None
    path = Path(raw)
    resolved = (path if path.is_absolute() else note.path.parent / path).resolve()
    try:
        resolved.relative_to(ROAM_ROOT.resolve())
    except ValueError:
        return None
    return resolved


def canonical_book_ref(value: object) -> str:
    raw = normalize_meta_string(value).replace("\\", "/")
    raw = re.sub(r"^roam://", "", raw, flags=re.I)
    raw = raw.split("#", 1)[0].split("@", 1)[0].split("?", 1)[0]
    raw = unquote(raw).strip().lstrip("./")
    parts: list[str] = []
    for part in raw.split("/"):
        if not part or part == ".":
            continue
        if part == "..":
            if parts:
                parts.pop()
            continue
        parts.append(part)
    return "/".join(parts).lower()


def note_book_ref_values(note: Note) -> list[str]:
    return [
        note.id,
        note.title,
        note.rel_path,
        note.link,
        note.path.as_posix(),
        note.path.name,
        *note.aliases,
    ]


def private_metadata_p(metadata: dict[str, object], tags: list[str]) -> bool:
    normalized_tags = {tag.lower() for tag in tags}
    visibility = str(metadata.get("visibility") or metadata.get("access") or "").strip().lower()
    return (
        truthy(metadata.get("private"))
        or truthy(metadata.get("hidden"))
        or truthy(metadata.get("sealed"))
        or metadata.get("publish") is False
        or visibility in {"private", "hidden", "sealed"}
        or bool(normalized_tags & {"private", "hidden", "sealed", "no-export", "noexport"})
    )


def private_path_p(rel_path: Path) -> bool:
    return any(rel_path == prefix or prefix in rel_path.parents for prefix in PRIVATE_PATH_PREFIXES)


def _load_sensitive_tags() -> frozenset[str]:
    if not SENSITIVE_TAGS_FILE.exists():
        return frozenset()
    try:
        data = json.loads(SENSITIVE_TAGS_FILE.read_text(encoding="utf-8"))
    except (json.JSONDecodeError, OSError):
        return frozenset()
    items = data if isinstance(data, list) else data.get("tags", []) if isinstance(data, dict) else []
    return frozenset(str(t).strip().lower() for t in items if t)


SENSITIVE_TAGS: frozenset[str] = _load_sensitive_tags()


def filter_sensitive_tags(tags: list[str]) -> list[str]:
    """Mask tags that match sensitive-tags.json while preserving tag graph edges."""
    if not SENSITIVE_TAGS:
        return tags
    return [
        sealed_tag_mask(t.strip().lower()) if t.strip().lower() in SENSITIVE_TAGS else t
        for t in tags
    ]


def sanitize_published_metadata_tags(text: str) -> str:
    if not SENSITIVE_TAGS:
        return text

    def mask_csv(value: str) -> str:
        return ", ".join(filter_sensitive_tags([part.strip() for part in value.split(",") if part.strip()]))

    org_match = ORG_META_RE.match(text)
    if org_match:
        body = org_match.group(1)

        def replace_org_tags(match: re.Match[str]) -> str:
            return f"{match.group(1)}{mask_csv(match.group(2))}"

        masked = re.sub(r"(?im)^([ \t]*tags:[ \t]*)(.*?)$", replace_org_tags, body)
        return text[:org_match.start(1)] + masked + text[org_match.end(1):]

    yaml_match = FRONT_MATTER_RE.match(text)
    if yaml_match:
        body = yaml_match.group(1)
        lines = body.splitlines()
        out: list[str] = []
        in_tags_list = False
        tag_indent = ""
        for line in lines:
            tag_line = re.match(r"^([ \t]*tags:[ \t]*)(.*?)$", line, flags=re.I)
            if tag_line:
                value = tag_line.group(2)
                if value:
                    out.append(f"{tag_line.group(1)}{mask_csv(value)}")
                    in_tags_list = False
                else:
                    out.append(line)
                    in_tags_list = True
                    tag_indent = tag_line.group(1).split("tags:", 1)[0]
                continue
            item = re.match(r"^([ \t]*)-[ \t]*(.*?)[ \t]*$", line)
            if in_tags_list and item and item.group(1).startswith(tag_indent):
                tag = item.group(2)
                out.append(f"{item.group(1)}- {filter_sensitive_tags([tag])[0] if tag else tag}")
                continue
            if in_tags_list and line.strip() and not line.startswith((" ", "\t")):
                in_tags_list = False
            out.append(line)
        masked = "\n".join(out)
        return text[:yaml_match.start(1)] + masked + text[yaml_match.end(1):]

    return text


def clean_markdown_text(text: str) -> str:
    _metadata, body = parse_metadata_block(text)
    body = re.sub(r"```.*?```", " ", body, flags=re.S)
    body = re.sub(r"<!--.*?-->", " ", body, flags=re.S)
    previous = None
    while previous != body:
        previous = body
        body = ORG_ENV_RE.sub(lambda match: match.group(3), body)
    body = re.sub(r"(?m)^#\+(?:begin|end)(?:_|\s+)[^\n]*", " ", body)
    body = re.sub(r"!\[[^\]]*\]\([^)]+\)", " ", body)
    body = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", body)
    body = re.sub(r"#+|[*_`$>|-]", " ", body)
    return " ".join(body.split())


def private_asset_paths(note: Note) -> set[Path]:
    if not note.private:
        return set()
    try:
        text = note.path.read_text(encoding="utf-8")
    except OSError:
        return set()
    paths: set[Path] = set()
    for raw_path in MD_IMAGE_RE.findall(text):
        asset_path = Path(raw_path.split("#", 1)[0])
        if asset_path.is_absolute():
            paths.add(asset_path.resolve())
        else:
            paths.add((note.path.parent / asset_path).resolve())
    for rel_dir in (
        Path("img") / note.path.stem,
        Path("assets") / "img" / note.path.stem,
    ):
        directory = note.path.parent / rel_dir
        if directory.exists():
            paths.update(path.resolve() for path in directory.rglob("*") if path.is_file())
    return paths


def private_static_asset_paths(notes: list[Note]) -> set[Path]:
    paths: set[Path] = set()
    for note in notes:
        paths.update(private_asset_paths(note))
    for prefix in PRIVATE_PATH_PREFIXES:
        parts = Path(prefix).parts
        if parts and parts[0] == "roam":
            directory = ROAM_ROOT / Path(*parts[1:]) if len(parts) > 1 else ROAM_ROOT
        else:
            directory = ROOT / prefix
        if directory.exists():
            paths.update(
                path.resolve()
                for path in directory.rglob("*")
                if path.is_file() and path.suffix.lower() in NOTE_STATIC_EXTENSIONS
            )
    return paths


def parse_note(path: Path) -> Note | None:
    text = path.read_text(encoding="utf-8")
    metadata, _body = parse_metadata_block(text)
    book_role, book_parent_ref = book_meta_from_metadata(metadata)
    note_id = metadata.get("id") or (project_rel_path(path).as_posix() if book_role == "included" else "")
    if not note_id:
        return None
    rel = project_rel_path(path)
    rel_path = rel.as_posix()
    tags = [str(tag) for tag in metadata.get("tags", [])] if isinstance(metadata.get("tags"), list) else []
    aliases = [str(alias) for alias in metadata.get("aliases", [])] if isinstance(metadata.get("aliases"), list) else []
    private = private_path_p(rel) or private_metadata_p(metadata, tags)
    refs = sorted(set(MD_LINK_RE.findall(text)))
    search_text = "This note has been sealed by the administrator." if private else clean_markdown_text(text)
    return Note(
        path=path,
        rel_path=rel_path,
        id=str(note_id),
        title=str(metadata.get("title") or path.stem),
        date=str(metadata.get("date") or "Undated"),
        tags=tags,
        aliases=aliases,
        kind=note_kind_from_metadata(metadata),
        summary=search_text[:180],
        search_text=search_text,
        refs=refs,
        private=private,
        book_role=book_role,
        book_parent_ref=book_parent_ref,
        book_cover_id=str(note_id) if book_role == "cover" else "",
        book_include_refs=include_refs_from_text(text),
    )


def first_markdown_heading(text: str) -> str | None:
    for line in text.splitlines():
        match = re.match(r"^\s*#\s+(.+?)\s*$", line)
        if match:
            return match.group(1).strip()
    return None


def parse_note_for_export(path: Path) -> Note:
    note = parse_note(path)
    if note:
        return note

    text = path.read_text(encoding="utf-8")
    metadata, body = parse_metadata_block(text)
    rel = project_rel_path(path)
    rel_path = rel.as_posix()
    tags = [str(tag) for tag in metadata.get("tags", [])] if isinstance(metadata.get("tags"), list) else []
    aliases = [str(alias) for alias in metadata.get("aliases", [])] if isinstance(metadata.get("aliases"), list) else []
    private = private_path_p(rel) or private_metadata_p(metadata, tags)
    book_role, book_parent_ref = book_meta_from_metadata(metadata)
    note_id = str(metadata.get("id") or (rel_path if book_role == "included" else path.stem))
    return Note(
        path=path,
        rel_path=rel_path,
        id=note_id,
        title=str(metadata.get("title") or first_markdown_heading(body) or path.stem),
        date=str(metadata.get("date") or "Undated"),
        tags=tags,
        aliases=aliases,
        kind=note_kind_from_metadata(metadata),
        summary=clean_markdown_text(text)[:180],
        search_text=clean_markdown_text(text),
        refs=sorted(set(MD_LINK_RE.findall(text))),
        private=private,
        book_role=book_role,
        book_parent_ref=book_parent_ref,
        book_cover_id=note_id if book_role == "cover" else "",
        book_include_refs=include_refs_from_text(text),
    )


def find_notes() -> list[Note]:
    notes: list[Note] = []
    for path in iter_project_files():
        if path.suffix != ".md":
            continue
        try:
            rel = project_rel_path(path)
        except ValueError:
            continue
        if should_skip(rel) or path.name.endswith("~"):
            continue
        if not rel.parts or rel.parts[0] != "roam":
            continue
        note = parse_note(path)
        if note:
            notes.append(note)
    return sorted(notes, key=lambda note: (note.date, note.title), reverse=True)


def resolve_book_ref(notes: list[Note], ref: str, from_note: Note | None = None) -> Note | None:
    raw = str(ref or "").strip()
    if not raw:
        return None
    if from_note and ("/" in raw or re.search(r"\.(md|markdown|typ)$", raw.split("#", 1)[0], flags=re.I)):
        resolved = resolve_include_path(from_note, raw)
        if resolved:
            for note in notes:
                if note.path.resolve() == resolved:
                    return note
    key = canonical_book_ref(raw)
    if not key:
        return None
    for note in notes:
        if any(canonical_book_ref(value) == key for value in note_book_ref_values(note)):
            return note
    return None


def apply_book_metadata(notes: list[Note]) -> None:
    covers = [note for note in notes if note.book_role == "cover" and note.id]
    if not covers:
        return
    notes_by_file = {note.path.resolve(): note for note in notes}
    cover_by_id = {note.id: note for note in covers}
    included_by_cover: dict[str, list[Note]] = {note.id: [] for note in covers}
    diagnostics_by_cover: dict[str, list[dict[str, object]]] = {note.id: [] for note in covers}
    tree_by_cover: dict[str, dict[str, object] | None] = {note.id: None for note in covers}

    for note in notes:
        note.book_cover_id = note.id if note.book_role == "cover" else ""
        note.book_cover_path = ""
        note.book_parent_path = ""
        note.book_included_paths = []
        note.book_toc = []
        note.book_dom_targets = []
        note.book_raw_refs = []
        note.book_diagnostics = []

    def mark_included(note: Note, cover: Note, parent: Note | None) -> None:
        if note.path == cover.path:
            return
        note.book_role = "included"
        note.book_cover_id = cover.id
        note.book_cover_path = cover.rel_path
        note.book_parent_path = parent.rel_path if parent else ""
        items = included_by_cover.setdefault(cover.id, [])
        if not any(item.path == note.path for item in items):
            items.append(note)

    def visit(cover: Note, note: Note, parent: Note | None, stack: list[Path]) -> dict[str, object] | None:
        resolved = note.path.resolve()
        if resolved in stack:
            diagnostics_by_cover[cover.id].append({
                "level": "error",
                "path": note.rel_path,
                "message": "Book include cycle: " + " -> ".join(
                    notes_by_file.get(path, note).rel_path for path in [*stack, resolved]
                ),
            })
            return None
        if note != cover:
            mark_included(note, cover, parent)
        node: dict[str, object] = {
            "id": note.id,
            "title": note.title,
            "path": note.rel_path,
            "role": "cover" if note == cover else "included",
            "children": [],
        }
        children: list[dict[str, object]] = []
        for raw_ref in note.book_include_refs:
            child_path = resolve_include_path(note, raw_ref)
            child = notes_by_file.get(child_path) if child_path else None
            if not child:
                diagnostics_by_cover[cover.id].append({
                    "level": "error",
                    "path": note.rel_path,
                    "message": f"Included note not found or outside note root: {raw_ref}",
                })
                continue
            if child.book_role == "cover" and child.id != cover.id:
                diagnostics_by_cover[cover.id].append({
                    "level": "error",
                    "path": note.rel_path,
                    "message": f"Cannot include another book cover: {child.rel_path}",
                })
                continue
            child_node = visit(cover, child, note, [*stack, resolved])
            if child_node:
                children.append(child_node)
        node["children"] = children
        return node

    def cover_from_parent_chain(note: Note, seen: set[Path] | None = None) -> Note | None:
        seen = seen or set()
        if note.path in seen or not note.book_parent_ref:
            return None
        seen.add(note.path)
        parent = resolve_book_ref(notes, note.book_parent_ref, note)
        if not parent:
            return None
        if parent.book_role == "cover":
            return parent
        return cover_from_parent_chain(parent, seen)

    for cover in covers:
        tree_by_cover[cover.id] = visit(cover, cover, None, [])

    for note in [item for item in notes if item.book_role == "included"]:
        cover = cover_by_id.get(note.book_cover_id) or cover_from_parent_chain(note)
        if cover:
            mark_included(note, cover, resolve_book_ref(notes, note.book_parent_ref, note))

    for cover_id, included in included_by_cover.items():
        cover = cover_by_id[cover_id]
        book_notes = [cover, *included]
        refs = set(cover.refs)
        book_raw_refs: set[str] = set()
        inline_tags: set[str] = set()
        summaries = [cover.summary]
        toc: list[dict[str, object]] = []
        used: set[str] = set()
        for note in book_notes:
            try:
                text = note.path.read_text(encoding="utf-8")
            except OSError:
                text = ""
            refs.update(MD_LINK_RE.findall(text))
            book_raw_refs.update(MD_LINK_RE.findall(text))
            inline_tags.update(re.findall(r"@@tag\[([^\]\n]+)\]", text))
            if note != cover and note.summary:
                summaries.append(note.summary)
            toc.extend(book_headings_from_text(text, note, used))
        cover.refs = sorted(ref for ref in refs if ref)
        cover.book_raw_refs = sorted(ref for ref in book_raw_refs if ref)
        cover.summary = " ".join(" ".join(summaries).split())[:220]
        cover.book_included_paths = [note.rel_path for note in included]
        cover.book_toc = toc
        cover.book_dom_targets = [
            {"label": item["text"], "slug": item["slug"], "path": item["path"], "level": item["level"]}
            for item in toc
        ]
        cover.book_diagnostics = diagnostics_by_cover.get(cover.id, [])
        cover.book_cover_id = cover.id
    write_book_caches(covers, included_by_cover, tree_by_cover, diagnostics_by_cover)


def write_book_caches(
    covers: list[Note],
    included_by_cover: dict[str, list[Note]],
    tree_by_cover: dict[str, dict[str, object] | None],
    diagnostics_by_cover: dict[str, list[dict[str, object]]],
) -> None:
    BOOK_CACHE_DIR.mkdir(parents=True, exist_ok=True)
    updated_at = subprocess.check_output(["date", "-u", "+%Y-%m-%dT%H:%M:%SZ"], text=True).strip()
    index: dict[str, object] = {"schema": BOOK_CACHE_SCHEMA, "updatedAt": updated_at, "books": {}}
    books = index["books"]
    assert isinstance(books, dict)
    for cover in covers:
        included = included_by_cover.get(cover.id, [])
        files = []
        for note in [cover, *included]:
            try:
                text = note.path.read_text(encoding="utf-8")
                stat = note.path.stat()
                files.append({
                    "path": note.rel_path,
                    "mtimeMs": stat.st_mtime * 1000,
                    "size": stat.st_size,
                    "sha256": sha256_text(text),
                })
            except OSError:
                files.append({"path": note.rel_path, "missing": True})
        cache_file = safe_book_cache_name(cover.id)
        cache = {
            "schema": BOOK_CACHE_SCHEMA,
            "id": cover.id,
            "title": cover.title,
            "coverPath": cover.rel_path,
            "updatedAt": updated_at,
            "files": files,
            "includeTree": tree_by_cover.get(cover.id),
            "toc": cover.book_toc,
            "anchors": cover.book_dom_targets,
            "diagnostics": diagnostics_by_cover.get(cover.id, []),
            "hash": sha256_text(json.dumps(files, ensure_ascii=False, sort_keys=True)),
        }
        (BOOK_CACHE_DIR / cache_file).write_text(json.dumps(cache, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
        books[cover.id] = {
            "id": cover.id,
            "title": cover.title,
            "coverPath": cover.rel_path,
            "cacheFile": cache_file,
            "updatedAt": updated_at,
        }
    (BOOK_CACHE_DIR / "index.json").write_text(json.dumps(index, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def deps_file_for(output_file: Path, output_root: Path = PUBLIC) -> Path:
    rel = output_file.relative_to(output_root)
    return STATE_DIR / "deps" / rel.with_suffix(".json")


def publish_forced() -> bool:
    return os.environ.get("PUBLISH_FORCE") == "1"


def git_head(cwd: Path = ROOT) -> str | None:
    try:
        return subprocess.check_output(["git", "rev-parse", "HEAD"], cwd=cwd, text=True).strip()
    except (subprocess.CalledProcessError, FileNotFoundError):
        return None


def roam_git_head() -> str | None:
    """HEAD of the AaronNote roam repo (separate git repo, symlinked at ROOT/roam)."""
    return git_head(ROAM_ROOT)


def roam_inputs_dirty() -> bool:
    try:
        output = subprocess.check_output(
            ["git", "status", "--porcelain", "--untracked-files=all"],
            cwd=ROAM_ROOT,
            text=True,
        )
    except (subprocess.CalledProcessError, FileNotFoundError):
        return True
    return bool(output.strip())


def git_inputs_dirty() -> bool:
    """Return True if ASSETS_DIR has uncommitted changes (modified or untracked)."""
    try:
        output = subprocess.check_output(
            ["git", "status", "--porcelain", "--untracked-files=all", "."],
            cwd=ASSETS_DIR,
            text=True,
        )
        return bool(output.strip())
    except (subprocess.CalledProcessError, FileNotFoundError):
        return False


def publish_outputs_exist(notes: list[Note]) -> bool:
    required = [PUBLIC / "js" / "data.js", PUBLIC / "index.html", PUBLIC / "notes.html"]
    required.extend(PUBLIC / note.link for note in notes)
    return all(path.exists() for path in required)


def publish_state_current(notes: list[Note], head: str | None, roam_head: str | None) -> bool:
    if publish_forced() or not head or roam_inputs_dirty() or git_inputs_dirty() or not PUBLISH_STATE.exists():
        return False
    try:
        state = json.loads(PUBLISH_STATE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    return (
        state.get("gitHead") == head
        and state.get("roamGitHead") == roam_head
        and state.get("dirty") is False
        and state.get("noteCount") == len(notes)
        and publish_outputs_exist(notes)
    )


def write_publish_state(notes: list[Note], rendered: int, skipped: int, head: str | None, roam_head: str | None) -> None:
    state = {
        "gitHead": head,
        "roamGitHead": roam_head,
        "dirty": git_inputs_dirty() or roam_inputs_dirty(),
        "noteCount": len(notes),
        "rendered": rendered,
        "skipped": skipped,
    }
    PUBLISH_STATE.write_text(json.dumps(state, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")


def path_from_dep(dep: str) -> Path:
    path = Path(dep)
    return path if path.is_absolute() else ROOT / path


def output_is_current(output_file: Path, deps_file: Path) -> bool:
    if publish_forced():
        return False
    if not output_file.exists() or not deps_file.exists():
        return False
    try:
        deps = json.loads(deps_file.read_text(encoding="utf-8")).get("inputs", [])
    except (OSError, json.JSONDecodeError):
        return False
    output_mtime = output_file.stat().st_mtime
    for dep in deps:
        dep_path = path_from_dep(str(dep))
        if not dep_path.exists() or dep_path.stat().st_mtime > output_mtime:
            return False
    return True


def deps_for_note(note: Note, notes_by_rel: dict[str, Note] | None = None) -> set[str]:
    deps = {
        note.public_path if note.private else project_rel_path(note.path).as_posix(),
        str(RUNTIME_ROOT / "scripts" / "render-html.mjs"),
        str(RUNTIME_ROOT / "aaronnote" / "style.css"),
        str(RUNTIME_ROOT / "aaronnote" / "published-toc.js"),
        str(RUNTIME_ROOT / "aaronnote" / "published-local-graph.js"),
        str(RUNTIME_ROOT / "js" / "note-page.js"),
        str(RUNTIME_ROOT / "src" / "styles" / "theme-aaronnote.css"),
        str(RUNTIME_ROOT / "src" / "styles" / "widgets.css"),
        str(RUNTIME_ROOT / "src" / "styles" / "theme-typora.css"),
        str(ASSETS_DIR / "css" / "aaronnote-published.css"),
    }
    src_dir = RUNTIME_ROOT / "src"
    if src_dir.exists():
        deps.update(str(path) for path in src_dir.glob("**/*.ts"))
    lean_path = lean_mirror_path(note.path)
    try:
        note_has_lean_regions = bool(MARKDOWN_LEAN_TAG_RE.search(note.path.read_text(encoding="utf-8")))
    except OSError:
        note_has_lean_regions = False
    if lean_path.exists() or note_has_lean_regions:
        deps.add(project_rel_path(lean_path).as_posix())
    if notes_by_rel and note.book_role == "cover":
        for rel_path in note.book_included_paths:
            child = notes_by_rel.get(rel_path)
            if not child:
                continue
            deps.add(project_rel_path(child.path).as_posix())
            child_lean = lean_mirror_path(child.path)
            try:
                child_has_lean = bool(MARKDOWN_LEAN_TAG_RE.search(child.path.read_text(encoding="utf-8")))
            except OSError:
                child_has_lean = False
            if child_lean.exists() or child_has_lean:
                deps.add(project_rel_path(child_lean).as_posix())
    if notes_by_rel and note.book_role == "included":
        cover = book_cover_for_note(note, notes_by_rel)
        if cover:
            deps.add(project_rel_path(cover.path).as_posix())
            for rel_path in cover.book_included_paths:
                child = notes_by_rel.get(rel_path)
                if child:
                    deps.add(project_rel_path(child.path).as_posix())
    deps.update(str(path) for path in note_kind_asset_paths(note))
    return deps


def executable_from_path(value: str) -> str | None:
    value = value.strip()
    if not value:
        return None
    if os.sep in value:
        return value if Path(value).exists() else None
    return shutil.which(value)


def node_executable() -> str:
    for value in (
        os.environ.get("AARONNOTE_NODE", ""),
        os.environ.get("NODE_BINARY", ""),
        "node",
        "/opt/homebrew/bin/node",
        "/usr/local/bin/node",
        str(Path.home() / ".nix-profile" / "bin" / "node"),
        "/run/current-system/sw/bin/node",
    ):
        resolved = executable_from_path(value)
        if resolved:
            return resolved

    try:
        resolved = subprocess.check_output(
            ["/bin/zsh", "-lc", "command -v node"],
            text=True,
            stderr=subprocess.DEVNULL,
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        resolved = ""
    if resolved:
        return resolved
    raise RuntimeError("Aaronnote renderer failed: node executable not found")


def render_aaronnote_payload(payload: dict[str, object]) -> str:
    try:
        result = subprocess.run(
            [node_executable(), str(RUNTIME_ROOT / "scripts" / "render-html.mjs")],
            cwd=str(RUNTIME_ROOT),
            input=json.dumps(payload, ensure_ascii=False),
            text=True,
            check=True,
            capture_output=True,
        )
    except (OSError, subprocess.CalledProcessError) as err:
        stderr = err.stderr if isinstance(err, subprocess.CalledProcessError) else str(err)
        raise RuntimeError(f"Aaronnote renderer failed: {stderr}") from err
    try:
        return str(json.loads(result.stdout)["html"])
    except (json.JSONDecodeError, KeyError) as err:
        raise RuntimeError(f"Aaronnote renderer returned invalid JSON: {result.stdout[:500]}") from err


def render_aaronnote_payloads(payloads: list[dict[str, object]]) -> list[str]:
    if not payloads:
        return []
    try:
        result = subprocess.run(
            [node_executable(), str(RUNTIME_ROOT / "scripts" / "render-html.mjs")],
            cwd=str(RUNTIME_ROOT),
            input=json.dumps({"batch": payloads}, ensure_ascii=False),
            text=True,
            check=True,
            capture_output=True,
        )
    except (OSError, subprocess.CalledProcessError) as err:
        stderr = err.stderr if isinstance(err, subprocess.CalledProcessError) else str(err)
        raise RuntimeError(f"Aaronnote renderer failed: {stderr}") from err
    try:
        html = json.loads(result.stdout)["html"]
    except (json.JSONDecodeError, KeyError) as err:
        raise RuntimeError(f"Aaronnote renderer returned invalid JSON: {result.stdout[:500]}") from err
    if not isinstance(html, list) or len(html) != len(payloads):
        raise RuntimeError(f"Aaronnote renderer returned {len(html) if isinstance(html, list) else 'invalid'} batch items for {len(payloads)} inputs")
    return [str(item) for item in html]


def render_aaronnote_markdown(text: str) -> str:
    return render_aaronnote_payload({"markdown": text})


def normalize_lean_tag(value: object) -> str:
    tag = re.sub(r"[^A-Za-z0-9_.:-]+", "-", str(value or "").strip().strip("[]"))
    return tag.strip("-")[:80]


def lean_mirror_path(note_path: Path) -> Path:
    rel = project_rel_path(note_path)
    if rel.parts and rel.parts[0] == "roam":
        rel = Path(*rel.parts[1:])
    if rel.suffix.lower() in {".md", ".markdown"}:
        rel = rel.with_suffix(".lean")
    else:
        rel = Path(f"{rel.as_posix()}.lean")
    return ROAM_ROOT / ".lean" / rel


def scan_lean_regions(text: str) -> dict[str, str]:
    matches = list(LEAN_REGION_MARKER_RE.finditer(text))
    regions: dict[str, str] = {}
    for index, match in enumerate(matches):
        tag = normalize_lean_tag(match.group(1))
        if not tag:
            continue
        body_from = match.end()
        if body_from < len(text) and text[body_from] == "\n":
            body_from += 1
        body_to = matches[index + 1].start() if index + 1 < len(matches) else len(text)
        regions[tag] = text[body_from:body_to].rstrip("\n")
    return regions


def lean_regions_for_note(note: Note, markdown_text: str) -> dict[str, str]:
    tags = [normalize_lean_tag(match.group(1)) for match in MARKDOWN_LEAN_TAG_RE.finditer(markdown_text)]
    tags = [tag for tag in tags if tag]
    if not tags:
        return {}
    path = lean_mirror_path(note.path)
    try:
        regions = scan_lean_regions(path.read_text(encoding="utf-8"))
    except OSError:
        return {}
    wanted = set(tags)
    return {tag: body for tag, body in regions.items() if tag in wanted}


def note_has_h1(markdown_text: str) -> bool:
    return bool(re.search(r"(?m)^\s{0,3}#\s+\S", strip_meta_block(markdown_text)))


def expanded_book_markdown(note: Note, notes_by_rel: dict[str, Note], stack: list[str] | None = None) -> str:
    stack = stack or []
    text = note.path.read_text(encoding="utf-8")
    if not note.book_role and not note.book_include_refs:
        return text
    if note.rel_path in stack:
        return f"\n\n> Book include cycle: {' -> '.join([*stack, note.rel_path])}\n\n"

    def replace_include(match: re.Match[str]) -> str:
        raw_ref = match.group(1).strip()
        child_path = resolve_include_path(note, raw_ref)
        if not child_path:
            return f"\n\n> Missing include: {raw_ref}\n\n"
        try:
            child_rel = project_rel_path(child_path).as_posix()
        except ValueError:
            return f"\n\n> Missing include: {raw_ref}\n\n"
        child = notes_by_rel.get(child_rel)
        if not child:
            return f"\n\n> Missing include: {raw_ref}\n\n"
        child_text = expanded_book_markdown(child, notes_by_rel, [*stack, note.rel_path])
        child_body = strip_meta_block(child_text)
        if not note_has_h1(child_text) and child.title:
            child_body = f"# {child.title}\n\n{child_body}"
        return f"\n\n{child_body.rstrip()}\n\n"

    return INCLUDE_RE.sub(replace_include, text)


def html_escape(value: object) -> str:
    return (
        str(value or "")
        .replace("&", "&amp;")
        .replace("<", "&lt;")
        .replace(">", "&gt;")
        .replace('"', "&quot;")
    )


def add_book_toc_after_meta(markdown_text: str, note: Note, notes_by_rel: dict[str, Note] | None = None) -> str:
    if note.book_role != "cover" or not note.book_toc:
        return markdown_text
    items = "\n".join(
        f'<li data-level="{int(item.get("level") or 1)}"><a href="{html_escape(book_toc_item_href(note, item))}">{html_escape(item.get("text"))}</a></li>'
        for item in note.book_toc
        if int(item.get("level") or 1) <= 3
    )
    if not items:
        return markdown_text
    toc = "\n".join([
        "#+begin html",
        '<nav class="aaronnote-book-cover-toc" aria-label="Book contents">',
        "<strong>Book contents</strong>",
        f"<ol>{items}</ol>",
        "</nav>",
        "#+end html",
        "",
    ])
    match = ORG_META_RE.match(markdown_text)
    if match:
        return f"{markdown_text[:match.end()].rstrip()}\n\n{toc}{markdown_text[match.end():].lstrip()}"
    return f"{toc}{markdown_text}"


def book_include_card_html(note: Note, raw_ref: str, notes_by_rel: dict[str, Note]) -> str:
    child_path = resolve_include_path(note, raw_ref)
    child: Note | None = None
    if child_path:
        try:
            child = notes_by_rel.get(project_rel_path(child_path).as_posix())
        except ValueError:
            child = None
    if not child:
        return "\n".join([
            "#+begin html",
            '<div class="aaronnote-book-include-card is-missing">',
            '<span class="aaronnote-book-include-badge">Include</span>',
            f"<strong>Missing include</strong>",
            f"<small>{html_escape(raw_ref)}</small>",
            "</div>",
            "#+end html",
        ])
    href = relative_site_href(note_output_link(note), note_output_link(child))
    return "\n".join([
        "#+begin html",
        f'<a class="aaronnote-book-include-card" href="{html_escape(href)}">',
        '<span class="aaronnote-book-include-badge">Include</span>',
        f"<strong>{html_escape(child.public_title)}</strong>",
        f"<small>{html_escape(child.rel_path)}</small>",
        "</a>",
        "#+end html",
    ])


def render_book_include_cards(markdown_text: str, note: Note, notes_by_rel: dict[str, Note]) -> str:
    if not note.book_include_refs:
        return markdown_text

    def replace_include(match: re.Match[str]) -> str:
        raw_ref = match.group(1).strip()
        return f"\n\n{book_include_card_html(note, raw_ref, notes_by_rel)}\n\n"

    return INCLUDE_RE.sub(replace_include, markdown_text)


def lean_regions_for_book(note: Note, markdown_text: str, notes_by_rel: dict[str, Note] | None = None) -> dict[str, str]:
    regions = lean_regions_for_note(note, markdown_text)
    if not notes_by_rel or note.book_role != "cover":
        return regions
    for rel_path in note.book_included_paths:
        child = notes_by_rel.get(rel_path)
        if not child:
            continue
        try:
            child_text = child.path.read_text(encoding="utf-8")
        except OSError:
            continue
        for tag, body in lean_regions_for_note(child, child_text).items():
            regions.setdefault(tag, body)
    return regions


def site_root_for(note_link: str) -> str:
    depth = len(Path(note_link).parent.parts)
    return "../" * depth or "./"


def pdf_export_p() -> bool:
    return os.environ.get("AARONNOTE_EXPORT_FORMAT") == "pdf"


def note_output_link(note: Note) -> str:
    if pdf_export_p():
        return Path(note.rel_path).with_suffix(".html").as_posix()
    return note.link


def note_link_for_rel_path(rel_path: str) -> str:
    return Path(rel_path).with_suffix(".html").as_posix()


def relative_site_href(from_link: str, to_link: str) -> str:
    from_dir = posixpath.dirname(from_link) or "."
    return posixpath.relpath(to_link, from_dir)


def book_cover_for_note(note: Note, notes_by_rel: dict[str, Note] | None = None) -> Note | None:
    if note.book_role == "cover":
        return note
    if not notes_by_rel or note.book_role != "included" or not note.book_cover_id:
        return None
    for candidate in notes_by_rel.values():
        if candidate.id == note.book_cover_id:
            return candidate
    return None


def book_toc_item_href(from_note: Note, item: dict[str, object]) -> str:
    slug = str(item.get("slug") or "").strip()
    target_path = str(item.get("path") or from_note.rel_path).strip() or from_note.rel_path
    hash_part = f"#{slug}" if slug else ""
    if target_path == from_note.rel_path:
        return hash_part or "#"
    return f"{relative_site_href(note_output_link(from_note), note_link_for_rel_path(target_path))}{hash_part}"


def published_book_payload(note: Note, notes_by_rel: dict[str, Note] | None = None) -> dict[str, object] | None:
    cover = book_cover_for_note(note, notes_by_rel)
    if not cover or not cover.book_toc:
        return None
    toc = []
    for item in cover.book_toc:
        next_item = dict(item)
        next_item["href"] = book_toc_item_href(note, item)
        toc.append(next_item)
    return {
        "id": cover.public_id,
        "title": cover.public_title,
        "role": note.book_role,
        "coverPath": cover.rel_path,
        "currentPath": note.rel_path,
        "coverHref": relative_site_href(note_output_link(note), note_output_link(cover)),
        "toc": toc,
    }


def note_render_payload(
    note: Note,
    markdown_text: str,
    *,
    include_private_content: bool = False,
    lean_regions: dict[str, str] | None = None,
    notes_by_rel: dict[str, Note] | None = None,
) -> dict[str, object]:
    root = site_root_for(note_output_link(note))
    kind = active_note_kind(note)
    export_format = "pdf" if pdf_export_p() else "html"
    title = note.title if pdf_export_p() else note.public_title
    return {
        "mode": "published-note",
        "markdown": markdown_text,
        "note": {
            "title": title,
            "group": note.group_label,
            "date": note.date,
            "root": root,
            "kind": kind or DEFAULT_NOTE_KIND,
            "format": export_format,
            "noteThemeVersion": NOTE_THEME_VERSION,
            "kindAssetsHtml": note_kind_assets_html(note, root),
            "private": note.private,
            "includePrivateContent": include_private_content,
            "leanRegions": lean_regions or {},
            "book": published_book_payload(note, notes_by_rel),
        },
    }


def note_page_html(
    note: Note,
    markdown_text: str,
    *,
    include_private_content: bool = False,
    lean_regions: dict[str, str] | None = None,
    notes_by_rel: dict[str, Note] | None = None,
) -> str:
    rendered = render_aaronnote_payload(note_render_payload(
        note,
        markdown_text,
        include_private_content=include_private_content,
        lean_regions=lean_regions,
        notes_by_rel=notes_by_rel,
    ))
    return HTML_MD_LINK_RE.sub(r'href="\1.html\2"', rendered)


def prepare_note_render(
    note: Note,
    *,
    output_root: Path = PUBLIC,
    include_private_content: bool = False,
    force: bool = False,
    notes_by_rel: dict[str, Note] | None = None,
) -> PendingNoteRender | None:
    output_file = output_root / note_output_link(note)
    deps_file = deps_file_for(output_file, output_root)
    if not force and not include_private_content and output_is_current(output_file, deps_file):
        return None
    output_file.parent.mkdir(parents=True, exist_ok=True)
    deps_file.parent.mkdir(parents=True, exist_ok=True)
    markdown_text = note.path.read_text(encoding="utf-8")
    if note.book_role == "cover":
        markdown_text = add_book_toc_after_meta(markdown_text, note, notes_by_rel)
    if notes_by_rel:
        markdown_text = render_book_include_cards(markdown_text, note, notes_by_rel)
    if not include_private_content:
        markdown_text = sanitize_published_metadata_tags(markdown_text)
    lean_regions = lean_regions_for_book(note, markdown_text, notes_by_rel)
    return PendingNoteRender(
        note=note,
        output_file=output_file,
        deps_file=deps_file,
        payload=note_render_payload(
            note,
            markdown_text,
            include_private_content=include_private_content,
            lean_regions=lean_regions,
            notes_by_rel=notes_by_rel,
        ),
    )


def write_rendered_note_html(render: PendingNoteRender, html: str, notes_by_rel: dict[str, Note] | None = None) -> None:
    render.output_file.write_text(HTML_MD_LINK_RE.sub(r'href="\1.html\2"', html), encoding="utf-8")
    render.deps_file.write_text(
        json.dumps({"inputs": sorted(deps_for_note(render.note, notes_by_rel))}, ensure_ascii=False, indent=2) + "\n",
        encoding="utf-8",
    )


def render_note_html(
    note: Note,
    *,
    output_root: Path = PUBLIC,
    include_private_content: bool = False,
    force: bool = False,
    notes_by_rel: dict[str, Note] | None = None,
) -> str:
    pending = prepare_note_render(
        note,
        output_root=output_root,
        include_private_content=include_private_content,
        force=force,
        notes_by_rel=notes_by_rel,
    )
    if pending is None:
        return "skipped"
    write_rendered_note_html(pending, render_aaronnote_payload(pending.payload), notes_by_rel)
    return "rendered"


def public_ref_keys(refs: list[str], public_ids: dict[str, str]) -> list[str]:
    return [public_ids.get(ref, ref) for ref in refs]


def note_json(note: Note, public_ids: dict[str, str]) -> dict[str, object]:
    private_summary = "This note has been sealed by the administrator."
    return {
        "key": note.public_id,
        "id": note.public_id,
        "title": note.public_title,
        "link": note.link,
        "path": note.public_path,
        "date": note.date,
        "summary": private_summary if note.private else note.summary,
        "searchText": private_summary if note.private else note.search_text,
        "groupKey": note.group_key,
        "groupLabel": note.group_label,
        "section": note.section,
        "hidden": note.private,
        "private": note.private,
        "tags": filter_sensitive_tags(note.tags),
        "aliases": [] if note.private else note.aliases,
        "refs": public_ref_keys(note.refs, public_ids),
        "backlinks": public_ref_keys(note.backlinks, public_ids),
        "bookRole": note.book_role,
        "bookCoverId": note.book_cover_id,
        "bookCoverPath": note.book_cover_path,
        "bookIncludedPaths": note.book_included_paths,
        "bookToc": note.book_toc,
        "bookDomTargets": note.book_dom_targets,
    }


def write_data(notes: list[Note]) -> None:
    js_dir = PUBLIC / "js"
    js_dir.mkdir(parents=True, exist_ok=True)
    public_note_items = [note for note in notes if note.book_role != "included"]
    tags = sorted({tag for note in public_note_items if not note.private for tag in filter_sensitive_tags(note.tags)})
    public_ids = {note.id: note.public_id for note in notes}
    books = [
        {
            "id": note.public_id,
            "title": note.public_title,
            "link": note.link,
            "path": note.public_path,
            "date": note.date,
            "summary": note.summary,
            "tags": filter_sensitive_tags(note.tags),
            "tocCount": len(note.book_toc),
            "includedCount": len(note.book_included_paths),
            "toc": note.book_toc,
        }
        for note in public_note_items
        if note.book_role == "cover" and not note.private
    ]
    data = {
        "meta": {
            "generatedAt": subprocess.check_output(["date", "+%Y-%m-%d %H:%M:%S %z"], text=True).strip(),
            "noteCount": len(public_note_items),
            "tagCount": len(tags),
            "bookCount": len(books),
        },
        "notes": [note_json(note, public_ids) for note in public_note_items],
        "books": books,
    }
    (js_dir / "data.js").write_text(f"const SITE_DATA = {json.dumps(data, ensure_ascii=False, separators=(',', ':'))};\n", encoding="utf-8")


def _copy_into_public(source: Path, target: Path) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    if target.exists() and not target.is_symlink():
        try:
            source_stat = source.stat()
            target_stat = target.stat()
            if (
                source_stat.st_size == target_stat.st_size
                and source_stat.st_mtime_ns == target_stat.st_mtime_ns
            ):
                return
        except OSError:
            pass
    if target.is_symlink() or target.exists():
        target.unlink()
    shutil.copy2(source, target)


def copy_published_assets(output_root: Path) -> None:
    for src_path, dst_rel in (
        (RUNTIME_ROOT / "aaronnote" / "style.css", Path("Aaronnote/aaronnote/style.css")),
        (RUNTIME_ROOT / "aaronnote" / "published-toc.js", Path("Aaronnote/aaronnote/published-toc.js")),
        (RUNTIME_ROOT / "aaronnote" / "published-local-graph.js", Path("Aaronnote/aaronnote/published-local-graph.js")),
        (RUNTIME_ROOT / "src" / "styles" / "theme-aaronnote.css", Path("Aaronnote/src/styles/theme-aaronnote.css")),
        (RUNTIME_ROOT / "src" / "styles" / "widgets.css", Path("Aaronnote/src/styles/widgets.css")),
        (RUNTIME_ROOT / "src" / "styles" / "theme-typora.css", Path("Aaronnote/src/styles/theme-typora.css")),
        (ASSETS_DIR / "css" / "aaronnote-published.css", Path("css/aaronnote-published.css")),
    ):
        if src_path.exists():
            _copy_into_public(src_path, output_root / dst_rel)


def markdown_asset_target(note: Note, raw_path: str) -> Path | None:
    path_text = unquote(raw_path.split("#", 1)[0].split("?", 1)[0]).strip()
    if not path_text or re.match(r"^[a-z][a-z0-9+.-]*:", path_text, flags=re.I):
        return None
    asset_path = Path(path_text)
    return asset_path if asset_path.is_absolute() else note.path.parent / asset_path


def note_static_asset_paths(note: Note) -> set[Path]:
    try:
        text = note.path.read_text(encoding="utf-8")
    except OSError:
        return set()

    paths: set[Path] = set()
    for raw_path in [*MD_IMAGE_RE.findall(text), *MD_LINK_RE.findall(text)]:
        asset_path = markdown_asset_target(note, raw_path)
        if not asset_path:
            continue
        if asset_path.exists() and asset_path.is_file() and asset_path.suffix.lower() in NOTE_STATIC_EXTENSIONS:
            paths.add(asset_path.resolve())

    for rel_dir in (
        Path("img") / note.path.stem,
        Path("images") / note.path.stem,
        Path("assets") / "img" / note.path.stem,
    ):
        directory = note.path.parent / rel_dir
        if directory.exists():
            paths.update(
                path.resolve()
                for path in directory.rglob("*")
                if path.is_file() and path.suffix.lower() in NOTE_STATIC_EXTENSIONS
            )
    return paths


def copy_note_static_assets(note: Note, output_root: Path, notes_by_rel: dict[str, Note] | None = None) -> None:
    sources = set(note_static_asset_paths(note))
    if notes_by_rel and note.book_role == "cover":
        for rel_path in note.book_included_paths:
            child = notes_by_rel.get(rel_path)
            if child:
                sources.update(note_static_asset_paths(child))
    for source in sources:
        try:
            rel = project_rel_path(source)
        except ValueError:
            continue
        _copy_into_public(source, output_root / rel)


def note_kind_asset_paths(note: Note) -> set[Path]:
    kind = active_note_kind(note)
    if not kind:
        return set()
    root = ASSETS_DIR / "kinds" / kind
    return {
        path
        for path in (root / "index.css", root / "index.js")
        if path.exists() and path.is_file()
    }


def copy_note_kind_assets(note: Note, output_root: Path) -> None:
    for source in note_kind_asset_paths(note):
        _copy_into_public(source, output_root / "kinds" / source.relative_to(ASSETS_DIR / "kinds"))


def note_kind_assets_html(note: Note, root: str) -> str:
    kind = active_note_kind(note)
    if not kind:
        return ""
    asset_root = ASSETS_DIR / "kinds" / kind
    css = asset_root / "index.css"
    js = asset_root / "index.js"
    lines: list[str] = []
    if css.exists():
        lines.append(f'  <link rel="stylesheet" href="{root}kinds/{kind}/index.css?v={NOTE_THEME_VERSION}" />')
    if js.exists():
        context = {
            "kind": kind,
            "title": note.public_title,
            "path": note.public_path,
            "articleId": "content",
        }
        lines.append(
            "  <script type=\"module\">\n"
            f"    const context = {{ ...{script_json(context)}, article: document.getElementById('content') }};\n"
            f"    const mod = await import('{root}kinds/{kind}/index.js?v={NOTE_THEME_VERSION}');\n"
            "    const setup = typeof mod.default === 'function' ? mod.default : typeof mod.setup === 'function' ? mod.setup : null;\n"
            "    const cleanup = setup ? setup(context) : null;\n"
            "    window.addEventListener('pagehide', () => {\n"
            "      if (typeof cleanup === 'function') cleanup();\n"
            "      else if (typeof mod.teardown === 'function') mod.teardown(context);\n"
            "    }, { once: true });\n"
            "    window.dispatchEvent(new CustomEvent('aaronnote:kind-ready', { detail: context }));\n"
            "  </script>"
        )
    return "\n".join(lines)


def copy_static(notes: list[Note]) -> None:
    private_assets = private_static_asset_paths(notes)

    # Copy roam static assets (images, visual attachments) from project files walk.
    for path in iter_project_files():
        if not path.is_file() or path.resolve() in private_assets:
            continue
        try:
            rel = project_rel_path(path)
        except ValueError:
            continue
        if should_skip(rel) or path.name.startswith(".") or path.name.endswith("~"):
            continue
        suffix = path.suffix.lower()
        # Only copy roam files (images + visual attachments).
        if not (rel.parts and rel.parts[0] == "roam"):
            continue
        if suffix not in (IMAGE_EXTENSIONS | VISUAL_ATTACHMENT_EXTENSIONS):
            continue
        _copy_into_public(path, PUBLIC / rel)

    # Copy site static assets (css/, js/, kinds/, etc.) from ASSETS_DIR.
    for path in ASSETS_DIR.rglob("*"):
        if not path.is_file():
            continue
        rel = path.relative_to(ASSETS_DIR)
        if path.name.startswith(".") or path.name.endswith("~") or should_skip(rel):
            continue
        if path.suffix.lower() not in STATIC_EXTENSIONS:
            continue
        _copy_into_public(path, PUBLIC / rel)

    for template, output in (("homepage.html", "index.html"), ("notes.html", "notes.html")):
        source = ASSETS_DIR / template
        if source.exists():
            _copy_into_public(source, PUBLIC / output)


def clean_stale_outputs(notes: list[Note]) -> None:
    expected_html = {note.link for note in notes}
    private_assets = private_static_asset_paths(notes)
    roam_public = PUBLIC / "roam"
    if roam_public.exists():
        for prefix in PRIVATE_PATH_PREFIXES:
            public_prefix = PUBLIC / prefix
            if public_prefix.exists():
                for public_file in public_prefix.rglob("*"):
                    if public_file.is_file() or public_file.is_symlink():
                        public_file.unlink()
        for source_asset in private_assets:
            try:
                rel = source_asset.relative_to(ROOT)
            except ValueError:
                continue
            public_asset = PUBLIC / rel
            if public_asset.exists() or public_asset.is_symlink():
                public_asset.unlink()
        for html_file in roam_public.glob("**/*.html"):
            rel = html_file.relative_to(PUBLIC).as_posix()
            if rel not in expected_html:
                html_file.unlink()
                deps_file_for(html_file).unlink(missing_ok=True)
        for pdf_file in roam_public.glob("**/*.pdf"):
            pdf_file.unlink()
            deps_file_for(pdf_file).unlink(missing_ok=True)
    for rel in ("diary.html", "sitemap-log.html", "CV/main.pdf"):
        (PUBLIC / rel).unlink(missing_ok=True)


def collect_notes() -> tuple[list[Note], dict[str, Note]]:
    PUBLIC.mkdir(exist_ok=True)
    notes = find_notes()
    apply_book_metadata(notes)
    notes_by_id = {note.id: note for note in notes}
    notes_by_rel = {note.rel_path: note for note in notes}
    backlinks: dict[str, list[str]] = {note.id: [] for note in notes}

    for note in notes:
        resolved_refs: set[str] = set()
        for ref in note.refs:
            if re.match(r"^[a-z][a-z0-9+.-]*:", ref, flags=re.I):
                continue
            ref_path = (note.path.parent / ref.split("#", 1)[0]).resolve()
            try:
                rel = ref_path.relative_to(ROOT).as_posix()
            except ValueError:
                continue
            target = notes_by_rel.get(rel)
            if target and target.id != note.id:
                if target.book_role == "included" and target.book_cover_id:
                    resolved_refs.add(target.book_cover_id)
                else:
                    resolved_refs.add(target.id)
        note.refs = sorted(resolved_refs)
        for ref in note.refs:
            backlinks.setdefault(ref, []).append(note.id)

    for note in notes:
        note.backlinks = sorted(set(backlinks.get(note.id, [])))
    return notes, notes_by_id


def publish_mask_stats(notes: list[Note]) -> tuple[int, int]:
    masks: list[str] = []
    for note in notes:
        for tag in note.tags:
            normalized = tag.strip().lower()
            if normalized in SENSITIVE_TAGS:
                masks.append(sealed_tag_mask(normalized))
    return len(masks), len(set(masks))


def publish_summary(
    notes: list[Note],
    *,
    rendered: int,
    skipped: int,
    head: str | None,
    roam_head: str | None,
    unchanged: bool = False,
) -> None:
    public_count = sum(not note.private for note in notes)
    sealed_count = len(notes) - public_count
    reference_edges = sum(len(note.refs) for note in notes)
    connected_notes = sum(1 for note in notes if note.refs or note.backlinks)
    masked_tags, distinct_masked_tags = publish_mask_stats(notes)
    sealed_groups = len({note.group_key for note in notes if note.private})
    private_assets = len(private_static_asset_paths(notes))
    public_tags = {
        tag
        for note in notes
        if not note.private
        for tag in filter_sensitive_tags(note.tags)
    }
    state = "unchanged" if unchanged else "updated"

    print(f"Publish summary: {state}")
    print(f"  Output: {PUBLIC}")
    print(f"  Notes: {len(notes)} total, {public_count} public, {sealed_count} sealed")
    print(f"  Pages: {rendered} rendered, {skipped} skipped")
    print(f"  Graph: {reference_edges} reference edges, {connected_notes} connected notes")
    print(f"  Tags: {len(public_tags)} public tags, {masked_tags} masked occurrences, {distinct_masked_tags} masked tags")
    print(f"  Privacy: {sealed_groups} sealed groups, {private_assets} private static assets excluded")
    print(f"  Git: org {head[:12] if head else 'unknown'}, roam {roam_head[:12] if roam_head else 'unknown'}")


def arg_value(args: list[str], name: str) -> str | None:
    if name not in args:
        return None
    index = args.index(name)
    if index + 1 >= len(args):
        raise SystemExit(f"{name} requires a value")
    return args[index + 1]


def resolve_root_path(raw_path: str) -> Path:
    path = Path(raw_path).expanduser()
    if not path.is_absolute():
        path = ROOT / path
    return path.resolve()


def publish_single_note(args: list[str]) -> bool:
    raw_note = arg_value(args, "--note")
    if not raw_note:
        return False

    note_path = resolve_root_path(raw_note)
    try:
        rel = project_rel_path(note_path)
    except ValueError as err:
        raise SystemExit(f"Note is outside publish root: {note_path}") from err
    if not note_path.exists() or note_path.suffix.lower() not in {".md", ".markdown"}:
        raise SystemExit(f"Not a Markdown note: {note_path}")
    if should_skip(rel):
        raise SystemExit(f"Skipped path cannot be published: {note_path}")

    output_root = PUBLIC
    raw_output_root = arg_value(args, "--output-root")
    if raw_output_root:
        output_root = resolve_root_path(raw_output_root)

    include_private = "--include-private" in args
    export_format = arg_value(args, "--format")
    previous_export_format = os.environ.get("AARONNOTE_EXPORT_FORMAT")
    if export_format:
        if export_format not in {"html", "pdf"}:
            raise SystemExit(f"Unsupported export format: {export_format}")
        os.environ["AARONNOTE_EXPORT_FORMAT"] = export_format
    note = parse_note_for_export(note_path)
    all_notes = find_notes()
    apply_book_metadata(all_notes)
    notes_by_rel = {item.rel_path: item for item in all_notes}
    note = notes_by_rel.get(note.rel_path, note)
    output_root.mkdir(parents=True, exist_ok=True)
    copy_published_assets(output_root)
    copy_note_static_assets(note, output_root, notes_by_rel)
    copy_note_kind_assets(note, output_root)
    output_file = output_root / note_output_link(note)
    try:
        status = render_note_html(
            note,
            output_root=output_root,
            include_private_content=include_private,
            force=True,
            notes_by_rel=notes_by_rel,
        )
    finally:
        if export_format:
            if previous_export_format is None:
                os.environ.pop("AARONNOTE_EXPORT_FORMAT", None)
            else:
                os.environ["AARONNOTE_EXPORT_FORMAT"] = previous_export_format
    print(f"Published {note.rel_path} to {output_file} ({status})")
    return True


def _migrate_roam_symlink() -> None:
    """Remove ROOT/roam symlink if it points to ROAM_ROOT.
    The engine writes generated HTML to ROOT/roam/ (a real output dir).
    Source notes are discovered via ROAM_ROOT directly.
    Also cleans up any HTML files accidentally written to ROAM_ROOT in a prior run.
    """
    roam_link = ROOT / "roam"
    if roam_link.is_symlink():
        try:
            if roam_link.resolve() == ROAM_ROOT.resolve():
                roam_link.unlink()
        except OSError:
            pass
    # Clean any .html files that leaked into the vault during a prior run.
    if ROAM_ROOT.exists():
        for html_file in ROAM_ROOT.rglob("*.html"):
            try:
                html_file.unlink()
            except OSError:
                pass


def main() -> None:
    args = sys.argv[1:]
    _migrate_roam_symlink()
    if publish_single_note(args):
        return

    notes, _notes_by_id = collect_notes()
    notes_by_rel = {note.rel_path: note for note in notes}

    head = git_head()
    roam_head = roam_git_head()

    if "--record-state" in args:
        write_publish_state(notes, 0, len(notes), head, roam_head)
        print(f"Recorded publish state for git {head[:12] if head else 'unknown'} / roam {roam_head[:12] if roam_head else 'unknown'}")
        return

    if publish_state_current(notes, head, roam_head):
        print(f"Published {len(notes)} Markdown notes to {PUBLIC} (unchanged, skipped)")
        publish_summary(notes, rendered=0, skipped=len(notes), head=head, roam_head=roam_head, unchanged=True)
        return

    clean_stale_outputs(notes)
    copy_published_assets(PUBLIC)
    copy_static(notes)
    skipped = 0
    pending_renders: list[PendingNoteRender] = []
    for note in notes:
        copy_note_static_assets(note, PUBLIC, notes_by_rel)
        pending = prepare_note_render(note, notes_by_rel=notes_by_rel)
        if pending is None:
            skipped += 1
        else:
            pending_renders.append(pending)
    rendered_html = render_aaronnote_payloads([item.payload for item in pending_renders])
    for pending, html in zip(pending_renders, rendered_html, strict=True):
        write_rendered_note_html(pending, html, notes_by_rel)
    rendered = len(pending_renders)
    write_data(notes)
    write_publish_state(notes, rendered, skipped, head, roam_head)
    print(f"Published {len(notes)} Markdown notes to {PUBLIC} ({rendered} rendered, {skipped} skipped)")
    publish_summary(notes, rendered=rendered, skipped=skipped, head=head, roam_head=roam_head)


if __name__ == "__main__":
    main()
