FRONT_MATTER_RE = re.compile(r"\A---\s*\n(.*?)\n---\s*\n?", re.S)
ORG_META_RE = re.compile(r"\A[ \t]*#\+begin(?:_|\s+)meta\s*\n(.*?)^[ \t]*#\+end(?:_|\s+)meta\s*\n?", re.S | re.M)
ORG_ENV_RE = re.compile(r"(?ms)^#\+begin(?:_|\s+)([A-Za-z][\w-]*)(?:\s+([^\n]+?))?\s*\n(.*?)^\s*#\+end(?:_|\s+)\1\s*$")
MD_IMAGE_RE = re.compile(r"!\[[^\]]*\]\(([^)]+)\)")
MD_LINK_RE = re.compile(r"(?<!!)\[[^\]]+\]\(([^)]+)\)")
HTML_MD_LINK_RE = re.compile(r'href="([^"#?:]+)\.md((?:#[^"]*)?)"')
INCLUDE_RE = re.compile(r"(?im)^[ \t]*@@include[ \t]+\[([^\]\n]+)\][ \t]*$")
MARKDOWN_LEAN_TAG_RE = re.compile(r"(?m)^[ \t]*@@lean4[ \t]+\[([^\]\n]+)\]")
LEAN_REGION_MARKER_RE = re.compile(r"(?m)^--[ \t]*@aaronnote[ \t]+([A-Za-z0-9_.:-]+)[ \t]*$")
KIND_NAME_RE = re.compile(r"^[a-z0-9_-]+$")
DEFAULT_NOTE_KIND = "default"
DEFAULT_NOTE_KIND_ALIASES = {"", "default", "note"}


def sealed_mask(value: str) -> str:
    digest = hashlib.blake2s(value.encode("utf-8"), digest_size=6, person=b"sealed").hexdigest()
    return f"sealed-{digest}"


def sealed_tag_mask(value: str) -> str:
    digest = hashlib.blake2s(value.encode("utf-8"), digest_size=6, person=b"tagmask").hexdigest()
    return f"sealed-tag-{digest}"


def sealed_group_mask(value: str) -> str:
    digest = hashlib.blake2s(value.encode("utf-8"), digest_size=6, person=b"group").hexdigest()
    return f"sealed-group-{digest}"


@dataclass
class Note:
    path: Path
    rel_path: str
    id: str
    title: str
    date: str = "Undated"
    tags: list[str] = field(default_factory=list)
    aliases: list[str] = field(default_factory=list)
    kind: str = DEFAULT_NOTE_KIND
    summary: str = ""
    search_text: str = ""
    refs: list[str] = field(default_factory=list)
    backlinks: list[str] = field(default_factory=list)
    private: bool = False
    book_role: str = ""
    book_parent_ref: str = ""
    book_cover_id: str = ""
    book_cover_path: str = ""
    book_parent_path: str = ""
    book_include_refs: list[str] = field(default_factory=list)
    book_included_paths: list[str] = field(default_factory=list)
    book_toc: list[dict[str, object]] = field(default_factory=list)
    book_dom_targets: list[dict[str, object]] = field(default_factory=list)
    book_raw_refs: list[str] = field(default_factory=list)
    book_diagnostics: list[dict[str, object]] = field(default_factory=list)

    @property
    def link(self) -> str:
        if self.private:
            return (Path("roam") / "sealed" / f"{self.public_title}.html").as_posix()
        path = Path(self.rel_path).with_suffix(".html")
        return path.as_posix()

    @property
    def public_title(self) -> str:
        return sealed_mask(self.rel_path) if self.private else self.title

    @property
    def public_id(self) -> str:
        return self.public_title if self.private else self.id

    @property
    def public_path(self) -> str:
        if self.private:
            return Path(self.link).with_suffix(".md").as_posix()
        return self.rel_path

    @property
    def group_key(self) -> str:
        if self.private:
            parent = Path(self.rel_path).parent.as_posix()
            return (Path("roam") / "sealed" / sealed_group_mask(parent)).as_posix()
        parent = Path(self.rel_path).parent.as_posix()
        return "Root" if parent == "." else parent

    @property
    def group_label(self) -> str:
        if self.private:
            parent = Path(self.rel_path).parent.as_posix()
            return sealed_group_mask(parent)
        leaf = self.group_key.rsplit("/", 1)[-1]
        if leaf == "Root":
            return "Root"
        return leaf if leaf.isupper() else leaf.replace("-", " ").replace("_", " ").title()

    @property
    def section(self) -> str:
        return self.group_key.split("/", 1)[0]


@dataclass
class PendingNoteRender:
