{
  "version": 2,
  "settings": {
    "defaultPath": "/",
    "defaultAction": "open"
  },
  "targets": [],
  "imports": [
    {
      "id": "ssh-config",
      "type": "ssh-config",
      "files": [
        "~/.ssh/config",
        "~/.config/ssh/config"
      ],
      "include": [],
      "exclude": [],
      "pipelines": [
        {
          "id": "ssh",
          "backend": "tramp",
          "priority": 50,
          "config": {
            "method": "ssh"
          }
        },
        {
          "id": "ssh",
          "backend": "tramp-rpc",
          "priority": 50,
          "include": [
            "Aaron-*"
          ],
          "trusted": true
        }
      ]
    }
  ]
}
